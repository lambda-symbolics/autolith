(in-package #:autolith)

;;;; -- Portable Boundary Tests --

(-> portable-tests--failure (function t) (option autolith-error))
(defun portable-tests--failure (convert value)
  "Return the typed boundary failure from converting VALUE, or NIL."
  (handler-case (progn (funcall convert value) nil)
    (autolith-error (condition) condition)))

(-> portable-tests--nested (integer) t)
(defun portable-tests--nested (depth)
  "Build a tree whose deepest CAR child has DEPTH."
  (loop with value = "leaf"
        repeat depth do (setf value (list value))
        finally (return value)))

(-> test-portable-client-values () null)
(defun test-portable-client-values ()
  "Exercise event scalar, dotted-list, object-key and array representations."
  (let* ((text   (copy-seq "text"))
         (object (make-hash-table :test #'eq))
         (key    (list 'member)))
    (setf (gethash key object) (vector text nil (json-false)))
    (test-assert
     (equal (client-portable (list nil (json-false) :null t :keyword #\a 12 1/2 'name #P"file"))
            '(nil :false :null t :keyword #\a 12 1/2 "name" "file"))
     "client scalars retain their portable representations")
    (test-assert (equal '("head" . "tail") (client-portable (cons 'head 'tail)))
                 "client cons conversion retains dotted tails")
    (test-assert (equal '(:object ("member") (:array "text" nil :false))
                        (client-portable object))
                 "client object keys use the same conversion as members")
    (test-assert (equal '(:array) (client-portable #())) "empty arrays retain their tag")
    (test-assert (not (eq text (client-portable text))) "event strings are fresh")
    (test-assert (stringp (client-portable (make-condition 'simple-error :format-control "opaque")))
                 "opaque event values use printable text")
    (let ((keys (make-hash-table :test #'eq)))
      (setf (gethash 'name keys) 1 (gethash "name" keys) 2)
      (test-assert (= 5 (length (client-portable keys)))
                   "client keys are neither normalized nor collision-rejected")))
  nil)

(-> test-portable-operation-values () null)
(defun test-portable-operation-values ()
  "Exercise the local Lisp-to-JSON argument convention and fresh strings."
  (let* ((text   (copy-seq "text"))
         (input  (list t nil (json-false) :null text #P"file" #\a 12 1.5 :key 'name))
         (result (application-operation--json-value input)))
    (test-assert (vectorp result) "nonempty proper argument lists become arrays")
    (test-assert (eq t (aref result 0)) "true remains true")
    (dolist (index '(1 2))
      (test-assert (json-false-p (aref result index)) "NIL and false become JSON false"))
    (test-assert (null (aref result 3)) "explicit null becomes JSON null")
    (test-assert (and (equal text (aref result 4)) (not (eq text (aref result 4))))
                 "argument strings are copied")
    (test-assert (equalp #("file" "a" 12 1.5 "key" "name") (subseq result 5))
                 "paths, characters, numbers and symbols use the JSON convention")
    (test-assert (equalp #() (application-operation--json-value #()))
                 "empty vectors remain arrays")
    (let* ((object (make-hash-table :test #'equal))
           (copy   nil))
      (setf (gethash :FILE-PATH object) text
            (gethash :|filePath| object) ':null
            copy (application-operation--json-value object))
      (test-assert (equal text (gethash "file-path" copy)) "upcased member names normalize")
      (test-assert (and (nth-value 1 (gethash "filePath" copy))
                        (null (gethash "filePath" copy)))
                   "escaped member names retain case and null presence")))
  nil)

(-> test-portable-task-values () null)
(defun test-portable-task-values ()
  "Copy task cons/string trees while retaining opaque leaves and readable grammar."
  (let* ((text   (copy-seq "text"))
         (vector (vector text))
         (hash   (make-hash-table))
         (opaque (make-condition 'simple-error))
         (input  (list* text vector hash opaque))
         (copy   (task--character-strings input)))
    (setf (gethash 'self hash) hash)
    (test-assert (and (equal text (first copy)) (not (eq text (first copy)))
                      (eq 'character (array-element-type (first copy))))
                 "task string leaves are fresh character arrays")
    (test-assert (and (eq vector (second copy)) (eq hash (third copy))
                      (eq opaque (cdddr copy)))
                 "task vectors, hashes and opaque dotted tails are leaves")
    (let ((*read-eval* nil))
      (test-assert (equal '("text" . :tail)
                          (read-from-string (task--write-readable-sexp (cons text ':tail))))
                   "task output retains portable readable dotted grammar")))
  nil)

(-> test-portable-shared-subtrees () null)
(defun test-portable-shared-subtrees ()
  "Accept repeated completed subtrees without preserving output aliases."
  (dolist (convert (list #'client-portable #'application-operation--json-value #'task--character-strings))
    (let* ((shared (list (copy-seq "leaf")))
           (input  (list shared shared))
           (result (funcall convert input))
           (left   (elt result 0))
           (right  (elt result 1)))
      (test-assert (and (not (eq input result)) (not (eq shared left))
                        (not (eq left right)) (not (eq (elt left 0) (elt right 0))))
                   "each completed shared cons subtree and its strings are copied independently")))
  (dolist (convert (list #'client-portable #'application-operation--json-value))
    (dolist (shared (list (vector (copy-seq "leaf")) (json-object "member" "leaf")))
      (let ((result (funcall convert (vector shared shared))))
        (if (eq convert #'client-portable)
            (test-assert (not (eq (second result) (third result)))
                         "client shared containers are independent")
            (test-assert (not (eq (aref result 0) (aref result 1)))
                         "operation shared containers are independent")))))
  nil)

(-> test-portable-cycles () null)
(defun test-portable-cycles ()
  "Reject active cons, vector, object and mixed cycles at traversing boundaries."
  (let* ((car-cycle (list nil))
         (cdr-cycle (list nil))
         (vector    (vector nil))
         (hash      (make-hash-table :test #'equal))
         (self-hash (make-hash-table :test #'equal))
         (mixed     (list hash))
         (key-cycle (make-hash-table :test #'eq)))
    (setf (first car-cycle) car-cycle
          (rest cdr-cycle) cdr-cycle
          (aref vector 0) vector
          (gethash "mixed" hash) mixed
          (gethash "self" self-hash) self-hash
          (gethash key-cycle key-cycle) nil)
    (dolist (convert (list #'client-portable #'application-operation--json-value #'task--character-strings))
      (dolist (value (list car-cycle cdr-cycle))
        (test-assert (portable-tests--failure convert value) "cons CAR and CDR cycles are rejected")))
    (dolist (convert (list #'client-portable #'application-operation--json-value))
      (dolist (value (list vector hash self-hash mixed))
        (let ((failure (portable-tests--failure convert value)))
          (test-assert (and (typep failure 'portable-value-error)
                            (eq ':cycle (portable-value-error-reason failure)))
                       "traversed containers and mixed cycles signal typed cycle failures"))))
    (test-assert (eq ':cycle (portable-value-error-reason
                             (portable-tests--failure #'client-portable key-cycle)))
                 "client object keys participate in cycle checks")
    (test-assert (and (eq vector (task--character-strings vector))
                      (eq hash (task--character-strings hash)))
                 "task opaque containers are not traversed"))
  nil)

(-> test-portable-structural-bounds () null)
(defun test-portable-structural-bounds ()
  "Exercise exact depth and visit limits through every conversion boundary."
  (dolist (convert (list #'client-portable #'application-operation--json-value #'task--character-strings))
    (test-assert (funcall convert (portable-tests--nested 128)) "depth 128 is accepted")
    (let ((failure (portable-tests--failure convert (portable-tests--nested 129))))
      (test-assert (if (eq convert #'task--character-strings)
                       (typep failure 'task-error)
                       (and (typep failure 'portable-value-error)
                            (eq ':depth (portable-value-error-reason failure))))
                   "depth 129 has the boundary's typed failure"))
    ;; One root visit, two charges per cell, and one terminal NIL visit.
    (test-assert (funcall convert (make-list 131071)) "exactly 262144 visits are accepted")
    (let ((over (make-list 131070)))
      (setf (first over) (list nil))
      (test-assert (portable-tests--failure convert over)
                   "262145 visits exceed the budget by exactly one")))
  (dolist (convert (list #'client-portable #'application-operation--json-value))
    (test-assert (funcall convert (make-array 262143 :initial-element nil))
                 "a vector may use exactly the remaining visit budget")
    (let ((failure (portable-tests--failure convert (make-array 262144 :initial-element nil))))
      (test-assert (and (typep failure 'portable-value-error)
                        (eq ':nodes (portable-value-error-reason failure)))
                   "oversized vectors fail before mapping allocation")))
  nil)

(-> test-portable-operation-rejections () null)
(defun test-portable-operation-rejections ()
  "Reject malformed argument lists, unsupported values/keys and normalized duplicates."
  (dolist (value (list (cons 1 2) 1/2 #C(1 2) (make-condition 'simple-error)))
    (test-assert (typep (portable-tests--failure #'application-operation--json-value value)
                        'configuration-error)
                 "unsupported JSON argument values have configuration failures"))
  (dolist (key (list 12 #\a #P"file" (list 'key) ""))
    (let ((object (make-hash-table :test #'equal)))
      (setf (gethash key object) nil)
      (test-assert (typep (portable-tests--failure #'application-operation--json-value object)
                          'configuration-error)
                   "invalid object keys have configuration failures")))
  (let ((object (make-hash-table :test #'equal)))
    ;; Both members become NIL, regardless of hash iteration order.
    (setf (gethash :NAME object) ':null
          (gethash "name" object) ':null)
    (test-assert (eq ':duplicate-key
                     (portable-value-error-reason
                      (portable-tests--failure #'application-operation--json-value object)))
                 "normalization collisions reject a NIL-valued first member"))
  (dolist (arguments '((:name :null :name 2) (:name) (:name 1 . :tail)))
    (test-assert (typep (portable-tests--failure #'application-operation--tool-arguments arguments)
                        'configuration-error)
                 "top-level duplicate and malformed argument lists are rejected"))
  nil)
