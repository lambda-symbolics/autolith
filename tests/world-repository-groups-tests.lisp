(in-package #:autolith)

;;;; -- Local Repository Group Tests --

(-> world-repository-tests--git (pathname list) string)
(defun world-repository-tests--git (directory arguments)
  "Run a bounded Git fixture command in the disposable test root."
  (let ((result
          (run-sandboxed
           "git" (append '("--no-pager" "--no-optional-locks"
                           "-c" "core.hooksPath=" "-c" "core.fsmonitor=false"
                           "-c" "commit.gpgsign=false" "-c" "user.name=Fixture"
                           "-c" "user.email=fixture@example.invalid")
                         arguments)
           :policy (external-sandbox-policy) :working-directory directory
           :environment (world-repository--environment) :clear-environment-p t
           :timeout 10 :output-limit 65536 :error-output-limit 4096)))
    (test-assert (eql 0 (sandbox-result-exit-code result))
                 (format nil "Git fixture ~S: ~A" arguments (cl-exec-sandbox:sandbox-result-error-output result)))
    (sandbox-result-output result)))

(-> world-repository-tests--channel (string pathname &key (:parent (option string))) channel)
(defun world-repository-tests--channel (identifier directory &key parent)
  "Return a channel executing in DIRECTORY, optionally under PARENT."
  (make-instance 'channel :identifier identifier :owner "user"
                         :workspace (world-workspace-name directory)
                         :parent parent :created-at 1 :updated-at 1))

(-> world-repository-tests--initialize (pathname) pathname)
(defun world-repository-tests--initialize (directory)
  "Create one committed repository owned exclusively by the test fixture."
  (ensure-directories-exist directory)
  (world-repository-tests--git directory '("init" "-q"))
  (world-repository-tests--git directory '("commit" "--allow-empty" "-qm" "fixture"))
  directory)

(-> test-world-repository-groups () null)
(defun test-world-repository-groups ()
  "Exercise real local Git identities, origins, clone boundaries and gather batching."
  (with-test-configuration (configuration root)
    (declare (ignore configuration))
    (let* ((main            (world-repository-tests--initialize (merge-pathnames "main/" root)))
           (linked          (merge-pathnames "linked/" root))
           (nested          (merge-pathnames "src/deep/" main))
           (clone-a         (merge-pathnames "clone-a/" root))
           (clone-b         (merge-pathnames "clone-b/" root))
           (separate        (merge-pathnames "separate/" root))
           (admin           (merge-pathnames "arbitrary-admin/" root))
           (separate-linked (merge-pathnames "separate-linked/" root))
           (bare            (merge-pathnames "bare-origin/" root))
           (bare-linked     (merge-pathnames "bare-linked/" root)))
      (ensure-directories-exist nested)
      (world-repository-tests--git main (list "worktree" "add" "-qb" "linked" (namestring linked)))
      (dolist (clone (list clone-a clone-b))
        (world-repository-tests--git root (list "clone" "-q" (namestring main) (namestring clone))))
      (let* ((channels (list (world-repository-tests--channel "child" linked :parent "main")
                             (world-repository-tests--channel "main" main)
                             (world-repository-tests--channel "nested" nested)
                             (world-repository-tests--channel "clone-a" clone-a)
                             (world-repository-tests--channel "clone-b" clone-b)))
             (groups   (world-repository-groups channels "child")))
        (test-assert (= 3 (length groups)) "main, linked and nested folders form one local repository group")
        (test-assert (equal '("child" "main" "nested")
                            (mapcar #'channel-identifier (world-repository-group-channels (first groups))))
                     "grouping preserves supplied member order")
        (test-assert (string= (world-workspace-name main)
                              (world-repository-group-directory (first groups)))
                     "the originating main folder supplies the heading")
        (test-assert (not (string= (world-repository-group-key (second groups))
                                   (world-repository-group-key (third groups))))
                     "independent clones retain distinct local identities")
        (test-assert (string= (world-repository-tests--git clone-a '("remote" "get-url" "origin"))
                              (world-repository-tests--git clone-b '("remote" "get-url" "origin")))
                     "clone separation holds even with identical origin URLs"))
      (let ((describe-function   (symbol-function 'world-repository--describe))
            (main-entry-function (symbol-function 'world-repository--main-entry))
            (descriptions        (make-hash-table :test #'equal))
            (main-entries        0))
        (test-call-with-function-replacements
         (list (list 'world-repository--describe
                     (lambda (directory)
                       (incf (gethash directory descriptions 0))
                       (funcall describe-function directory)))
               (list 'world-repository--main-entry
                     (lambda (directory)
                       (incf main-entries)
                       (funcall main-entry-function directory))))
         (lambda ()
           (let ((groups (world-repository-groups
                          (loop for id in '("one" "two" "three")
                                collect (world-repository-tests--channel id linked)) "one")))
             (test-assert (= 1 (length groups)) "linked-only channels recover the main folder from Git")
             (test-assert (= 1 main-entries) "one common identity requires one worktree-list query")
             (test-assert (loop for count being the hash-values of descriptions always (= 1 count))
                          "each workspace, including the discovered origin, is resolved once per gather")))))
      (ensure-directories-exist admin)
      (world-repository-tests--git root (list "init" "-q" "--separate-git-dir"
                                              (namestring admin) (namestring separate)))
      (world-repository-tests--git separate '("commit" "--allow-empty" "-qm" "fixture"))
      (world-repository-tests--git separate (list "worktree" "add" "-qb" "separate-linked"
                                                  (namestring separate-linked)))
      (let* ((child      (world-repository-tests--channel "separate-child" separate-linked))
             (unresolved (first (world-repository-groups (list child) "separate-child")))
             (observed   (world-repository-groups
                          (list child (world-repository-tests--channel "separate-main" separate))
                          "separate-child")))
        (test-assert (string= (channel-workspace child) (world-repository-group-key unresolved))
                     "an admin-only main record is not mistaken for the originating checkout")
        (test-assert (and (= 1 (length observed))
                          (string= (world-workspace-name separate)
                                   (world-repository-group-directory (first observed))))
                     "an observed authoritative main checkout resolves separate-dir siblings"))
      (world-repository-tests--git root (list "clone" "-q" "--bare" (namestring main) (namestring bare)))
      (world-repository-tests--git bare (list "worktree" "add" "-qb" "bare-linked" (namestring bare-linked)))
      (let ((groups (world-repository-groups
                     (list (world-repository-tests--channel "bare-child" bare-linked)
                           (world-repository-tests--channel "bare" bare)) "bare-child")))
        (test-assert (and (= 1 (length groups))
                          (string= (world-workspace-name bare)
                                   (world-repository-group-directory (first groups))))
                     "a bare repository is its linked worktrees' originating local folder"))))
  nil)

(-> world-repository-tests--metadata (configuration string &key (:path pathname) (:source pathname)) pathname)
(defun world-repository-tests--metadata (configuration identifier &key path source)
  "Write exact historical task worktree evidence without creating the checkout."
  (let ((file (merge-pathnames (format nil "tasks/repository-fixture/~A/worktree.sexp" identifier)
                               (config :data-root configuration))))
    (ensure-directories-exist file)
    (snapshot-write file (list :version 1 :owner (format nil "repository-fixture/~A" identifier)
                               :path (world-workspace-name path) :source (world-workspace-name source)))
    file))

(-> test-world-repository-group-refresh () null)
(defun test-world-repository-group-refresh ()
  "Recheck missing, invalid and changed Git metadata without sticky discovery state."
  (with-test-configuration (configuration root)
    (declare (ignore configuration))
    (let* ((main    (merge-pathnames "main/" root))
           (nested  (merge-pathnames "nested/" main))
           (missing (merge-pathnames "missing/" root)))
      (ensure-directories-exist nested)
      (let ((channels (list (world-repository-tests--channel "main" main)
                            (world-repository-tests--channel "nested" nested))))
        (test-assert (= 2 (length (world-repository-groups channels "main")))
                     "non-repositories retain exact workspace groups")
        (world-repository-tests--initialize main)
        (test-assert (= 1 (length (world-repository-groups channels "main")))
                     "the next gather sees a repository created after a negative lookup")
        (with-test-environment (("GIT_DIR" (namestring missing))
                                ("GIT_WORK_TREE" (namestring missing)))
          (test-assert (= 1 (length (world-repository-groups channels "main")))
                       "process-local metadata queries ignore inherited Git selectors")
          (test-assert (string= (uiop:getenv "GIT_DIR") (namestring missing))
                       "discovery never changes the host process environment"))
        (platform-delete-directory-tree *platform* (merge-pathnames ".git/" main) :validate t)
        (test-assert (= 2 (length (world-repository-groups channels "main")))
                     "positive repository identity is rechecked after metadata disappears")
        (with-open-file (stream (merge-pathnames ".git" main) :direction ':output
                                :if-does-not-exist                       ':create)
          (write-line "gitdir: no-such-administration" stream))
        (test-assert (= 2 (length (world-repository-groups channels "main")))
                     "invalid pointers fall back independently for each exact workspace")
        (test-assert (equal (world-workspace-name missing)
                            (world-repository-group-key
                             (first (world-repository-groups
                                     (list (world-repository-tests--channel "missing" missing)) "missing"))))
                     "a channel whose directory disappeared retains its workspace group")
        (test-call-with-function-replacements
         (list (list 'world-repository--git-output
                     (lambda (directory arguments)
                       (declare (ignore directory arguments))
                       nil)))
         (lambda ()
           (test-assert (= 2 (length (world-repository-groups channels "main")))
                        "unavailable metadata does not prevent other groups from rendering"))))))
  (with-test-configuration (configuration root)
    (let* ((main   (world-repository-tests--initialize (merge-pathnames "durable-main/" root)))
           (linked (merge-pathnames "durable-worktree/workspace/" root))
           (other  (world-repository-tests--initialize (merge-pathnames "other-repository/" root))))
      (world-repository-tests--git main (list "worktree" "add" "-qb" "durable" (namestring linked)))
      (multiple-value-bind (human home)
          (world-participant-create configuration :kind ':human :name "repository-owner"
                                    :home (list :workspace (namestring main)))
        (let* ((child  (world-channel-create configuration :id "durable-child"
                                              :owner           (participant-identifier human)
                                              :parent          (channel-identifier home)
                                              :workspace       (namestring linked)))
               (key    (channel-repository-key child))
               (origin (channel-repository-directory child)))
          (test-assert (and key (equal origin (world-workspace-name main)))
                       "A channel captures the originating repository when created in a linked worktree.")
          (world-repository-tests--git main (list "worktree" "remove" "--force" (namestring linked)))
          (platform-delete-directory-tree *platform* main :validate t)
          (let* ((loaded (world-channel-find (world-load configuration) "durable-child"))
                 (group  (first (world-repository-groups (list loaded) nil))))
            (test-assert (and (equal key (world-repository-group-key group))
                              (equal origin (world-repository-group-directory group)))
                         "Reloaded attribution survives removal of both the child checkout and originating folder."))
          (let ((moved (world-channel-update configuration "durable-child" :workspace (namestring other))))
            (test-assert (and (channel-repository-key moved)
                              (not (equal key (channel-repository-key moved))))
                         "Explicit relocation replaces attribution with the new local repository."))
          (let ((moved (world-channel-update configuration "durable-child"
                                             :workspace (namestring (merge-pathnames "unresolved/" root)))))
            (test-assert (and (null (channel-repository-key moved))
                              (null (channel-repository-directory moved)))
                         "Explicit relocation to an unresolved workspace clears unrelated attribution."))))))
  (with-test-configuration (configuration root)
    (let* ((main    (world-repository-tests--initialize (merge-pathnames "observed-main/" root)))
           (missing (merge-pathnames "removed/workspace/" root)))
      (multiple-value-bind (human home)
          (world-participant-create configuration :kind ':human :name "repository-owner"
                                    :home (list :workspace (namestring main)))
        (declare (ignore home))
        (let ((legacy
                (test-call-with-function-replacements
                 (list (list 'world-repository-resolve-directory
                             (lambda (directory) (declare (ignore directory)) nil)))
                 (lambda ()
                   (world-channel-create configuration :id "first-observed"
                                         :owner (participant-identifier human) :workspace (namestring main))))))
          (let* ((channels   (list legacy))
                 (remembered (world-repository-remember configuration channels
                                                       (world-repository-groups channels nil)))
                 (bytes      (uiop:read-file-string (configuration-world-path configuration))))
            (test-assert (and (null (channel-repository-key legacy))
                              (channel-repository-key (first remembered)))
                         "First positive resolution persists a replacement without mutating the old channel.")
            (world-repository-remember configuration remembered (world-repository-groups remembered nil))
            (test-assert (equal bytes (uiop:read-file-string (configuration-world-path configuration)))
                         "Repeated positive resolution does not append duplicate facts.")))
        (let* ((legacy     (world-channel-create configuration :id "removed-legacy"
                                                 :owner (participant-identifier human) :workspace (namestring missing)))
               (metadata   (world-repository-tests--metadata configuration "removed" :path missing :source main))
               (channels   (list legacy))
               (remembered (world-repository-remember configuration channels
                                                     (world-repository-groups channels nil))))
          (test-assert (equal (world-workspace-name main)
                              (channel-repository-directory (first remembered)))
                       "Exact persisted task path/source evidence recovers an already removed legacy checkout.")
          (delete-file metadata)
          (let ((loaded (world-channel-find (world-load configuration) "removed-legacy")))
            (test-assert (equal (channel-repository-key (first remembered))
                                (world-repository-group-key (first (world-repository-groups (list loaded) nil))))
                         "Backfilled identity survives reload after its recovery artifact is gone.")))
        (dolist (action '(:relocate :delete))
          (let* ((identifier (format nil "stale-~A" action))
                 (legacy
                   (test-call-with-function-replacements
                    (list (list 'world-repository-resolve-directory
                                (lambda (directory) (declare (ignore directory)) nil)))
                    (lambda () (world-channel-create configuration :id identifier
                                                     :owner            (participant-identifier human)
                                                     :workspace        (namestring main)))))
                 (channels   (list legacy))
                 (groups     (world-repository-groups channels nil)))
            (ecase action
              (:relocate
               (world-channel-update configuration identifier :workspace (namestring missing)))
              (:delete
               (world-channel-delete configuration identifier)))
            (world-repository-remember configuration channels groups)
            (let ((current (world-channel-find (world-load configuration) identifier)))
              (test-assert (ecase action
                             (:relocate
                              (and current (equal (channel-workspace current) (world-workspace-name missing))
                                   (null (channel-repository-key current))))
                             (:delete
                              (null current)))
                           "An old positive catalogue cannot overwrite relocation or resurrect a deleted channel."))))
        (let* ((first  (merge-pathnames "cycle-one/" root))
               (second (merge-pathnames "cycle-two/" root))
               (other  (world-repository-tests--initialize (merge-pathnames "conflicting-main/" root))))
          (world-repository-tests--metadata configuration "cycle-one" :path first :source second)
          (world-repository-tests--metadata configuration "cycle-two" :path second :source first)
          (world-repository-tests--metadata configuration "conflict-one" :path missing :source main)
          (world-repository-tests--metadata configuration "conflict-two" :path missing :source other)
          (let ((sources (world-repository--task-sources configuration)))
            (test-assert (null (world-repository--recover (world-workspace-name first) sources nil))
                         "Historical source cycles cannot invent a repository.")
            (test-assert (null (world-repository--recover (world-workspace-name missing) sources nil))
                         "Conflicting exact source records leave attribution unknown."))
          (let ((*world-repository-artifact-limit* 1))
            (test-assert (zerop (hash-table-count (world-repository--task-sources configuration)))
                         "A saturated metadata inventory cannot claim uniqueness."))))))
  (dolist (reverse-p '(nil t))
    (with-test-configuration (configuration root)
      (let* ((main     (merge-pathnames "new-main/" root))
             (admin    (merge-pathnames "stable-admin/" root))
             (old-main (world-workspace-name (merge-pathnames "old-main/" root)))
             (removed  (merge-pathnames "removed-child/" root)))
        (ensure-directories-exist admin)
        (world-repository-tests--git root (list "init" "-q" "--separate-git-dir" (namestring admin)
                                               (namestring main)))
        (world-repository-tests--git main '("commit" "--allow-empty" "-qm" "fixture"))
        (let ((key (concatenate 'string "git:" (world-workspace-name admin))))
          (multiple-value-bind (human home)
              (world-participant-create configuration :kind ':human :name "origin-owner"
                                        :home (list :workspace (namestring main)))
            (declare (ignore home))
            (let* ((channels
                     (test-call-with-function-replacements
                      (list (list 'world-repository-resolve-directory
                                  (lambda (directory)
                                    (declare (ignore directory))
                                    (list :key key :directory old-main))))
                      (lambda ()
                        (list (world-channel-create configuration :id "removed-origin"
                                                    :owner            (participant-identifier human)
                                                    :workspace        (namestring removed))
                              (world-channel-create configuration :id "live-origin"
                                                    :owner            (participant-identifier human)
                                                    :workspace        (namestring main))))))
                   (channels (if reverse-p (reverse channels) channels))
                   (groups   (world-repository-groups channels nil)))
              (test-assert (and (= 1 (length groups))
                                (world-repository-group-origin-observed-p (first groups))
                                (equal (world-workspace-name main)
                                       (world-repository-group-directory (first groups))))
                           "A verified separate-admin origin wins over stale saved origins in either channel order.")
              (world-repository-remember configuration channels groups)
              (test-assert (every (lambda (channel)
                                    (and (equal old-main (channel-repository-directory channel))
                                         (equal (world-workspace-name main)
                                                (channel-repository-directory
                                                 (world-channel-find (world-load configuration)
                                                                     (channel-identifier channel))))))
                                  channels)
                           "Fresh group provenance updates both durable pairs without changing old observations.")
              (let* ((fallbacks
                       (test-call-with-function-replacements
                        (list (list 'world-repository-resolve-directory
                                    (lambda (directory) (list :key key :directory directory))))
                        (lambda ()
                          (loop for identifier in '("fallback-one" "fallback-two")
                                for name in '("missing-one/" "missing-two/")
                                collect (world-channel-create configuration :id identifier
                                                              :owner            (participant-identifier human)
                                                              :workspace        (namestring (merge-pathnames name root)))))))
                     (fallbacks (if reverse-p (reverse fallbacks) fallbacks))
                     (groups    (world-repository-groups fallbacks nil))
                     (bytes     (uiop:read-file-string (configuration-world-path configuration))))
                (test-assert (and (= 1 (length groups))
                                  (not (world-repository-group-origin-observed-p (first groups)))
                                  (eq fallbacks (world-repository-remember configuration fallbacks groups))
                                  (equal bytes (uiop:read-file-string (configuration-world-path configuration)))
                                  (every (lambda (channel)
                                           (equal (channel-repository-directory channel)
                                                  (channel-repository-directory
                                                   (world-channel-find (world-load configuration)
                                                                       (channel-identifier channel)))))
                                         fallbacks))
                             "Fallback-only grouping never reconciles discordant saved origins by presentation order."))))))))
  (with-test-configuration (configuration root)
    (let* ((main     (world-repository-tests--initialize (merge-pathnames "metadata-main/" root)))
           (clone-a  (merge-pathnames "metadata-clone-a/" root))
           (clone-b  (merge-pathnames "metadata-clone-b/" root))
           (missing  (merge-pathnames "metadata-removed/" root))
           (metadata (world-repository-tests--metadata configuration "schema" :path missing :source main)))
      (dolist (clone (list clone-a clone-b))
        (world-repository-tests--git root (list "clone" "-q" (namestring main) (namestring clone))))
      (let ((valid (list :version 1 :owner "repository-fixture/schema"
                         :path (world-workspace-name missing) :source (world-workspace-name clone-a))))
        (snapshot-write metadata (append valid (list :metadata-path (namestring metadata))))
        (test-assert (equal (world-workspace-name clone-a)
                            (gethash (world-workspace-name missing) (world-repository--task-sources configuration)))
                     "Unique keyword metadata allows legitimate additional task fields.")
        (dolist (malformed (list (append valid (list :source (world-workspace-name clone-b)))
                                 (append valid '("source" "non-keyword"))
                                 (list :version 1 :path (world-workspace-name missing)
                                       :source (world-workspace-name clone-a))))
          (snapshot-write metadata malformed)
          (test-assert (and (null (world-repository--read-metadata metadata))
                            (null (world-repository--recover
                                   (world-workspace-name missing) (world-repository--task-sources configuration) nil)))
                       "Duplicate source keys, malformed keys and missing required fields cannot attribute a clone."))
        (let ((*world-reader-evaluated-p* nil))
          (dolist (suffix '("(:source :trailing)" "#.(setf autolith::*world-reader-evaluated-p* t)"))
            (with-open-file (stream metadata :direction ':output :if-exists ':supersede)
              (write valid :stream stream :readably t)
              (terpri stream)
              (write-string suffix stream))
            (test-assert (and (null (world-repository--read-metadata metadata))
                              (null *world-reader-evaluated-p*))
                         "Trailing forms and reader evaluation cannot supply task metadata.")))
        (with-open-file (stream metadata :direction ':output :if-exists ':supersede)
          (write-string "#.(setf autolith::*world-reader-evaluated-p* t)" stream))
        (let ((*world-reader-evaluated-p* nil))
          (test-assert (and (null (world-repository--read-metadata metadata))
                            (null *world-reader-evaluated-p*))
                       "Reader evaluation is disabled for the first metadata form as well.")))))
  nil)
