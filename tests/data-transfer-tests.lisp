(in-package #:autolith)

;;;; -- Portable Data Transfer Behavior --

(-> test-data-transfer--write (pathname vector) pathname)
(defun test-data-transfer--write (path bytes)
  "Create one binary fixture and its parents."
  (ensure-directories-exist path)
  (with-open-file (stream path :direction ':output :element-type '(unsigned-byte 8)
                               :if-exists ':supersede :if-does-not-exist ':create)
    (write-sequence bytes stream))
  path)

(-> test-data-transfer--workspace (configuration pathname) configuration)
(defun test-data-transfer--workspace (configuration directory)
  "Return a fixture configuration for a real workspace directory."
  (ensure-directories-exist directory)
  (configuration-copy configuration :working-directory directory))

(-> test-data-transfer--populate (configuration pathname) list)
(defun test-data-transfer--populate (configuration root)
  "Create portable user state, including binary and referenced session assets."
  (let* ((conversation (conversation-create configuration))
         (identifier   (conversation-identifier conversation))
         (image        (merge-pathnames "queued.png" root))
         (object       (rlm-context-intern configuration "portable context object"))
         (digest       (cl-llm-provider-api:rlm-context-object-digest object))
         (memory       (memory-remember configuration :title "Workspace fact" :content "remember me"))
         (global       (memory-remember configuration :scope ':global :title "Linked global" :content "global guidance"))
         (forgotten    (memory-remember configuration :title "Forgotten" :content "old guidance"))
         (papercut     (papercut-report configuration :title "Resolved issue" :content "durable issue history"))
         (inference    (conversation-create configuration :storage-root (configuration-inference-root configuration))))
    (knowledge-define-schema
     configuration
     (knowledge-make-schema :predicate "transfer.present"
                            :arguments '((:name "item" :type :entity)
                                         (:name "present" :type :boolean))
                            :key '("item") :description "Portable schema"))
    (knowledge-assert configuration '("transfer.present" "fixture" :true) :basis ':assumption)
    (test-conversation--write-tiny-png image)
    (conversation-append-user-message
     conversation (user-message-input-create :text "An image with history" :image-pathnames (list image)))
    (conversation-append-user-message conversation (format nil "Inspect context:~A" digest))
    (conversation-append-user-message inference (format nil "Derived from context:~A" digest))
    (memory-forget configuration (memory-identifier forgotten))
    (memory-remember configuration :identifier (memory-identifier memory)
                     :title "Workspace fact" :content "updated guidance" :source-conversation identifier)
    (papercut-assess configuration (papercut-identifier papercut)
                     :verdict ':improved :note "verified")
    (papercut-mark-closed configuration (papercut-identifier papercut) :resolution "fixed")
    (agenda-add :configuration configuration :state (agenda-load configuration)
                :text "Next task" :memory-identifiers (list (memory-identifier global)
                                                          (memory-identifier memory)))
    (plan-update configuration '((:text "Finish transfer" :status :doing)))
    ;; Asset names hold pathname metacharacters where the host allows them.
    (dolist (name (if (test-fixture-available-p *platform* ':wildcard-file-names)
                      '("plain.bin" "nested [folder]*\\dir/a\\b *?[literal].bin")
                      '("plain.bin" "nested folder/dir/a/b literal.bin")))
      (test-data-transfer--write
       (merge-pathnames (uiop:parse-native-namestring name)
                        (data-transfer--asset-root configuration ':scratchpad identifier))
       (make-array 5 :element-type '(unsigned-byte 8) :initial-contents '(0 1 127 128 255))))
    (test-data-transfer--write
     (merge-pathnames "child/result.sexp" (data-transfer--asset-root configuration ':tasks identifier))
     (data-transfer--forms-bytes (list (list :status ':success :text (format nil "context:~A" digest)))))
    (let ((pending (configuration-pending-inputs-path configuration (conversation-pathname conversation)))
          (vault   (configuration-recovery-input-vault-path configuration (conversation-pathname conversation))))
      (ensure-directories-exist pending)
      (ensure-directories-exist vault)
      (snapshot-write pending
                      (input-state->form
                       (list :snapshot-identifier             "transfer-pending"
                             :steering-items
                             (list (user-message-input-create :text            "queued image"
                                                              :image-pathnames (list image)))
                             :work-items                      '((:native-lisp "(mission-wakeup '(:id (1) :token 1))"))
                             :steering-promotion-prefix-count 1)
                       identifier))
      (snapshot-write vault
                      (list :recovery-input-vault :version 1 :conversation-id identifier
                            :captures (list (list :id "capture-1" :captured-at (get-universal-time)
                                                  :active-work nil :steering-in-flight nil
                                                  :steering '("recovered prompt") :work nil)))))
    (let* ((child-id   (make-identifier))
           (child-root (data-transfer--child-root configuration identifier child-id))
           (child      (conversation-create configuration :identifier child-id :storage-root child-root)))
      (conversation-append-user-message
       child (user-message-input-create :text "child image" :image-pathnames (list image)))
      (snapshot-write (merge-pathnames "result.sexp" child-root)
                      (list :status ':success :conversation-file (namestring (conversation-pathname child))
                            :output "child result"))
      (test-data-transfer--write
       (merge-pathnames "child.lisp" (data-transfer--asset-root configuration ':scratchpad child-id))
       (data-transfer--forms-bytes '((:child :data "kept as data"))))
      (list :conversation conversation :child child :memory memory :global global
            :forgotten forgotten :papercut papercut :digest digest :image image))))

(-> test-data-transfer--empty-and-log-boundaries () null)
(defun test-data-transfer--empty-and-log-boundaries ()
  "Exercise empty archives, native archive names, and append-only log boundaries."
  (with-test-configuration (source root)
    (dolist (workspace (list nil (config :working-directory source)))
      (with-test-configuration (target target-root)
        (let* ((path        (merge-pathnames
                             (uiop:parse-native-namestring
                              (if (test-fixture-available-p *platform* ':wildcard-file-names)
                                  (if workspace "empty workspace [*].sexp" "empty all\\data.sexp")
                                  (if workspace "empty workspace.sexp" "empty all data.sexp")))
                             root))
               (destination (merge-pathnames "relocated/" target-root)))
          (ensure-directories-exist destination)
          (data-export (uiop:native-namestring path) :workspace workspace :configuration source)
          (test-assert (zerop (getf (data-import (uiop:native-namestring path)
                                               :workspace     (and workspace destination)
                                               :configuration target) :installed-files))
                       "empty all-data and workspace archives round-trip without durable writes"))))
    (let* ((memory (memory-remember source :title "Imported" :content "first appended record"))
           (path   (merge-pathnames "log-boundary.sexp" root)))
      (data-export path :configuration source)
      (dolist (kind '(:empty :comment))
        (with-test-configuration (target)
          (when (eq kind ':comment)
            (memory-remember target :title "Existing" :content "local memory"))
          (let ((destination (configuration-memory-path target)))
            (ensure-directories-exist destination)
            (with-open-file (stream destination :direction ':output :if-exists ':append
                                               :if-does-not-exist ':create)
              (when (eq kind ':comment) (write-string "; unterminated final comment" stream)))
            (data-import path :configuration target)
            (test-assert (memory-find target (memory-identifier memory))
                         "empty logs gain a header and final comments cannot swallow imported records"))))))
  nil)

(-> test-data-transfer--fails-p (function &optional symbol) boolean)
(defun test-data-transfer--fails-p (function &optional (type 'data-transfer-error))
  "Return true only when FUNCTION signals the expected typed transfer failure."
  (handler-case (progn (funcall function) nil)
    (error (condition) (typep condition type))))

(-> test-data-transfer--reader-isolation () null)
(defun test-data-transfer--reader-isolation ()
  "Read archives with standard list syntax regardless of the caller's readtable."
  (with-test-configuration (configuration root)
    (let* ((archive     (data-transfer--collect configuration nil))
           (path        (merge-pathnames "reader.sexp" root))
           (*readtable* (copy-readtable nil))
           (called-p    nil))
      (data-transfer--write-export path archive)
      (set-macro-character #\( (lambda (stream character)
                                 (declare (ignore stream character))
                                 (setf called-p t)
                                 (error 'simple-error :format-control "Ambient list reader invoked")))
      (test-assert (equalp archive (data-transfer--read path))
                   "the archive reader uses its own standard list reader")
      (test-assert (not called-p) "ambient reader macros do not run")))
  nil)

(-> test-data-transfer--extend-session (list) list)
(defun test-data-transfer--extend-session (session)
  "Append another valid sequenced record to an archived transcript."
  (let* ((segment (first (last (getf session :segments))))
         (record  (copy-tree (first (last (getf segment :records))))))
    (incf (getf (rest record) :seq))
    (setf (getf segment :records) (append (getf segment :records) (list record))))
  session)

(-> test-data-transfer--family-boundaries () null)
(defun test-data-transfer--family-boundaries ()
  "Exercise each family's validation, read-only planning, reuse and merge conflicts."
  (with-test-configuration (source root)
    (with-test-configuration (target)
      (test-data-transfer--populate source root)
      (let* ((archive (data-transfer--collect source nil))
             (path    (merge-pathnames "families.sexp" root))
             (writers 0))
        (dolist (family *data-transfer-families*)
          (test-assert (consp (getf archive family)) "every family has collected durable records"))
        (test-call-with-function-replacements
         (list (list 'snapshot-write (lambda (&rest arguments)
                                      (declare (ignore arguments)) (incf writers)))
               (list 'log-append (lambda (&rest arguments)
                                  (declare (ignore arguments)) (incf writers)))
               (list 'data-transfer--publish-files
                     (lambda (&rest arguments)
                       (declare (ignore arguments)) (incf writers))))
         (lambda ()
           (test-assert (consp (data-transfer--plan-import target archive))
                        "planning an empty destination produces writes")))
        (test-assert (zerop writers) "planning invokes no storage writer")
        (data-transfer--write-export path archive)
        (data-import path :configuration target)
        (test-assert (null (data-transfer--plan-import target archive))
                     "identical installed records need no writes")
        (dolist (family *data-transfer-families*)
          (let ((invalid (copy-tree archive)))
            (setf (getf invalid family) '(:invalid))
            (delete-file path)
            (data-transfer--write-export path invalid)
            (test-assert (test-data-transfer--fails-p
                          (lambda () (data-import path :configuration target)))
                         "malformed records in every family are rejected")))
        (dolist (case
                 (list
                  (cons :sessions
                        (lambda (copy)
                          (test-data-transfer--extend-session
                           (find ':conversation (getf copy :sessions)
                                 :key (lambda (session) (getf session :kind))))))
                  (cons :children
                        (lambda (copy)
                          (test-data-transfer--extend-session
                           (getf (first (getf copy :children)) :session))))
                  (cons :memories
                        (lambda (copy)
                          (setf (getf (rest (first (getf copy :memories))) :content) "Divergent history")))
                  (cons :papercuts
                        (lambda (copy)
                          (setf (getf (rest (first (getf copy :papercuts))) :title) "Divergent issue")))
                  (cons :knowledge
                        (lambda (copy)
                          (incf (getf (rest (find ':claim-asserted (getf copy :knowledge)
                                                  :key #'first)) :time))))
                  (cons :agendas
                        (lambda (copy)
                          (setf (getf (rest (first (getf (rest (first (getf copy :agendas))) :items)))
                                      :text) "Divergent agenda item")))
                  (cons :plans
                        (lambda (copy)
                          (setf (getf (rest (first (getf copy :plans))) :explanation) "Divergent plan")))))
          (let ((copy (copy-tree archive)) (publications 0))
            (funcall (rest case) copy)
            (data-transfer--validate copy path)
            (delete-file path)
            (data-transfer--write-export path copy)
            (test-call-with-function-replacements
             (list (list 'data-transfer--publish-writes
                         (lambda (writes)
                           (declare (ignore writes)) (incf publications) 0)))
             (lambda ()
               (test-assert (test-data-transfer--fails-p
                             (lambda () (data-import path :configuration target))
                             'data-transfer-conflict)
                            (format nil "~A identity conflicts are rejected" (first case)))))
            (test-assert (zerop publications) "identity conflicts precede the publication boundary")
            (test-assert (equalp archive (data-transfer--collect target nil))
                         "rejected imports preserve every durable family"))))))
  nil)

(-> test-data-transfer--segment-layout (list keyword) list)
(defun test-data-transfer--segment-layout (session layout)
  "Represent SESSION as a legacy log, named chunk, or mixed legacy/chunk transcript."
  (let* ((segments (getf session :segments))
         (header   (copy-tree (first (getf (first segments) :records))))
         (records  (loop for segment in segments append (rest (getf segment :records))))
         (identity (merge-pathnames (make-pathname :name (getf session :id) :type "sexp")
                                    (uiop:temporary-directory))))
    (flet ((segment (start chunk-records named-p)
             (let ((chunk-header (copy-tree header)))
               (if named-p
                   (let ((projection (conversation--from-header
                                      identity (conversation-chunk-pathname identity 1) header)))
                     (dolist (record records)
                       (when (< (getf (rest record) :seq) start)
                         (conversation--apply-record projection record)))
                     (setf chunk-header
                           (conversation--header-record projection :chunk-start-sequence start)))
                   (progn
                     (setf (getf (rest chunk-header) :version) 1)
                     (remf (rest chunk-header) :chunk-start-sequence)))
               (list :name    (when named-p
                                (file-namestring (conversation-chunk-pathname identity start)))
                     :records (cons chunk-header chunk-records)))))
      (setf (getf session :segments)
            (ecase layout
              (:legacy
               (list (segment 1 records nil)))
              (:chunk
               (list (segment 1 records t)))
              (:mixed
               (list (segment 1 (list (first records)) nil)
                     (segment 2 (rest records) t)))))))
  session)

(-> test-data-transfer--transcript-layouts () null)
(defun test-data-transfer--transcript-layouts ()
  "Import, reuse and compare root and child transcripts in each supported segment layout."
  (with-test-configuration (source root)
    (let* ((conversation (conversation-create source))
           (owner        (conversation-identifier conversation))
           (child-id     (make-identifier))
           (child        (conversation-create
                          source :identifier child-id
                          :storage-root      (data-transfer--child-root source owner child-id))))
      (dolist (session (list conversation child))
        (conversation-append-user-message session "First turn")
        (conversation-append-user-message session "Second turn"))
      (dolist (layout '(:legacy :chunk :mixed))
        (with-test-configuration (target)
          (let* ((archive (data-transfer--collect source nil))
                 (session (find owner (getf archive :sessions) :test #'equal
                                :key                                 (lambda (entry) (getf entry :id))))
                 (child   (getf (first (getf archive :children)) :session))
                 (path    (merge-pathnames (format nil "segments-~A.sexp" layout) root)))
            (test-data-transfer--segment-layout session layout)
            (test-data-transfer--segment-layout child layout)
            (data-transfer--validate archive path)
            (data-transfer--write-export path archive)
            (data-import path :configuration target)
            (test-assert (equalp archive (data-transfer--collect target nil))
                         "root and child segment placement preserves the archive")
            (dolist (kind '(:sessions :children))
              (let* ((divergent (copy-tree archive))
                     (session   (if (eq kind ':children)
                                    (getf (first (getf divergent :children)) :session)
                                    (find owner (getf divergent :sessions) :test #'equal
                                          :key                                   (lambda (entry) (getf entry :id))))))
                (test-data-transfer--extend-session session)
                (data-transfer--validate divergent path)
                (test-assert (test-data-transfer--fails-p
                              (lambda () (data-transfer--plan-import target divergent))
                              'data-transfer-conflict)
                             "divergent root and child transcripts conflict in every layout")))
            (let* ((root-identity  (conversation-identifier--pathname
                                    (configuration-conversation-root target) owner))
                   (child-id       (getf child :id))
                   (child-identity (conversation-identifier--pathname
                                    (data-transfer--child-root target owner child-id) child-id))
                   (paths          (append (conversation-storage-pathnames root-identity)
                                           (conversation-storage-pathnames child-identity))))
              ;; Existing printer choices are not a transcript conflict.
              (dolist (stored paths)
                (let ((records (log-read stored)))
                  (test-data-transfer--write
                   stored
                    (utf8-string-to-octets
                     (let ((*print-case* ':upcase) (*print-pretty* nil))
                       (with-output-to-string (stream)
                         (dolist (record records)
                           (write record :stream stream :readably t)
                           (format stream "~%~%"))))))))
              (let ((bytes (mapcar #'data-transfer--bytes paths)))
                (test-assert (zerop (getf (data-import path :configuration target) :installed-files))
                             "record-equivalent root and child segments are reused")
                (test-assert (every #'equalp bytes (mapcar #'data-transfer--bytes paths))
                             "reuse preserves the existing segment bytes"))))))))
  nil)

(-> test-data-transfer-roundtrip () null)
(defun test-data-transfer-roundtrip ()
  "Round-trip durable collections, replay/image assets, queued input, and native names."
  (test-data-transfer--empty-and-log-boundaries)
  (test-data-transfer--reader-isolation)
  (test-data-transfer--family-boundaries)
  (test-data-transfer--transcript-layouts)
  (with-test-configuration (source root)
    (with-test-configuration (target)
      (let* ((fixture      (test-data-transfer--populate source root))
             (conversation (getf fixture :conversation))
             (identifier   (conversation-identifier conversation))
             (path         (merge-pathnames "all.sexp" root))
             (before       (data-transfer--collect source nil)))
        (let ((report (data-export path :configuration source)))
          (test-assert (= (getf report :conversations) 1) "all export includes the conversation")
          (test-assert (= (getf report :inferences) 1) "all export includes inference replay")
          (test-assert (= (getf report :memories) 3) "all export retains forgotten memory history")
          (test-assert (test-fixture-permissions-p *platform* path ':private-file)
                       "the archive is private"))
        (test-assert (plusp (getf (data-import path :configuration target) :installed-files))
                     "the first import publishes durable files")
        (let ((after (data-transfer--collect target nil)))
          (test-assert (equalp before after) "all portable records and binary assets round-trip exactly"))
        (test-assert (zerop (getf (data-import path :configuration target) :installed-files))
                     "an identical second import is idempotent")
        (let ((restored (conversation-load-by-id target identifier)))
          (test-assert (= (conversation-user-turn-count restored) 2) "conversation replay restores user turns")
          (test-assert (probe-file (conversation-log-pathname restored)) "conversation chunks are resumable"))
        (test-assert (null (memory-find target (memory-identifier (getf fixture :forgotten))))
                     "memory tombstones survive import")
        (test-assert (null (papercut-list target)) "closed papercuts do not reactivate")
        (test-assert (plan-load target) "the imported plan is found under its workspace hash")
        (test-assert (equal (nth-value 1 (rlm-context-object-find target (getf fixture :digest)))
                            "portable context object")
                     "context resource identity resolves to its exact content")
        (let* ((pending-path (configuration-pending-inputs-path target (conversation-pathname conversation)))
               (pending      (snapshot-read pending-path))
               (queued       (first (getf (rest pending) :steering)))
               (image-name   (first (getf (rest queued) :image-pathnames))))
          (delete-file (getf fixture :image))
          (test-assert (probe-file image-name) "queued images no longer rely on the source machine")
          (test-assert (uiop:string-prefix-p (namestring (config :data-root target)) image-name)
                       "queued images resolve under the importing data root"))
        (test-assert (not (probe-file (configuration-auth-path target))) "authentication is outside the archive")
        (test-assert (not (probe-file (configuration-user-init-path target))) "initialization code is outside the archive"))))
  nil)

(-> test-data-transfer--state-contexts () null)
(defun test-data-transfer--state-contexts ()
  "Transfer contexts referenced only by plans, pending inputs, or recovery captures."
  (with-test-configuration (source root)
    (with-test-configuration (target)
      (let* ((conversation (conversation-create source))
             (identifier   (conversation-identifier conversation))
             (texts        '("Plan-only context" "Pending-only context" "Recovery-only context"))
             (digests      (mapcar (lambda (text)
                                    (cl-llm-provider-api:rlm-context-object-digest
                                     (rlm-context-intern source text))) texts))
             (references   (mapcar (lambda (digest) (format nil "context:~A" digest)) digests))
             (pending      (configuration-pending-inputs-path source (conversation-pathname conversation)))
             (vault        (configuration-recovery-input-vault-path source (conversation-pathname conversation)))
             (path         (merge-pathnames "state-contexts.sexp" root)))
        (conversation-append-user-message conversation "Conversation with queued context references")
        (plan-update source (list (list :text (first references) :status ':doing)))
        (ensure-directories-exist pending)
        (snapshot-write pending
                        (list :pending-inputs :version 1 :conversation-id identifier
                              :steering (list (second references)) :work nil))
        (ensure-directories-exist vault)
        (snapshot-write vault
                        (list :recovery-input-vault :version 1 :conversation-id identifier
                              :captures (list (list :id "context-capture" :captured-at (get-universal-time)
                                                    :active-work nil :steering-in-flight nil
                                                    :steering (list (third references)) :work nil))))
        (data-export path :workspace (config :working-directory source) :configuration source)
        (data-import path :configuration target)
        (loop for digest in digests for text in texts do
          (test-assert (equal text (nth-value 1 (rlm-context-object-find target digest)))
                       "each state-only context reference resolves after workspace import")))))
  nil)

(-> test-data-transfer--stored-workspace () null)
(defun test-data-transfer--stored-workspace ()
  "Preserve archived workspace ownership when the original directory becomes a symlink."
  (with-test-fixture (':symbolic-links "workspace ownership across a symlinked directory")
    (with-test-configuration (base root)
      (with-test-configuration (target)
        (let* ((directory   (merge-pathnames "original/" root))
               (source      (test-data-transfer--workspace base directory))
               (replacement (merge-pathnames "replacement/" root))
               (fixture     (test-data-transfer--populate source root))
               (key         (workspace-directory-name directory))
               (path        (merge-pathnames "original.sexp" root))
               (after-path  (merge-pathnames "after-replacement.sexp" root)))
          (declare (ignore fixture))
          (data-export path :configuration source)
          (ensure-directories-exist replacement)
          (sb-posix:rmdir (uiop:native-namestring directory))
          (test-fixture-make-symbolic-link
           *platform*
           (uiop:native-namestring replacement)
           (string-right-trim "/" (uiop:native-namestring directory)))
          (unwind-protect
               (progn
                 (test-assert (plusp (getf (data-import path :configuration target) :installed-files))
                              "archive validation does not resolve stored workspace keys")
                 (data-export after-path :configuration source)
                 (test-assert (equal (list key) (getf (data-transfer--read after-path) :workspaces))
                              "collection preserves the original ownership of every durable entity")
                 (test-assert (zerop (getf (data-import after-path :configuration target) :installed-files))
                              "a changed filesystem alias does not change session identity"))
            (test-fixture-remove-link
             *platform*
             (string-right-trim "/" (uiop:native-namestring directory))))))))
  nil)

(-> test-data-transfer--native-workspaces () null)
(defun test-data-transfer--native-workspaces ()
  "Remap literal native directory arguments with and without trailing separators."
  (with-test-configuration (source root)
    (with-test-configuration (target target-root)
      (let ((path (merge-pathnames "native-workspace.sexp" root)))
        (data-export path :workspace (config :working-directory source) :configuration source)
        ;; Literal metacharacters appear only where the host allows them.
        (dolist (name (if (test-fixture-available-p *platform* ':wildcard-file-names)
                          '("new [repo]" "new \\repo" "new *repo")
                          '("new repo")))
          (let* ((native    (uiop:native-namestring
                             (merge-pathnames (uiop:parse-native-namestring name) target-root)))
                 (directory (uiop:native-namestring
                             (data-transfer--directory-pathname
                              (uiop:parse-native-namestring native)))))
            (dolist (existing-p '(nil t))
              (when existing-p
                (ensure-directories-exist (uiop:parse-native-namestring directory)))
              (dolist (argument (list native (uiop:parse-native-namestring native) directory))
                (let ((report (data-import path :workspace argument :configuration target)))
                  (test-assert (equal directory (uiop:native-namestring
                                                 (pathname (getf report :workspace))))
                               "native workspace remapping preserves literal path characters")))))))))
  nil)

(-> test-data-transfer-workspace () null)
(defun test-data-transfer-workspace ()
  "Filter strictly by ownership, include linked globals, and relocate structured keys."
  (test-data-transfer--state-contexts)
  (test-data-transfer--stored-workspace)
  (test-data-transfer--native-workspaces)
  (with-test-configuration (base root)
    (with-test-configuration (target target-root)
      (let* ((source         (test-data-transfer--workspace base (merge-pathnames "project one/" root)))
             (other          (test-data-transfer--workspace base (merge-pathnames "project two/" root)))
             (fixture        (test-data-transfer--populate source root))
             (foreign        (conversation-create other))
             (foreign-memory (memory-remember other :title "Foreign fact" :content "not exported"))
             (destination    (merge-pathnames
                              (uiop:parse-native-namestring
                               (if (test-fixture-available-p *platform* ':wildcard-file-names)
                                   "new [repo]*\\name/"
                                   "new repo name/"))
                              target-root))
             (path           (merge-pathnames "workspace.sexp" root)))
        (conversation-append-user-message foreign "private foreign workspace history")
        (conversation-append-user-message
         (getf fixture :conversation)
         (format nil "Literal foreign id ~A and folder ~A must remain prose."
                 (conversation-identifier foreign) (config :working-directory source)))
        (memory-remember source :scope ':global :title "Unlinked global" :content "not a workspace dependency")
        (rlm-context-intern source "unreferenced object")
        ;; An old agenda may contain a link whose memory later moved elsewhere.
        (let* ((form (snapshot-read (configuration-agenda-path source)))
               (item (first (getf (rest (first (getf (rest form) :records))) :items))))
          (push (memory-identifier foreign-memory) (getf (rest item) :memory-ids))
          (snapshot-write (configuration-agenda-path source) form))
        (let* ((report  (data-export path :workspace (config :working-directory source) :configuration source))
               (archive (data-transfer--read path)))
          (test-assert (= (getf report :conversations) 1) "mentions of foreign IDs do not export foreign conversations")
          (test-assert (= (getf report :memories) 3) "only owned histories and the linked global are exported")
          (test-assert (= (count ':context (getf archive :files) :key (lambda (file) (getf file :area))) 1)
                       "workspace exports include referenced context objects only")
          (test-assert (not (find (memory-identifier foreign-memory) (getf archive :memories)
                                  :key (lambda (record) (getf (rest record) :id)) :test #'equal))
                       "links cannot pull another workspace's memory into an export"))
        (ensure-directories-exist destination)
        (data-import path :workspace destination :configuration target)
        (let* ((target     (configuration-copy target :working-directory destination))
               (identifier (conversation-identifier (getf fixture :conversation)))
               (loaded     (conversation-load-by-id target identifier))
               (archive    (data-transfer--collect target nil))
               (directory  (workspace-directory-name destination)))
          (test-assert (equal (conversation-origin-directory loaded) directory) "session ownership follows remapping")
          (test-assert (plan-load target) "the plan is rekeyed for the destination workspace")
          (test-assert (equal (memory-workspace (memory-find target (memory-identifier (getf fixture :memory)))) directory)
                       "workspace memories follow remapping")
          (test-assert (eq (memory-scope (memory-find target (memory-identifier (getf fixture :global)))) ':global)
                       "linked global memories keep global scope")
          (test-assert (some (lambda (text) (search "Literal foreign id" text)) (data-transfer--strings archive))
                       "transcript prose is not rewritten")
          (test-assert (not (conversation-storage-occupied-p
                             (conversation-pathname-for-id target (conversation-identifier foreign))))
                       "foreign conversations are absent from the import")
          (test-assert (zerop (getf (data-import path :workspace destination :configuration target) :installed-files))
                       "relocated imports are idempotent")))))
  nil)

(-> test-data-transfer--identity-conflicts () null)
(defun test-data-transfer--identity-conflicts ()
  "Reject cross-parent and top-level/child ID reuse before any shared assets are written."
  (with-test-configuration (source root)
    (let* ((fixture   (test-data-transfer--populate source root))
           (parent-id (conversation-identifier (getf fixture :conversation)))
           (child-id  (conversation-identifier (getf fixture :child)))
           (path      (merge-pathnames "identity-conflicts.sexp" root)))
      (data-export path :configuration source)
      (dolist (kind '(:child-top-level :child-other-parent :top-level-child))
        (with-test-configuration (target)
          (let* ((identifier   (if (eq kind ':top-level-child) parent-id child-id))
                 (owner        (unless (eq kind ':child-top-level)
                                 (conversation-create target :identifier "existing-parent")))
                 (storage-root (if owner
                                   (data-transfer--child-root target (conversation-identifier owner) identifier)
                                   (configuration-conversation-root target)))
                 (existing     (conversation-create target :identifier identifier :storage-root storage-root)))
            (when owner
              (conversation-append-user-message owner "Existing parent history"))
            (conversation-append-user-message existing "existing identity")
            (test-data-transfer--write
             (merge-pathnames "local.bin" (data-transfer--asset-root target ':scratchpad identifier))
             (vector 1 2 3))
            (let ((before (data-transfer--collect target nil)))
              (test-assert (test-data-transfer--fails-p
                            (lambda () (data-import path :configuration target)) 'data-transfer-conflict)
                           "session IDs cannot acquire another owner through import")
              (test-assert (equalp before (data-transfer--collect target nil))
                           "identity preflight preserves existing sessions and ID-keyed assets")))))))
  nil)

(-> test-data-transfer--nested-symlinks () null)
(defun test-data-transfer--nested-symlinks ()
  "Reject symlinks below literal native directory names before reading or publishing assets."
  (with-test-fixture (':symbolic-links "symlinks below literal native directory names")
    (dolist (name (if (test-fixture-available-p *platform* ':wildcard-file-names)
                      '("[directory]" "*directory" "back\\directory")
                      '("plain directory")))
      (with-test-configuration (source root)
        (with-test-configuration (target target-root)
          (let* ((conversation (conversation-create source))
                 (identifier   (conversation-identifier conversation))
                 (relative     (uiop:parse-native-namestring (format nil "~A/link/file.bin" name)))
                 (source-file  (merge-pathnames relative (data-transfer--asset-root source ':scratchpad identifier)))
                 (target-file  (merge-pathnames relative (data-transfer--asset-root target ':scratchpad identifier)))
                 (source-link  (uiop:native-namestring
                                (uiop:pathname-directory-pathname source-file)))
                 (target-link  (uiop:native-namestring
                                (uiop:pathname-directory-pathname target-file)))
                 (outside      (merge-pathnames "outside/" target-root))
                 (path         (merge-pathnames "native-symlink.sexp" root))
                 (rejected     (merge-pathnames "rejected.sexp" root)))
            (conversation-append-user-message conversation "Owned native assets")
            (test-data-transfer--write source-file (vector 1 2 3))
            (data-export path :configuration source)
            (ensure-directories-exist (uiop:pathname-parent-directory-pathname
                                       (uiop:pathname-directory-pathname target-file)))
            (ensure-directories-exist outside)
            (test-fixture-make-symbolic-link
             *platform* (uiop:native-namestring outside) (string-right-trim "/" target-link))
            (unwind-protect
                 (progn
                   (test-assert (eq ':invalid
                                    (handler-case (data-import path :configuration target)
                                      (data-transfer-error (condition)
                                        (data-transfer-error-reason condition))))
                                "import detects the actual symlink below a native directory")
                   (test-assert (and (null (conversation-list target))
                                     (null (uiop:directory-files outside)))
                                "symlink preflight publishes neither sessions nor external files"))
              (test-fixture-remove-link *platform* (string-right-trim "/" target-link)))
            (delete-file source-file)
            (sb-posix:rmdir source-link)
            (test-fixture-make-symbolic-link
             *platform* (uiop:native-namestring outside) (string-right-trim "/" source-link))
            (unwind-protect
                 (test-assert (and (test-data-transfer--fails-p
                                    (lambda () (data-export rejected :configuration source)))
                                  (not (probe-file rejected)))
                              "export rejects nested symlinks before publishing an archive")
              (test-fixture-remove-link *platform* (string-right-trim "/" source-link))))))))
  nil)

(-> test-data-transfer-rejection () null)
(defun test-data-transfer-rejection ()
  "Reject hostile syntax, traversal, bad ownership, missing references, and live conflicts."
  (test-data-transfer--identity-conflicts)
  (test-data-transfer--nested-symlinks)
  (with-test-configuration (source root)
    (with-test-configuration (target)
      (let* ((fixture (test-data-transfer--populate source root))
             (archive (data-transfer--collect source nil))
             (path    (merge-pathnames "invalid.sexp" root)))
        (dolist (syntax (list "#.(error \"must not execute\")" "#S(configuration)" "#1000000000(0)"
                              "(:archive COMMON-LISP:CAR)" "(:archive #(1 256))"
                              (concatenate 'string (make-string 140 :initial-element #\()
                                           "nil" (make-string 140 :initial-element #\)))))
          (with-open-file (stream path :direction ':output :if-exists ':supersede)
            (write-string syntax stream))
          (test-assert (test-data-transfer--fails-p (lambda () (data-import path :configuration target)))
                       "unsafe reader syntax is rejected without publication"))
        (dolist (mutate
                 (list
                  (lambda (copy) (setf (getf copy :version) 999))
                  (lambda (copy) (setf (getf copy :format) ':foreign-data))
                  (lambda (copy) (nconc copy (list :version (getf copy :version))))
                  (lambda (copy) (nconc copy (list :unexpected t)))
                  (lambda (copy) (nconc (first (getf copy :files)) (list :version 1)))
                  (lambda (copy)
                    (let ((file (first (getf copy :files))))
                      (nconc file (list :path (getf file :path)))))
                  (lambda (copy)
                    (let* ((session    (getf (first (getf copy :children)) :session))
                           (identifier (getf session :id)))
                      (setf (getf session :kind) ':inference
                            (getf copy :files)
                            (remove identifier (getf copy :files)
                                    :key (lambda (file) (getf file :owner)) :test #'equal))))
                  (lambda (copy) (setf (getf (first (getf copy :files)) :path) '(".." "escape")))
                  (lambda (copy) (setf (getf copy :workspaces) '("/unrelated/")))
                  (lambda (copy) (setf (getf copy :files)
                                       (remove ':images (getf copy :files) :key (lambda (file) (getf file :area)))))
                  (lambda (copy) (setf (getf copy :files)
                                       (remove ':input (getf copy :files) :key (lambda (file) (getf file :area)))))
                  (lambda (copy)
                    (setf (getf (rest (getf (find ':vault (getf copy :states)
                                                 :key (lambda (state) (getf state :kind))) :form)) :captures)
                          '((:id "broken"))))))
          (let ((copy (copy-tree archive)))
            (funcall mutate copy)
            (when (probe-file path) (delete-file path))
            (data-transfer--write-export path copy)
            (test-assert (test-data-transfer--fails-p (lambda () (data-import path :configuration target)))
                         "malformed archives fail before writing any durable data")
            (test-assert (null (conversation-list target)) "rejected imports publish no sessions")))
        (when (probe-file path) (delete-file path))
        (data-export path :configuration source)
        (test-assert (test-data-transfer--fails-p
                      (lambda () (data-import path :workspace     (config :working-directory source)
                                                   :configuration target)))
                     "an all-data archive cannot be remapped as one workspace")
        (let ((legacy      (copy-tree (first (getf archive :plans))))
              (legacy-path (configuration-legacy-plan-path target)))
          (setf (getf (rest legacy) :explanation) "different local plan")
          (ensure-directories-exist legacy-path)
          (snapshot-write legacy-path legacy)
          (test-assert (test-data-transfer--fails-p
                        (lambda () (data-import path :configuration target)) 'data-transfer-conflict)
                       "a legacy plan cannot be shadowed by an imported workspace plan")
          (test-assert (equal legacy (snapshot-read legacy-path)) "conflicting legacy work is preserved")
          (test-assert (null (conversation-list target)) "legacy conflicts are checked before publication")
          (delete-file legacy-path))
        (data-import path :configuration target)
        (let* ((identifier (conversation-identifier (getf fixture :conversation)))
               (lease      (conversation-lease-acquire target identifier)))
          (unwind-protect
               (test-assert (test-data-transfer--fails-p
                             (lambda () (data-import path :configuration target)) 'data-transfer-conflict)
                            "import refuses a currently leased conversation")
            (conversation-lease-release lease)))
        (let ((loaded (conversation-load-by-id target (conversation-identifier (getf fixture :conversation)))))
          (conversation-append-user-message loaded "local progress")
          (test-assert (test-data-transfer--fails-p
                        (lambda () (data-import path :configuration target)) 'data-transfer-conflict)
                       "different content under an existing session identity is a conflict")))))
  nil)

(-> test-data-transfer-rollback () null)
(defun test-data-transfer-rollback ()
  "Rollback new files and merged collections after a later publication fails."
  (with-test-configuration (source root)
    (with-test-configuration (target)
      (test-data-transfer--populate source root)
      (memory-remember target :title "Local memory" :content "preserve local history")
      (let* ((path          (merge-pathnames "rollback.sexp" root))
             (memory-path   (configuration-memory-path target))
             (memory-before (data-transfer--bytes memory-path))
             (check         (symbol-function 'data-transfer--check-path))
             (seen          (make-hash-table :test #'equal))
             (published     0)
             (drift-p       nil)
             (drifted       nil))
        (data-export path :configuration source)
        (flet ((import-failing ()
                 "Import while the agenda's publication fails, counting earlier publications."
                 (clrhash seen)
                 (setf published 0)
                 (test-call-with-function-replacements
                  (list (list 'data-transfer--check-path
                              (lambda (trusted pathname)
                                (let ((calls (incf (gethash (namestring pathname) seen 0))))
                                  (when (= calls 3)
                                    (if (equal pathname (configuration-agenda-path target))
                                        (error 'simple-error
                                               :format-control "Injected publication failure")
                                        (incf published)))
                                  (when (and drift-p (= calls 4) (null drifted))
                                    (setf drifted pathname)
                                    (test-data-transfer--write pathname #(9))))
                                (funcall check trusted pathname))))
                  (lambda ()
                    (handler-case (progn (data-import path :configuration target) nil)
                      (error (condition) condition))))))
          (test-assert (typep (import-failing) 'data-transfer-error)
                       "a publication failure is reported")
          (test-assert (> published 1) "the failure occurred after multiple publications")
          (test-assert (null (conversation-list target)) "rollback removes newly imported sessions")
          (test-assert (equalp memory-before (data-transfer--bytes memory-path))
                       "rollback restores existing memory bytes exactly")
          (test-assert (not (probe-file (configuration-papercut-path target)))
                       "rollback removes a newly imported collection")
          (setf drift-p t)
          (let* ((condition (import-failing))
                 (failure   (and (typep condition 'data-transfer-rollback-error)
                                 (first (data-transfer-rollback-error-failures condition)))))
            (test-assert (and failure drifted
                              (equal (getf failure :pathname) (namestring drifted)))
                         "a destination edited during rollback is a typed rollback failure")
            (test-assert (and drifted (equalp (data-transfer--bytes drifted) #(9)))
                         "rollback preserves the external edit")
            (when drifted
              (let ((backup (getf failure :backup)))
                (if backup
                    (progn
                      (test-data-transfer--write drifted (data-transfer--bytes (pathname backup)))
                      (delete-file backup))
                    (delete-file drifted)))))
          (setf drift-p nil)
          (test-assert (plusp (getf (data-import path :configuration target) :installed-files))
                       "a clean retry succeeds after rollback")))))
  nil)
