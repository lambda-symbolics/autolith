(in-package #:autolith)

;;;; -- Capture Publication Boundaries --

(-> test-shell-log-publication-owners () null)
(defun test-shell-log-publication-owners ()
  "Keep closed captures across dead capture threads and overlapping boundaries."
  (with-test-configuration (configuration)
    (let* ((*shell-log-active*               (make-hash-table :test #'equal))
           (*shell-log-capture-byte-limit*   32)
           (*shell-log-retention-byte-limit* 32)
           (context                          (shell-log-tests--context configuration "publication-owners"))
           (artifact                         nil)
           (inner                            nil))
      (shell-log-call-with-publication
       configuration
       (lambda ()
         (let* ((publications *shell-log-publications*)
                (active       *shell-log-active*)
                (thread
                  (make-thread
                   (lambda ()
                     (let ((*shell-log-publications*         publications)
                           (*shell-log-active*               active)
                           (*shell-log-capture-byte-limit*   32)
                           (*shell-log-retention-byte-limit* 32))
                       (setf inner (make-instance 'shell-log-publication :configuration configuration))
                       (let ((*shell-log-publications* (cons inner publications)))
                         (setf artifact (shell-log-allocate context))
                         (shell-log-tests--finish artifact (utf8-string-to-octets "held")))))
                   :name "publication capture fixture")))
           (join-thread thread)
           (let ((directory (shell-log-capture-directory artifact)))
             (with-shell-log-lock (configuration)
               (test-assert (shell-log--active-p directory)
                            "A live publisher protects output after its capture thread exits"))
             (shell-log--finish-publication inner)
             (test-assert
              (handler-case (progn (shell-log-allocate context) nil)
                (shell-log-error () t))
              "Byte pressure refuses rather than deleting a pending publication")
             (test-assert (probe-file (merge-pathnames "output.bin" directory))
                          "The independent publisher retains the capture bytes")))))
      (with-shell-log-lock (configuration)
        (test-assert (not (shell-log--active-p (shell-log-capture-directory artifact)))
                     "The last publication boundary releases the process lease"))
      (let ((replacement (shell-log-allocate context)))
        (unwind-protect
             (test-assert (eq ':pruned (getf (shell-log--read-manifest
                                              configuration (shell-log-capture-directory artifact)) :state))
                          "Unpinned closed output becomes reclaimable under byte pressure")
          (shell-log-release-artifact replacement)))))
  nil)

(-> test-shell-log-publication-native-owners () null)
(defun test-shell-log-publication-native-owners ()
  "Reserve space for a real unfinished native writer after publication unwinds."
  (with-test-configuration (configuration)
    (let* ((*shell-log-active*               (make-hash-table :test #'equal))
           (*shell-log-capture-byte-limit*   32)
           (*shell-log-retention-byte-limit* 48)
           (context                          (shell-log-tests--context configuration "publication-native"))
           (artifact                         nil)
           (path                             nil)
           (ready-p                          nil)
           (grow-p                           nil)
           (grown-p                          nil)
           (release-p                        nil)
           (executor                         (symbol-function 'run-sandboxed))
           (cleanup-condition                nil)
           (writer
             (make-thread
              (lambda ()
                (loop until (or path release-p) do (sleep 0.001))
                (when path
                  (with-open-file (stream path :direction ':output :if-exists ':append
                                               :element-type '(unsigned-byte 8))
                    (write-byte 1 stream)
                    (finish-output stream)
                    (setf ready-p t)
                    (loop until (or grow-p release-p) do (sleep 0.001))
                    (when grow-p
                      (write-sequence (make-array 24 :element-type '(unsigned-byte 8) :initial-element 2) stream)
                      (finish-output stream)
                      (setf grown-p t))
                    (loop until release-p do (sleep 0.001)))))
              :name "native capture writer fixture")))
      (unwind-protect
           (progn
             (setf (symbol-function 'run-sandboxed)
                   (lambda (program arguments &rest options)
                     (declare (ignore program arguments))
                     (setf artifact (first (gethash (namestring (getf options :capture-directory))
                                                    *shell-log-active*)))
                     (let ((result (make-instance 'cl-exec-sandbox:sandbox-result
                                                 :output-capture (shell-log-tests--capture artifact
                                                                   (utf8-string-to-octets "native"))
                                                 :exit-code nil :timed-out-p nil
                                                 :cancelled-p t :status ':cancelled)))
                       (funcall (getf options :capture-created-function) result)
                       (funcall (getf options :capture-function) result)
                       (setf path (merge-pathnames "output.bin" (shell-log-capture-directory artifact))
                             cleanup-condition
                             (make-condition 'cl-exec-sandbox:sandbox-process-cleanup-error
                                             :message       "Controlled reader cleanup deadline."
                                             :command '("fixture") :result result
                                             :process nil :alive-p t :termination-timeout 0.01
                                             :cleanup-thread nil :cleanup-readers (list writer)
                                             :cleanup-retry nil))
                       (error cleanup-condition))))
             (test-assert
              (handler-case
                  (progn (workspace-tool-run-shell-command "fixture" (config :working-directory configuration)
                                                           :context context :timeout 1 :output-limit 100)
                         nil)
                (cl-exec-sandbox:sandbox-process-cleanup-error (condition)
                  (eq condition cleanup-condition)))
              "No-job cleanup propagates the original condition while retaining its real writer")
             (setf (symbol-function 'run-sandboxed) executor)
             (test-assert (task-tests--wait-until (lambda () ready-p) 5)
                          "The real writer holds an open capture stream after publication")
             (test-assert
              (handler-case (progn (shell-log-allocate context) nil)
                (shell-log-error () t))
              "Reserve the writer's future bytes instead of admitting against its tiny current size")
             (setf grow-p t)
             (test-assert (task-tests--wait-until (lambda () grown-p) 5)
                          "The writer grows its capture after the competing allocation")
             (test-assert (= 31 (with-open-file (stream path :element-type '(unsigned-byte 8))
                                  (file-length stream)))
                          "The growing capture was neither deleted nor replaced under pressure")
             (setf release-p t)
             (join-thread writer)
             (let ((replacement (shell-log-allocate context)))
               (unwind-protect
                    (test-assert (not (probe-file path))
                                 "Stopped native owners no longer pin output")
                 (shell-log-release-artifact replacement))))
        (setf (symbol-function 'run-sandboxed) executor)
        (setf release-p t)
        (join-thread writer))))
  nil)

(-> shell-log-publication-tests--probe (tool-context list) list)
(defun shell-log-publication-tests--probe (context details)
  "Observe lease continuity and force a competing byte-pressure allocation."
  (let* ((configuration (tool-context-configuration context))
         (log           (first (getf details :shell-logs)))
         (root          (conversation-identifier (tool-context-conversation context)))
         (directory     (merge-pathnames
                         (format nil "~A/shell-log/~A/" (getf log :execution-id) (getf log :artifact-id))
                         (task--artifact-group-root configuration root)))
         (active-p      (with-shell-log-lock (configuration) (shell-log--active-p directory)))
         (refused-p     nil)
         (contender
           (make-thread
            (lambda ()
              (let ((*shell-log-capture-byte-limit*   32)
                    (*shell-log-retention-byte-limit* 32))
                (setf refused-p
                      (handler-case
                          (let ((replacement (shell-log-allocate context)))
                            (shell-log-release-artifact replacement)
                            nil)
                        (shell-log-error () t)))))
            :name "publication prune contender")))
    (join-thread contender)
    (list :active-p active-p :refused-p refused-p
          :present-p (not (null (getf (shell-log--read-manifest configuration directory) :captures)))
          :directory directory)))

(-> test-shell-log-publication-boundaries () null)
(defun test-shell-log-publication-boundaries ()
  "Race real terminal, contract, and conversation publication against allocation."
  (shell-log-job-tests--fixture
   (lambda (configuration parent orchestrator context registry)
     (declare (ignore orchestrator))
     (contract-tests--define-ready configuration)
     (knowledge-define-contract configuration :id "shell-publication" :tool "shell.run"
                                :observes (gethash "observes" (contract-tests--operation "shell-proof")))
     (let* ((terminal      (symbol-function 'task-continuity-record-terminal))
            (record        (symbol-function 'knowledge-contract-record))
            (append-result (symbol-function 'conversation-append-tool-result))
            (observations  nil)
            (lock          (make-lock "publication observations"))
            (observer      (make-instance 'callback-agent-observer
                                          :command-authorization-callback
                                          (lambda (command directory)
                                            (declare (ignore command directory)) ':full-access)))
            (command       (test-fixture-shell-command *platform* "printf publication" "[Console]::Write('publication')")))
       (labels ((note (stage details)
                  (let ((observation (shell-log-publication-tests--probe context details)))
                    (with-lock-held (lock)
                      (push (cons stage observation) observations)))))
         (unwind-protect
              (progn
                (setf (symbol-function 'task-continuity-record-terminal)
                      (lambda (job owner result &rest options)
                        (multiple-value-prog1 (apply terminal job owner result options)
                          (note ':terminal (getf result :details)))))
                (setf (symbol-function 'knowledge-contract-record)
                      (lambda (settings matches &rest options)
                        (let ((details (tool-result-details (getf options :result))))
                          (note ':evidence-before details)
                          (multiple-value-prog1 (apply record settings matches options)
                            (note ':evidence-after details)))))
                (setf (symbol-function 'conversation-append-tool-result)
                      (lambda (conversation call-id &rest options)
                        (when (equal "shell.run" (getf options :tool-name))
                          (note ':conversation-before (getf options :details)))
                        (multiple-value-prog1 (apply append-result conversation call-id options)
                          (when (equal "shell.run" (getf options :tool-name))
                            (note ':conversation-after (getf options :details))))))
                (agent--run-tool-wave
                 parent
                 (loop for index below 2
                       collect (list :call        (agent-test-call :call-id  (format nil "publication-~D" index)
                                                                  :namespace "shell" :name "run"
                                                                  :arguments (json-encode (json-object "command" command)))
                                     :tool        (tool-registry-find registry "shell" "run")
                                     :persistence ':durable))
                 :observer observer :tool-round 1))
           (setf (symbol-function 'task-continuity-record-terminal) terminal
                 (symbol-function 'knowledge-contract-record) record
                 (symbol-function 'conversation-append-tool-result) append-result))
         (test-assert (= 10 (length observations))
                      "Both concurrent calls reach all five actual publication boundaries")
         (dolist (observation observations)
           (let ((details (rest observation)))
             (test-assert (and (getf details :active-p) (getf details :refused-p)
                               (getf details :present-p))
                          "Every publication boundary retains its live lease and raw output")
             (with-shell-log-lock (configuration)
               (test-assert (not (shell-log--active-p (getf details :directory)))
                            "Completed wave publication releases every capture lease"))))))))
  nil)

(-> test-shell-log-publication-pending () null)
(defun test-shell-log-publication-pending ()
  "Distinguish admitted outstanding delivery from terminal-only and removed owners."
  (with-test-configuration (configuration)
    (let* ((*shell-log-active* (make-hash-table :test #'equal))
           (context            (shell-log-tests--context configuration "publication-no-admission"))
           (artifact           (shell-log-allocate context)))
      (unwind-protect
           (let ((metadata (shell-log-tests--finish artifact #(65))))
             (with-shell-log-lock (configuration)
               (test-assert (and (null (getf metadata :completion-owner-conversation))
                                 (not (shell-log--publication-pending-p configuration metadata)))
                            "A closed no-job capture without admission has no pending owner")
               (test-assert (shell-log--prunable-p configuration (shell-log-capture-directory artifact) metadata)
                            "A missing receipt alone does not protect an ordinary closed capture")))
        (shell-log-release-artifact artifact))))
  (shell-log-job-tests--fixture
   (lambda (configuration parent orchestrator context registry)
     (conversation-append-user-message (agent-conversation parent) "Await this detached publication.")
     (let* ((result (tool-execute
                     (tool-registry-find registry "shell" "run") context
                     (json-object "command" (test-fixture-shell-command *platform* "printf pending" "[Console]::Write('pending')")
                                  "async" t)))
            (job    (task-orchestrator-find-visible-job
                     orchestrator (getf (getf (rest (tool-result-details result)) :job) :id)
                     :viewer parent :tool-name "job.get")))
       (multiple-value-bind (snapshot terminal-p) (session-job-await job 10)
         (declare (ignore snapshot))
         (test-assert terminal-p "The admitted detached result has durable terminal evidence"))
       (let* ((execution       (session-job-execution-identifier job))
              (root            (session-job-root-conversation-identifier job))
              (group           (task--artifact-group-root configuration root))
              (log             (first (getf (job-result job) :shell-logs)))
              (directory       (merge-pathnames (format nil "~A/shell-log/~A/" execution (getf log :artifact-id)) group))
              (metadata        (shell-log--read-manifest configuration directory))
              (owner           (getf metadata :completion-owner-conversation))
              (index-path      (task-completion--index-path group owner))
              (index           (task-continuity--read index-path))
              (continuity-path (merge-pathnames (format nil "~A/continuity.sexp" execution) group))
              (continuity      (task-continuity--read continuity-path)))
         (flet ((pending-p (&optional (candidate metadata))
                  (with-shell-log-lock (configuration)
                    (shell-log--publication-pending-p configuration candidate))))
           (test-assert (pending-p) "Actual admitted outstanding completion protects its exact artifact")
           (dolist (invalid-owner '(nil "../foreign" "different-owner"))
             (let ((wrong (copy-list metadata)))
               (setf (getf wrong :completion-owner-conversation) invalid-owner)
               (test-assert (handler-case (progn (pending-p wrong) nil) (shell-log-error () t))
                            "A corrupt required manifest owner refuses deletion of admitted output")))
           (dolist (key '(:root-conversation :execution-id :artifact-id))
             (let ((wrong (copy-list metadata)))
               (setf (getf wrong key) nil)
               (test-assert (handler-case (progn (pending-p wrong) nil) (shell-log-error () t))
                            "A malformed required capture identity refuses deletion before path construction")))
           (let* ((identity (shell-log--owner-identity configuration root owner))
                  (path     (conversation-storage-active-pathname identity))
                  (forms    (conversation--read-records path)))
             (unwind-protect
                  (progn
                    (let ((wrong (copy-tree forms)))
                      (setf (getf (rest (first wrong)) :id) "different-owner")
                      (conversation-identifier-migration--write-forms path wrong))
                    (test-assert (handler-case (progn (pending-p) nil) (shell-log-error () t))
                                 "An occupied indexed owner with a mismatched header refuses deletion")
                    (with-open-file (stream path :direction ':output :if-exists ':supersede)
                      (write-string "(:conversation" stream))
                    (test-assert (handler-case (progn (pending-p) nil) (shell-log-error () t))
                                 "An occupied indexed owner with an unreadable header refuses deletion"))
               (conversation-identifier-migration--write-forms path forms)))
           (unwind-protect
                (progn
                  (platform-delete-file *platform* continuity-path)
                  (test-assert (handler-case (progn (pending-p) nil) (shell-log-error () t))
                               "A missing continuity record cannot discard an indexed terminal obligation"))
             (task-continuity--write continuity-path continuity))
           (dolist (change '((:detached-p nil)
                             (:detached-p :unknown)
                             (:completion-policy nil)
                             (:completion-policy :unknown)
                             (:completion-owner-conversation nil)
                             (:completion-owner-conversation "../foreign")
                             (:version 99)
                             (:root-conversation "different-root")
                             (:execution-id "different-execution")
                             (:job-id "different-job")))
             (let ((wrong (copy-list continuity)))
               (setf (getf wrong (first change)) (second change))
               (unwind-protect
                    (progn
                      (task-continuity--write continuity-path wrong)
                      (test-assert (handler-case (progn (pending-p) nil) (shell-log-error () t))
                                   (format nil "An indexed obligation refuses independently corrupt admission field ~A" change))
                      (task-continuity--write index-path (list :version 1 :execution-ids nil))
                      (test-assert (not (pending-p))
                                   (format nil "Without an outstanding index, admission field ~A grants no pin" change)))
                 (task-continuity--write continuity-path continuity)
                 (task-continuity--write index-path index))))
           (task-continuity--write index-path (list :version 1 :execution-ids nil))
           (test-assert (not (pending-p)) "A terminal and missing receipt do not pin a dead orphan")
           (task-continuity--write index-path index)
           (let ((wrong (copy-list continuity)))
             (setf (getf wrong :completion-owner-conversation) "different-owner")
             (task-continuity--write continuity-path wrong))
           (test-assert (handler-case (progn (pending-p) nil) (shell-log-error () t))
                        "A different continuity owner cannot discard an existing indexed obligation")
           (task-continuity--write continuity-path continuity)
           (task-continuity--write index-path (list :version 99 :execution-ids (list execution)))
           (test-assert (handler-case (progn (pending-p) nil) (shell-log-error () t))
                        "Unreadable delivery authority refuses pruning instead of declaring an orphan")
           (task-continuity--write index-path index)
           (let ((identity (shell-log--owner-identity configuration root owner)))
             (dolist (segment (conversation-storage-pathnames identity))
               (platform-delete-file *platform* segment))
             (platform-delete-directory-tree *platform* (conversation-storage-directory-pathname identity)
                                             :validate t :if-does-not-exist ':ignore))
           (test-assert (not (pending-p)) "A removed owner cannot protect orphaned completion storage"))))))
  nil)
