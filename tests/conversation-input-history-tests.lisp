(in-package #:autolith)

;;;; -- Complete Input History --

(-> test-conversation-input-history-complete () null)
(defun test-conversation-input-history-complete ()
  "Test unbounded history, filtering and maintenance without archived reads."
  (with-test-configuration (configuration)
    (let* ((conversation (conversation-create configuration))
           (identity     (conversation-pathname conversation))
           (expected     nil))
      (dotimes (index 130)
        (let ((input (format nil "input ~D" index)))
          (push input expected)
          (conversation-append-user-message conversation input))
        (when (zerop (mod (1+ index) 25))
          (conversation-append-summary conversation (make-continuation :intent "checkpoint"))))
      (dolist (kind '(:command :lisp))
        (push "duplicate" expected)
        (conversation-append-user-operation
         conversation :kind kind :source "duplicate" :status ':ok :result "ignored"))
      (conversation-append-record
       conversation '(:message :role :user :content "automatic" :automatic-p t))
      (conversation-append-record
       conversation '(:message :role :assistant :content "assistant"))
      (setf expected (nreverse expected))
      (test-assert (equal (conversation-input-history conversation) expected)
                   "all 132 editable inputs retain chronological order and duplicate text")
      (with-open-file (stream (first (conversation-storage-pathnames identity))
                              :direction ':output :if-exists ':supersede)
        (write-string "(" stream))
      (test-call-with-function-replacements
       (list (list 'conversation--map-storage-records
                   (lambda (&rest arguments)
                     (declare (ignore arguments))
                     (error "Input history must not scan retired segments."))))
       (lambda ()
         (let ((loaded (conversation-load identity)))
           (test-assert (equal (conversation-input-history loaded) expected)
                        "reload reads the complete sidecar despite a damaged retired segment")
           (conversation-append-user-message loaded "new input")
           (conversation-append-summary loaded (make-continuation :intent "another checkpoint"))
           (test-assert
            (equal (conversation-input-history (conversation-load identity))
                   (append expected '("new input")))
            "append and rotation maintain the complete index without archived reads"))))))
  nil)

(-> test-conversation-input-history-rebuild () null)
(defun test-conversation-input-history-rebuild ()
  "Test a missing sidecar is built once, then appended rather than rewritten."
  (with-test-configuration (configuration)
    (let* ((conversation   (conversation-create configuration))
           (identity       (conversation-pathname conversation))
           (sidecar        (conversation-input-history-pathname identity))
           (original-map   (symbol-function 'conversation--map-storage-records))
           (original-write (symbol-function 'log-write-streaming))
           (scans          0)
           (publications   0))
      (conversation-append-user-message conversation "retired")
      (conversation-append-summary conversation (make-continuation :intent "checkpoint"))
      (conversation-append-user-message conversation "active")
      (delete-file sidecar)
      (test-call-with-function-replacements
       (list
        (list 'conversation--map-storage-records
              (lambda (&rest arguments)
                (incf scans)
                (apply original-map arguments)))
        (list 'log-write-streaming
              (lambda (pathname &rest arguments)
                (when (equal pathname sidecar) (incf publications))
                (apply original-write pathname arguments))))
       (lambda ()
         (let ((loaded (conversation-load identity)))
           (test-assert (equal (conversation-input-history loaded) '("retired" "active"))
                        "missing history rebuilds from archived and active inputs")
           (conversation-input-history loaded)
           (conversation-append-user-message loaded "next")
           (conversation-append-summary loaded (make-continuation :intent "checkpoint"))
           (test-assert
            (equal (conversation-input-history (conversation-load identity))
                   '("retired" "active" "next"))
            "the rebuilt sidecar supports later appends and reloads"))))
      (test-assert (and (= scans 1) (= publications 1))
                   "only the initial rebuild scans storage and publishes a complete file")))
  nil)

(-> test-conversation-input-history-streaming () null)
(defun test-conversation-input-history-streaming ()
  "Test recall, search and rebuild stream the sidecar instead of holding every input."
  (with-test-configuration (configuration)
    (let* ((conversation (conversation-create configuration))
           (identity     (conversation-pathname conversation))
           (sidecar      (conversation-input-history-pathname identity))
           (inputs       (loop for index below 40
                               collect (format nil "(progn ~D ~A)" index
                                               (make-string (+ 2048 (* 137 (mod index 11)))
                                                            :initial-element #\x)))))
      (dolist (input inputs)
        (conversation-append-user-message conversation input))
      (conversation-append-user-message conversation (first inputs))
      (conversation-append-user-message conversation (first inputs))
      (flet ((refuse (description original)
               (lambda (pathname &rest arguments)
                 (if (equal pathname sidecar)
                     (error "~A must stream instead of materializing." description)
                     (apply original pathname arguments)))))
        (test-call-with-function-replacements
         (list (list 'log-read (refuse "Input recall" #'log-read))
               (list 'log-write (refuse "Input rebuild" #'log-write)))
         (lambda ()
           (multiple-value-bind (page total)
               (conversation-input-history-page conversation :limit 3)
             (test-assert (and (= total 41)
                               (equal page (list (nth 38 inputs) (nth 39 inputs) (first inputs))))
                          "the newest page counts consecutive repeats once and reports its absolute end"))
           (test-assert (equal (conversation-input-history-page conversation :start 5 :limit 3)
                               (subseq inputs 5 8))
                        "oldest-based pages preserve input order")
           (test-assert (equal (conversation-input-history-page conversation :skip 39 :limit 5)
                               (list (first inputs) (second inputs)))
                        "an older page ends just before the inputs already recalled")
           (test-assert (null (conversation-input-history-page conversation :skip 41 :limit 5))
                        "no page remains past the oldest input")
           (let ((visited 0))
             (test-assert (block found
                            (conversation-map-input-history
                             conversation
                             (lambda (input)
                               (incf visited)
                               (when (search "(progn 1 " input)
                                 (return-from found t))))
                            nil)
                          "a search finds an old input")
             (test-assert (= visited 2) "a search stops at its first match"))
           (delete-file sidecar)
           (let ((loaded (conversation-load identity)))
             (test-assert (equal (conversation-input-history-page loaded :limit 2)
                                 (list (nth 39 inputs) (first inputs)))
                          "a missing sidecar rebuilds by streaming durable records")
             (test-assert (= 42 (length (conversation-input-history loaded)))
                          "complete recall stays available"))))
        (test-assert (not (slot-exists-p conversation 'input-history))
                     "a conversation keeps no resident copy of its inputs")
        (let ((loaded                       (conversation-load identity))
              (expected                     (append inputs (list (first inputs))))
              (*terminal-history-page-size* 7))
          (dolist (budgets '((4 nil) (7 10000) (3 3000)))
            (let* ((editor (clinedi:make-line-editor
                            :history-limit           (first budgets)
                            :history-character-limit (second budgets)))
                   (ui     (terminal-ui-create
                            :terminal (make-instance 'recording-terminal :columns 40)
                            :editor   editor)))
              (labels ((check-window ()
                         (let* ((resident   (clinedi:line-editor-history editor))
                                (characters (reduce #'+ resident :key #'length)))
                           (test-assert (<= (length resident) (first budgets))
                                        "the application recall window obeys its count budget")
                           (when (second budgets)
                             (test-assert (or (<= characters (second budgets))
                                              (= (length resident) 1))
                                          "the character budget keeps only one oversized input")))))
                (test-call-with-function-replacements
                 (list (list 'log-read (refuse "Application paging" #'log-read)))
                 (lambda ()
                   (application--load-conversation-input-history ui loaded)
                   (check-window)
                   (test-assert
                    (= (clinedi:line-editor-history-offset editor)
                       (- (length expected) (length (clinedi:line-editor-history editor))))
                    "initial character trimming advances the absolute start")
                   (clinedi:line-editor-set-text editor "draft" :cursor 2)
                   (dolist (input (reverse expected))
                     (terminal-ui-process-event ui ':history-previous)
                     (test-assert (string= input (clinedi:line-editor-text editor))
                                  "application paging recalls every older input exactly once")
                     (check-window))
                   (let ((appended (format nil "appended ~D ~A" (first budgets) (second budgets))))
                     (conversation-append-user-message loaded appended)
                     (conversation-append-user-message loaded appended)
                     (setf expected (append expected (list appended))))
                   (dolist (input (rest expected))
                     (terminal-ui-process-event ui ':history-next)
                     (test-assert (string= input (clinedi:line-editor-text editor))
                                  "absolute forward paging survives evictions and sidecar appends")
                     (check-window))
                   (terminal-ui-process-event ui ':history-next)
                   (test-assert (and (string= "draft" (clinedi:line-editor-text editor))
                                     (= 2 (clinedi:line-editor-cursor editor)))
                                "forward traversal restores the draft and cursor")
                   (loop repeat (length expected)
                         do (terminal-ui-process-event ui ':history-previous))
                   (clinedi:line-editor-set-text editor "edited")
                   (check-window)
                   (terminal-ui-process-event ui ':history-previous)
                   (test-assert (string= (first (last expected))
                                         (clinedi:line-editor-text editor))
                                "leaving traversal restores the newest history window"))))))))))
  nil)

(-> test-conversation-input-history-append-failures () null)
(defun test-conversation-input-history-append-failures ()
  "Test failures before and after sidecar writes preserve durable inputs exactly once."
  (dolist (write-first-p '(nil t))
    (with-test-configuration (configuration)
      (let* ((conversation (conversation-create configuration))
             (identity     (conversation-pathname conversation))
             (sidecar      (conversation-input-history-pathname identity))
             (original     (symbol-function 'log-append)))
        (conversation-append-user-message conversation "first")
        (test-call-with-function-replacements
         (list (list 'log-append
                     (lambda (pathname &rest arguments)
                       (if (equal pathname sidecar)
                           (progn
                             (when write-first-p (apply original pathname arguments))
                             (error "Injected sidecar append failure."))
                           (apply original pathname arguments)))))
         (lambda () (conversation-append-user-message conversation "second")))
        (test-assert
         (equal (conversation-input-history (conversation-load identity)) '("first" "second"))
         "a durable input survives a failed sidecar append exactly once")
        (test-assert (equal (conversation-input-history conversation) '("first" "second"))
                     "the original heap also repairs without duplication")
        (test-assert (= (length (rest (log-read sidecar))) 2)
                     "repair leaves one sidecar entry per durable input"))))
  nil)

(-> test-conversation-input-history-rotation-failure () null)
(defun test-conversation-input-history-rotation-failure ()
  "Retain authoritative inputs across rotation when sidecar appends fail."
  (with-test-configuration (configuration)
    (let* ((conversation (conversation-create configuration))
           (identity     (conversation-pathname conversation))
           (sidecar      (conversation-input-history-pathname identity))
           (original     (symbol-function 'log-append)))
      (conversation-append-user-message conversation "first")
      (let ((active (conversation-log-pathname conversation)))
        (test-call-with-function-replacements
         (list (list 'log-append
                     (lambda (pathname &rest arguments)
                       (if (equal pathname sidecar)
                           (error "Injected sidecar append failure.")
                           (apply original pathname arguments)))))
         (lambda ()
           (conversation-append-user-message conversation "second")
           (conversation-append-summary conversation (make-continuation :intent "checkpoint"))
           (test-assert
            (and (not (equal (conversation-log-pathname conversation) active))
                 (= (length (conversation-storage-pathnames identity)) 2)
                 (probe-file active))
            "rotation preserves the retired source even when its input cache cannot be flushed")))
        (test-assert
         (equal (conversation-input-history (conversation-load identity)) '("first" "second"))
         "history reconstructs both inputs from complete authoritative storage"))))
  nil)

(-> test-conversation-input-history-recovery () null)
(defun test-conversation-input-history-recovery ()
  "Test torn tails, invalid indices and stale checkpoints repair from authoritative inputs."
  (with-test-configuration (configuration)
    (let* ((conversation (conversation-create configuration))
           (identity     (conversation-pathname conversation))
           (sidecar      (conversation-input-history-pathname identity)))
      (conversation-append-user-message conversation "retired")
      (conversation-append-summary conversation (make-continuation :intent "checkpoint"))
      (conversation-append-user-message conversation "active")
      (let ((forms (log-read sidecar)))
        (sexp-store:log-write sidecar (butlast forms))
        (with-open-file (stream sidecar :direction ':output :if-exists ':append)
          (write-string "(:input" stream))
        (test-assert
         (equal (conversation-input-history (conversation-load identity)) '("retired" "active"))
         "a torn input entry repairs its tail and catches up from the active segment")
        (multiple-value-bind (repaired incomplete-p) (log-read sidecar)
          (test-assert (and (not incomplete-p) (= (length repaired) 3))
                       "tail repair publishes two complete inputs"))
        (dolist (invalid (list (list (first forms) '(:input :seq 0 :source "invalid"))
                              (list (first forms))))
          (sexp-store:log-write sidecar invalid)
          (test-assert
           (equal (conversation-input-history (conversation-load identity)) '("retired" "active"))
           "invalid or checkpoint-stale indices rebuild the complete history")))
      (conversation-delete configuration (conversation-identifier conversation))
      (test-assert (not (probe-file sidecar))
                   "deleting the conversation removes its owned input history")))
  nil)

(-> test-conversation-input-history-interruption () null)
(defun test-conversation-input-history-interruption ()
  "Test nonlocal exits during publication and catch-up invalidate incomplete heap state."
  (dolist (operation '(:append :repair))
    (with-test-configuration (configuration)
      (let* ((conversation (conversation-create configuration))
             (identity     (conversation-pathname conversation))
             (sidecar      (conversation-input-history-pathname identity))
             (original     (symbol-function 'log-append)))
        (conversation-append-user-message conversation "first")
        (when (eq operation ':repair)
          (test-call-with-function-replacements
           (list (list 'log-append
                       (lambda (pathname &rest arguments)
                         (if (equal pathname sidecar)
                             (error "Injected sidecar append failure.")
                             (apply original pathname arguments)))))
           (lambda ()
             (conversation-append-user-message conversation "second")
             (conversation-append-user-message conversation "third"))))
        (test-assert
         (eq (catch 'history-interrupted
               (test-call-with-function-replacements
                (list (list 'log-append
                            (lambda (pathname &rest arguments)
                              (apply original pathname arguments)
                              (when (equal pathname sidecar)
                                (throw 'history-interrupted ':interrupted)))))
                (lambda ()
                  (ecase operation
                    (:append
                     (conversation-append-user-message conversation "second"))
                    (:repair
                     (conversation-input-history conversation))))))
             ':interrupted)
         "a nonlocal exit interrupts sidecar publication after its durable write")
        (test-call-with-function-replacements
         (list (list 'conversation--map-storage-records
                     (lambda (&rest arguments)
                       (declare (ignore arguments))
                       (error "Interrupted history must repair without rebuilding."))))
         (lambda ()
           (conversation-append-user-message conversation "next")
           (let ((expected (if (eq operation ':append)
                               '("first" "second" "next")
                               '("first" "second" "third" "next"))))
             (test-assert (equal (conversation-input-history conversation) expected)
                          "later submission repairs every pending input exactly once")
             (test-assert
              (equal (conversation-input-history (conversation-load identity)) expected)
              "repaired history reloads without scanning retired records")))))))
  nil)

(-> test-conversation-input-history-page-load () null)
(defun test-conversation-input-history-page-load ()
  "Bound cold page decoding across store sizes and defer cache recovery explicitly."
  (dolist (count '(200 2000))
    (with-test-configuration (configuration)
      (let* ((conversation (conversation-create configuration))
             (identity     (conversation-pathname conversation))
             (sidecar      (conversation-input-history-pathname identity))
             (inputs       (loop for index below count collect (format nil "input ~6,'0D" index)))
             (map          (symbol-function 'log-map)))
        (loop for input in inputs for index from 1
              do (conversation-append-user-message conversation input)
                 (conversation-append-user-message conversation input)
                 (when (zerop (mod index 100))
                   (conversation-append-record conversation
                                               (list :message :role ':assistant :content (make-string 10000 :initial-element #\x)))
                   (conversation-append-summary conversation (make-continuation :intent "checkpoint"))))
        (conversation-append-user-message conversation "recent")
        (setf inputs (append inputs '("recent")))
        (let* ((loaded (conversation-load identity))
               (cases  (list (list '(:limit 3) (- (length inputs) 3) (length inputs))
                             (list '(:start 62 :limit 5) 62 67)
                             (list '(:skip 3 :limit 2) (- (length inputs) 5) (- (length inputs) 3))
                             (list '(:limit 0) 0 0)
                             (list (list :start (+ count 10) :limit 3) 0 0))))
          (dolist (case cases)
            (let ((records 0)
                  (bytes   0))
              (test-call-with-function-replacements
               (list (list 'log-map
                           (lambda (function pathname &rest options)
                             (if (equal pathname sidecar)
                                 (apply map (lambda (record start end)
                                              (incf records)
                                              (incf bytes (- end start))
                                              (funcall function record))
                                        pathname :with-positions-p t options)
                                 (apply map function pathname options))))
                     (list 'conversation--map-storage-records
                           (lambda (&rest arguments)
                             (declare (ignore arguments))
                             (error "Indexed pages must not traverse archives."))))
               (lambda ()
                 (multiple-value-bind (page total complete-p)
                     (apply #'conversation-input-history-page loaded (first case))
                   (test-assert (and complete-p (= total (length inputs))
                                     (equal page (subseq inputs (second case) (third case))))
                                "indexed pages preserve duplicates, absolute indices and both page directions"))))
              (test-assert (and (= records (+ 2 (- (third case) (second case)))) (< bytes 2048))
                           "header, tail and requested records are the only decoded input-log bytes")
              (format t "~&~D inputs: page decoded ~D records / ~D bytes.~%" count records bytes))))
        (let ((forms (log-read sidecar)))
          (dolist (damage '(:missing :torn :invalid :stale :unreadable))
            (sexp-store:log-write sidecar
                                  (if (eq damage ':stale) (subseq forms 0 2) forms))
            (case damage
              (:missing
               (delete-file sidecar))
              (:torn
               (with-open-file (stream sidecar :direction ':output :if-exists ':append) (write-string "(" stream)))
              (:invalid
               (sexp-store:log-write sidecar '((:invalid)))))
            (let ((loaded (conversation-load identity)))
              (test-call-with-function-replacements
               (append (list (list 'conversation--map-storage-records
                                   (lambda (&rest arguments)
                                     (declare (ignore arguments))
                                     (error "Readiness must defer archival recovery."))))
                       (when (eq damage ':unreadable)
                         (list (list 'log-map
                                     (lambda (function pathname &rest options)
                                       (if (equal pathname sidecar)
                                           (error "Unreadable input cache.")
                                           (apply map function pathname options)))))))
               (lambda ()
                 (multiple-value-bind (page total complete-p)
                     (conversation-input-history-page loaded :limit 3)
                   (test-assert (and (not complete-p) (= total 1) (equal page '("recent"))
                                     (conversation-input-history-repair-pending-p loaded))
                                "a damaged cache exposes the active local window and defers complete indices"))))
              (let ((checks 0))
                (test-assert
                 (catch 'cancelled
                   (conversation-maintenance-run loaded :check-function
                                                 (lambda () (when (= (incf checks) 4) (throw 'cancelled t))))
                   nil)
                 "repair observes managed cancellation before publishing a partial index"))
              (test-assert (not (conversation-maintenance-running-p loaded)) "cancelled repair releases its runtime reservation")
              (conversation-maintenance-run loaded)
              (multiple-value-bind (page total complete-p)
                  (conversation-input-history-page loaded :start 62 :limit 5)
                (test-assert (and complete-p (= total (length inputs)) (equal page (subseq inputs 62 67)))
                             "completed maintenance restores the complete seekable history"))))))))
  nil)

(-> test-conversation-maintenance-concurrent-input () null)
(defun test-conversation-maintenance-concurrent-input ()
  "Accept input while archival repair is paused and retry stale publication."
  (with-test-configuration (configuration)
    (let* ((conversation (conversation-create configuration))
           (map          (symbol-function 'conversation--map-storage-records))
           (entered      (sb-thread:make-semaphore))
           (release      (sb-thread:make-semaphore))
           (appended     (sb-thread:make-semaphore))
           (first-p      t)
           (failure      nil)
           (repair       nil)
           (writer       nil))
      (conversation-append-user-message conversation "old")
      (conversation-append-summary conversation (make-continuation :intent "checkpoint"))
      (delete-file (conversation-input-history-pathname (conversation-pathname conversation)))
      (conversation-input-history-page conversation :limit 3)
      (test-call-with-function-replacements
       (list (list 'conversation--map-storage-records
                   (lambda (pathname function)
                     (funcall map pathname
                              (lambda (record)
                                (when first-p
                                  (setf first-p nil)
                                  (sb-thread:signal-semaphore entered)
                                  (unless (sb-thread:wait-on-semaphore release :timeout 20)
                                    (error "Repair barrier timed out.")))
                                (funcall function record))))))
       (lambda ()
         (unwind-protect
              (progn
                (setf repair (make-thread (lambda ()
                                            (handler-case (conversation-maintenance-run conversation)
                                              (error (condition) (setf failure condition))))))
                (test-assert (sb-thread:wait-on-semaphore entered :timeout 10) "repair entered archival traversal")
                (setf writer (make-thread (lambda ()
                                            (conversation-append-user-message conversation "concurrent")
                                            (sb-thread:signal-semaphore appended))))
                (test-assert (sb-thread:wait-on-semaphore appended :timeout 10)
                             "input persistence does not wait for the archival scan"))
           (sb-thread:signal-semaphore release)
           (when writer (join-thread writer))
           (when repair (join-thread repair)))))
      (test-assert (null failure) "optimistic repair completes after concurrent input")
      (multiple-value-bind (page total complete-p) (conversation-input-history-page conversation :limit 3)
        (test-assert (and complete-p (= total 2) (equal page '("old" "concurrent")))
                     "stale repair retries without losing the input accepted during traversal"))))
  nil)
