(in-package #:autolith)

;;;; -- Channel Presentation Tests --

(-> presentation-tests--model () (values channel-presentation function))
(defun presentation-tests--model ()
  "Return a presentation and a function returning the events it published, oldest first."
  (let ((ui     (channel-presentation-create :rows 30 :columns 80))
        (events nil))
    (setf (channel-presentation-publish-function ui)
          (lambda (event)
            (push event events)))
    (values ui (lambda () (reverse events)))))

(-> presentation-tests--operations (list) list)
(defun presentation-tests--operations (events)
  "Return the operations of presentation EVENTS in order."
  (mapcar (lambda (event) (getf (rest event) :operation)) events))

(-> test-presentation-idle-completion-refresh () null)
(defun test-presentation-idle-completion-refresh ()
  "Poll an application catalog without repeated builds, normalization or status paints."
  (with-test-configuration (configuration)
    (multiple-value-bind (ui events) (presentation-tests--model)
      (let ((publisher (channel-presentation-publish-function ui)))
        (let* ((registry       (make-default-tool-registry))
               (application    (make-instance 'application :configuration configuration
                                              :tool-registry registry :ui ui
                                              :conversation               (conversation-create configuration)))
               (build          #'application-operation-completion-entries)
               (normalize      #'channel-presentation--completion-entries)
               (builds         0)
               (normalizations 0))
          ;; Application initialization installs the real client publisher.
          (setf (channel-presentation-publish-function ui) publisher)
          (test-call-with-function-replacements
           (list (list 'application-operation-completion-entries
                       (lambda (owner) (incf builds) (funcall build owner)))
                 (list 'channel-presentation--completion-entries
                       (lambda (snapshot) (incf normalizations) (funcall normalize snapshot))))
           (lambda ()
             (terminal-ui-refresh-status ui)
             (let ((before (funcall events)))
               (test-assert (notany (lambda (poll) (declare (ignore poll))
                                      (terminal-ui-refresh-status ui))
                                    '(1 2 3 4 5))
                            "settled hosted polls do not paint")
               (test-assert (and (= builds 1) (= normalizations 1) (equal before (funcall events)))
                            "settled polls do not rebuild, normalize, or publish")
               (setf (slot-value application 'tool-registry) (make-instance 'tool-registry))
               (terminal-ui-refresh-status ui)
               (test-assert (and (= builds 2) (= normalizations 2))
                            "registry replacement refreshes without a status repaint")
               (flet ((catalog-events (batch)
                        (remove-if-not (lambda (event) (eq (getf (rest event) :operation) ':completions))
                                       batch)))
                 (let ((replay    (catalog-events (with-terminal-ui-locked (ui)
                                                   (channel-presentation-replay ui))))
                       (published (catalog-events (nthcdr (length before) (funcall events)))))
                   (test-assert (and published
                                     (getf (rest (first replay)) :reset-p)
                                     (getf (rest (first (last replay))) :complete-p)
                                     (equal replay published))
                                "a returning client receives the full current catalog"))))))))))
  nil)

(-> test-presentation-idle-completion-retry () null)
(defun test-presentation-idle-completion-retry ()
  "Retry cold and warm snapshots and do not acknowledge partial publication."
  (with-test-configuration (configuration)
    (multiple-value-bind (ui events) (presentation-tests--model)
      (let* ((publisher   (channel-presentation-publish-function ui))
             (application (make-instance 'application :configuration configuration :ui ui
                                         :tool-registry (make-default-tool-registry)
                                         :conversation  (conversation-create configuration)))
             (failure     (make-condition 'simple-error :format-control "Incomplete catalog send"))
             (fail-p      t))
        (setf (channel-presentation-publish-function ui) publisher)
        (dolist (warm-p '(nil t))
          (let* ((entered (sb-thread:make-semaphore))
                 (release (sb-thread:make-semaphore))
                 (before  (channel-presentation-published-completion-revision ui))
                 (worker
                   (make-thread
                    (lambda ()
                      (with-extension-registry-transaction
                        (when warm-p
                          (setf (slot-value application 'tool-registry) (make-instance 'tool-registry)))
                        (sb-thread:signal-semaphore entered)
                        (sb-thread:wait-on-semaphore release :timeout 5))))))
            (unwind-protect
                 (progn
                   (test-assert (sb-thread:wait-on-semaphore entered :timeout 5) "registry lock acquired")
                   (let ((start (get-internal-real-time)))
                     (terminal-ui-refresh-status ui)
                     (test-assert (< (- (get-internal-real-time) start) (* 4 internal-time-units-per-second))
                                  "poll does not wait for the extension lock"))
                   (test-assert (eq before (channel-presentation-published-completion-revision ui))
                                "lock contention retains the preceding revision"))
              (sb-thread:signal-semaphore release)
              (sb-thread:join-thread worker))
            (terminal-ui-refresh-status ui)
            (test-assert (and (channel-presentation-published-completion-revision ui)
                              (not (eq before (channel-presentation-published-completion-revision ui))))
                         "first idle retry acknowledges the newly available catalog")))
        (let ((revision (cons nil nil))
              (entries  (loop for index below 33
                              collect (list :name (format nil "probe-~D" index) :description "Probe")))
              (before   (length (funcall events))))
          (setf (terminal-ui-completion-function ui) (lambda () (values entries revision))
                (channel-presentation-publish-function ui)
                (lambda (event)
                  (when (and fail-p (eq (getf (rest event) :operation) ':completions)
                             (getf (rest event) :complete-p))
                    (error failure))
                  (funcall publisher event)))
          (test-assert (handler-case (progn (terminal-ui-refresh-status ui) nil)
                         (simple-error (condition) (eq condition failure)))
                       "the injected failure interrupts the final chunk")
          (let ((partial (nthcdr before (funcall events))))
            (test-assert (and (= (length partial) 1)
                              (getf (rest (first partial)) :reset-p)
                              (not (getf (rest (first partial)) :complete-p))
                              (not (eq revision (channel-presentation-published-completion-revision ui))))
                         "the client got only the first chunk and the revision was not acknowledged"))
          (setf fail-p nil)
          (terminal-ui-refresh-status ui)
          (let* ((retry (nthcdr (1+ before) (funcall events)))
                 (names (loop for event in retry
                              append (mapcar (lambda (entry) (getf entry :name))
                                             (getf (rest event) :entries)))))
            (test-assert (and (eq revision (channel-presentation-published-completion-revision ui))
                              (= (length retry) 2)
                              (getf (rest (first retry)) :reset-p)
                              (getf (rest (second retry)) :complete-p)
                              (equal names (mapcar (lambda (entry) (getf entry :name)) entries)))
                         "retry sends a fresh reset followed by the complete catalog"))))))
  nil)

(-> test-presentation-idle-status-phases () null)
(defun test-presentation-idle-status-phases ()
  "Acknowledge each hosted phase while allowing animation and notice expiry."
  (let ((ui    (channel-presentation-create))
        (clock 0))
    (setf (slot-value ui 'clock-function) (lambda () clock))
    (terminal-ui-set-status ui "working")
    (test-assert (not (terminal-ui-refresh-status ui)) "setting status acknowledges its initial phase")
    (setf clock 2)
    (test-assert (terminal-ui-refresh-status ui) "advancing the clock repaints")
    (test-assert (not (terminal-ui-refresh-status ui)) "unchanged phase skips another paint")
    (terminal-ui-set-notice ui "temporary" :duration-seconds 1)
    (setf clock 4)
    (test-assert (and (terminal-ui-refresh-status ui) (null (terminal-ui-notice ui)))
                 "polling expires the notice")
    (terminal-ui-set-status ui nil)
    (test-assert (not (terminal-ui-refresh-status ui)) "cleared status settles"))
  nil)

(-> presentation-tests--source-inputs () null)
(defun presentation-tests--source-inputs ()
  "Exercise bounded source packets, local lazy expansion and version fallback."
  (with-test-configuration (configuration)
    (dolist (count '(1 12 5000 10000))
      (let* ((ui             (channel-presentation-create :rows 24 :columns 80))
             (application    (make-instance 'application :configuration configuration
                                            :tool-registry              (make-default-tool-registry)
                                            :conversation (conversation-create configuration) :ui ui))
             (forms          (make-array count :initial-element "(list :x 1)"))
             (record         nil)
             (expanded-calls 0)
             (render-calls   0)
             (render         #'render-source))
        (when (= count 12)
          (setf (aref forms 0) (format nil "(let ((value 1))~%  (list :value value))")
                (aref forms 11) "(list :late-source #.(error \"source was evaluated\"))"))
        (setf record
              (application--record-presentation
               application
               (list :provider-item :seq 1 :wire-json
                     (json-encode
                      (agent-test-call :call-id "source-wire" :namespace "lisp" :name "eval"
                                       :arguments (json-encode
                                                   (json-object "forms" forms "repl" "source-wire"
                                                                "compile" t "restart-value" "(+ 40 2)")))))))
        (let ((expand (getf (third record) :expanded-entry-layout)))
          (setf (getf (third record) :expanded-entry-layout)
                (lambda (columns) (incf expanded-calls) (funcall expand columns))))
        (test-call-with-function-replacements
         (list (list 'render-source
                     (lambda (&rest arguments) (incf render-calls) (apply render arguments))))
         (lambda ()
             (let* ((wire        (application-client-value (presentation-record->wire record 80)))
                    (packet      (image-daemon:daemon-packet-string (list :ui :operation :records :presentations (list wire))))
                    (back        (presentation-wire->record wire))
                    (description (getf (third wire) :source-input)))
              (test-assert (and (zerop expanded-calls) (zerop render-calls))
                           "serialization and reconstruction never invoke the expanded layout or source renderer")
              (test-assert (and (presentation--source-input-p description)
                                (null (getf (third wire) :expanded-entry))
                                (<= (length (getf description :actions)) 2)
                                (< (length packet) (+ 16384 (* 4 (reduce #'+ forms :key #'length)))))
                           "raw source and shared actions fit a packet proportional to input, including 110k source")
              (test-assert (and (equal (first back) (first record))
                                (equal (getf (third back) :call-key) (getf (third record) :call-key))
                                (equal (presentation-entry->wire (second back))
                                       (presentation-entry->wire (second record))))
                           "identity and every collapsed header/input click survive the shared action table")
              (let ((invocation (getf (getf (third back) :source-input) :invocation)))
                (test-assert
                 (and (non-empty-string-p invocation) (search "lisp.eval" invocation)
                      (find (list ':insert invocation) (second back) :test #'equal
                            :key                                           (lambda (span) (when (termdown:widget-p span) (termdown:widget-action span)))))
                 "durable source publication retains the bound local invocation as a header insertion action"))
              (dolist (version '(2 :unknown))
                (let ((future (copy-tree wire)))
                  (setf (getf (getf (third future) :source-input) :version) version)
                  (let ((fallback (presentation-wire->record future)))
                    (test-assert (and (equal (first fallback) (first record))
                                      (equal (terminal--spans-text (second fallback))
                                             (terminal--spans-text (second record)))
                                      (null (getf (third fallback) :expanded-entry-layout)))
                                 "an unsupported recipe preserves the collapsed representation without interpreting it"))))
              (when (= count 12)
                (let* ((key       (getf (third back) :call-key))
                       (terminal  (make-instance 'recording-terminal :columns 80 :rows 24))
                       (client-ui (fullscreen-test--ui terminal)))
                  (with-terminal-ui (active client-ui)
                    (terminal-ui-present-records active (list back))
                    (test-assert (not (search ":late-source" (clinedi:transcript-viewport-chunk-text
                                                               (fullscreen-terminal-ui-viewport active) 0)))
                                 "the initial resident input is collapsed")
                    (with-terminal-ui-locked (active)
                      (test-assert (terminal-ui-fullscreen--toggle-tool-input active key)
                                   "the collapsed input action expands the local resident record"))
                    (test-assert (search ":late-source" (clinedi:transcript-viewport-chunk-text
                                                         (fullscreen-terminal-ui-viewport active) 0))
                                 "local expansion displays the complete source without reader evaluation")
                    (dolist (columns '(32 80 120))
                      (test-assert
                       (equal (presentation-entry->wire (funcall (getf (third record) :expanded-entry-layout) columns))
                              (presentation-entry->wire (funcall (getf (third back) :expanded-entry-layout) columns)))
                       "native and remote expanded input agree at each local width, with arguments and multiline source"))
                    (with-terminal-ui-locked (active)
                      (test-assert (terminal-ui-fullscreen--toggle-tool-input active key)
                                   "the expanded input action collapses locally")))))))))))
  nil)

(-> presentation-tests--tool-entry-reflow () null)
(defun presentation-tests--tool-entry-reflow ()
  "Recover ordinary call content on widening and retain over-budget legacy entries."
  (with-test-configuration (configuration)
    (dolist (case '(45 20000 :header))
      (let* ((marker      "VISIBLE-SUFFIX")
             (header-p    (eq case ':header))
             (expected-p  (not (eql case 20000)))
             (command     (unless header-p
                            (format nil "printf '%s' '~A~A'" (make-string case :initial-element #\a) marker)))
             (producer    (channel-presentation-create :rows 24 :columns 24))
             (application (make-instance 'application :configuration configuration
                                         :tool-registry              (make-default-tool-registry)
                                         :conversation (conversation-create configuration) :ui producer))
             (record      (application--record-presentation
                           application
                           (list :provider-item :seq 1 :wire-json
                                 (json-encode
                                  (agent-test-call
                                   :call-id "ordinary-reflow" :namespace (if header-p "example" "shell")
                                   :name      (if header-p (format nil "command-~A~A" (make-string 45 :initial-element #\a) marker) "run")
                                   :arguments (json-encode (if header-p (json-object) (json-object "command" command))))))))
             (direct      (funcall (getf (third record) :entry-layout) 120))
             (wire        (application-client-value (presentation-record->wire record 24)))
             (back        (presentation-wire->record wire))
             (ui          (fullscreen-test--ui (make-instance 'recording-terminal :columns 24 :rows 24))))
        (test-assert (and (null (getf (third record) :source-input))
                          (null (getf (third wire) :expanded-entry))
                          (null (getf (third back) :expanded-entry-layout)))
                     "ordinary calls acquire no eager or local expanded source layout")
        (test-assert (equal (presentation-entry->wire (presentation-wire->entry (second wire)))
                            (presentation-entry->wire (second record)))
                     "a reader ignoring the new recipe can display and click the original short entry")
        (if expected-p
            (progn
              (test-assert (and (getf (third wire) :tool-entry)
                                (getf (third back) :entry-layout) (search marker (terminal--spans-text direct)))
                           "bounded headers and source rows retain their pre-clipping suffix")
              (let ((future (copy-tree wire)))
                (setf (getf (getf (third future) :tool-entry) :version) 2)
                (let ((fallback (presentation-wire->record future)))
                  (test-assert (and (null (getf (third fallback) :entry-layout))
                                    (equal (presentation-entry->wire (second fallback)) (second wire)))
                               "an unsupported ordinary recipe preserves legacy text and actions"))))
            (test-assert (and (null (getf (third record) :tool-entry))
                              (null (getf (third wire) :tool-entry))
                              (null (getf (third back) :entry-layout))
                              (equal (presentation-entry->wire (second back)) (second wire)))
                         "over-budget call data declines the recipe without losing the record or actions"))
        (with-terminal-ui (active ui)
          (terminal-ui-present-records active (list back))
          (let ((viewport (fullscreen-terminal-ui-viewport active)))
            (test-assert (not (search marker (clinedi:transcript-viewport-chunk-text viewport 0)))
                         "the suffix is initially outside the narrow clipped entry")
            (terminal-ui-resize active 120 :rows 24)
            (test-assert (eq expected-p (not (null (search marker (clinedi:transcript-viewport-chunk-text viewport 0)))))
                         "24-to-120 resize restores bounded ordinary content and uses the legacy over-budget fallback"))))))
  nil)

(-> test-presentation-wire-forms () null)
(defun test-presentation-wire-forms ()
  "Test styled text and records survive the wire, and what another version sent is tolerated."
  (let ((entry (list (terminal-span ':notice "· note ")
                     (termdown:make-widget ':code "(memory \"a\")" '(:insert "(memory \"a\")")))))
      (let ((back (presentation-wire->entry (application-client-value (presentation-entry->wire entry)))))
       (test-assert (and (equal (first back) (first entry))
                         (termdown:widget-p (second back))
                         (equal (termdown:widget-action (second back)) '(:insert "(memory \"a\")")))
                    "spans and widgets come back as they left"))
    (test-assert (equal (presentation-wire->entry '((:style-of-tomorrow "text") "stray" (:plain)))
                        (list (terminal-span ':plain "text")))
                 "an unknown style shows as plain text and what is no span is dropped")
    (test-assert (equal (presentation-wire->entry "plain") "plain")
                 "a string entry stays a string"))
  (let* ((expanded (list (terminal-span ':code "(expanded)")))
         (record   (list '(:conversation "c" 3)
                         (list (terminal-span ':tool "▸ shell.run"))
                         (list :group                 "shell.run"
                               :kind                  ':call
                               :call-key              '(:call "c" "1")
                               :entry-layout          (lambda (columns)
                                                        (list (terminal-span ':tool
                                                                             (format nil "▸ at ~D" columns))))
                               :expanded-entry-layout (constantly expanded)
                               :source-characters     (constantly 12)
                               :handoff               (list (terminal-span ':dim "handoff")))))
         (wire     (application-client-value (presentation-record->wire record 80)))
         (back     (presentation-wire->record wire)))
    (test-assert (and (equal (first back) '(:conversation "c" 3))
                      (equal (second back) (second record))
                      (eql (getf (third back) :source-characters) 12)
                      (equal (getf (third back) :handoff) (getf (third record) :handoff))
                      (null (getf (third back) :entry-layout))
                      (equal (funcall (getf (third back) :expanded-entry-layout) 40) expanded))
                 "a record's layouts travel as what they lay out, and its weight as a number")
    (test-assert (equal (second (presentation-wire->record
                                   (application-client-value
                                    (presentation-record->wire record 60 :lay-out-p t))))
                        (list (terminal-span ':tool "▸ at 60")))
                 "a record is laid out again for another width when asked")
    (test-assert (null (presentation-wire->record '(:not "a record")))
                 "what is no record is dropped"))
  (let ((schema (presentation-wire->record
                   (application-client-value
                    (presentation-record->wire
                     (list '(:conversation "c" 4) nil
                            (list :entry-kind ':tool-schemas :schema-names '("child" "job")
                                 :schema-layout (lambda (names columns)
                                                  (declare (ignore names columns))
                                                  nil)))
                     80)))))
    (test-assert (search "child, job"
                         (terminal--spans-text (funcall (getf (third schema) :entry-layout) 80)))
                 "the client lays tool schema names out itself"))
  (presentation-tests--source-inputs)
  (presentation-tests--tool-entry-reflow)
  nil)

(-> test-presentation-model-publishes () null)
(defun test-presentation-model-publishes ()
  "Test a presentation tells its clients each change once and replays what it shows."
  (multiple-value-bind (ui events) (presentation-tests--model)
    (terminal-ui-start ui)
    (test-assert (terminal-ui-append-finalized ui '(:presentation 1) "· first" :group nil)
                 "a new entry is appended")
    (test-assert (null (terminal-ui-append-finalized ui '(:presentation 1) "· first" :group nil))
                 "the same identifier is not appended twice")
    (test-assert (= 1 (terminal-ui-present-records
                       ui (list (list '(:conversation "c" 1)
                                      (list (terminal-span ':plain "hello"))
                                      (list :group nil))
                                (list '(:presentation 1) "· first" nil))))
                 "only the records not yet shown count")
    (terminal-ui-set-status ui "thinking" :details nil)
    (terminal-ui-set-status ui "thinking" :details nil)
    (terminal-ui-set-context-usage ui :used 10 :window 100 :compaction-limit 90)
    (terminal-ui-set-context-usage ui :used 10 :window 100 :compaction-limit 90)
    (terminal-ui-set-notice ui "copied" :duration-seconds 4)
    (let ((identifier (gensym "STREAM")))
      (terminal-ui-stream-markdown ui identifier :source "Hel")
      (terminal-ui-stream-markdown ui identifier :source "Hello" :finished-p t))
    (let* ((seen       (funcall events))
           (operations (presentation-tests--operations seen))
           (markdown   (remove ':markdown seen
                               :key      (lambda (event) (getf (rest event) :operation))
                               :test-not #'eq)))
      (test-assert (equal (remove-if-not (lambda (operation)
                                           (member operation '(:append :records :context :notice)))
                                         operations)
                          '(:append :records :context :notice))
                   "each change is published once, and an unchanged state not again")
      (test-assert (member ':status operations)
                   "an activity is told")
      (test-assert (and (equal (getf (rest (first markdown)) :source) "Hel")
                        (equal (getf (rest (second markdown)) :delta) "lo")
                        (getf (rest (second markdown)) :finished-p)
                        (equal (getf (rest (first markdown)) :identifier)
                               (getf (rest (second markdown)) :identifier)))
                   "a Markdown stream sends what was added under one portable identifier"))
    (let* ((replay     (channel-presentation-replay ui))
           (operations (presentation-tests--operations replay))
           (whole      (find ':markdown replay :key (lambda (event) (getf (rest event) :operation)))))
      (test-assert (and (eq (first operations) ':reset)
                        (equal (subseq operations 1 4) '(:append :records :markdown))
                        (equal (getf (rest whole) :source) "Hello")
                        (member ':status operations)
                        (member ':context operations)
                        (eq (first (last operations)) ':replayed))
                   "a replay clears, repeats the transcript with whole streams, tells every state and says it is done"))
    (terminal-ui-reset-transcript ui)
    (test-assert (and (equal (presentation-tests--operations (channel-presentation-replay ui))
                             (append '(:reset) *channel-presentation-state-operations* '(:replayed)))
                      (terminal-ui-append-finalized ui '(:presentation 1) "· first" :group nil))
                 "a reset forgets the transcript, so an entry can be shown again"))
  (multiple-value-bind (ui events) (presentation-tests--model)
    (declare (ignore events))
    (let ((*channel-presentation-log-character-limit* 40))
      (dotimes (index 6)
        (terminal-ui-present-records
         ui (list (list (list ':conversation "c" (1+ index))
                        (list (terminal-span ':plain (make-string 20 :initial-element #\x)))
                        (list :group nil))))))
    (test-assert (and (<= (deque-count (channel-presentation-transcript-log ui)) 2)
                      (eql (terminal-ui-take-evicted-sequence ui "c") 5)
                      (= 1 (terminal-ui-present-records
                            ui (list (list '(:conversation "c" 1) "again" (list :group nil))))))
                 "the log is bounded: what left it may be shown again, and history knows how far it went"))
  (multiple-value-bind (ui events) (presentation-tests--model)
    (declare (ignore events))
    (let ((*channel-presentation-log-character-limit* 300))
      (dotimes (index 100)
        (terminal-ui-mark-finalized ui (list ':marker index)))
      (test-assert (< (deque-count (channel-presentation-transcript-log ui)) 100)
                   "Textless finalized markers also consume replay capacity.")
      (terminal-ui-reset-transcript ui)
      (terminal-ui-append-finalized ui 1 "an older entry")
      (terminal-ui-stream-markdown ui ':block :source "a")
      (test-assert (= 2 (deque-count (channel-presentation-transcript-log ui)))
                   "Both entries fit before the streamed block grows.")
      (terminal-ui-stream-markdown ui ':block :source (make-string 350 :initial-element #\a) :finished-p t)
      (test-assert (equal '(:markdown)
                          (presentation-tests--operations
                           (mapcar #'first (deque->list (channel-presentation-transcript-log ui)))))
                   "Growing a streamed block evicts older replay entries without waiting for a new entry.")))
  nil)

(-> test-presentation-transport-batches () null)
(defun test-presentation-transport-batches ()
  "Exercise startup and resized replay across the native packet size boundary."
  (flet ((layout (columns)
           (loop repeat (if (<= columns 80) 15 100)
                 collect (terminal-span ':tool "styled"))))
    (dolist (columns '(80 418))
      (let* ((image-daemon:*daemon-packet-character-limit* 32768)
             (*channel-presentation-log-character-limit*   1)
             (ui                                           (channel-presentation-create :rows 127 :columns columns))
             (identifiers                                  (loop for index below 16 collect (list ':synthetic index)))
             (records
               (loop for identifier in identifiers
                     for entry = (layout columns)
                     for origin = (list (list ':origin identifier) entry
                                        (list :entry-kind ':tool-call :entry-layout #'layout))
                     collect (list identifier entry
                                   (list :entry-kind ':tool-result :entry-layout #'layout
                                         :origin (list (list ':outer identifier) entry
                                                       (list :entry-kind   ':tool-call
                                                             :entry-layout #'layout
                                                             :origin       origin))))))
             (delivered                                    nil))
        (labels ((transport (event)
                   "Append publication cursors and frame EVENT as a native packet."
                   (let ((packet (append event (list :sequence 1 :record-sequence (length records)))))
                     (image-daemon:daemon-packet-string packet)
                     packet))

                 (record-identifiers (events)
                   "Decode the ordered record identities from EVENTS."
                   (loop for event in events
                         when (eq (getf (rest event) :operation) ':records)
                           append (mapcar (lambda (wire)
                                            (first (presentation-wire->record wire)))
                                          (getf (rest event) :presentations))))

                 (replay ()
                   "Transport the initial attach prefix and verify its full record order."
                   (let ((events (mapcar #'transport (channel-presentation-replay ui))))
                     (test-assert (and (eq (getf (rest (first events)) :operation) ':reset)
                                       (eq (getf (rest (first (last events))) :operation) ':replayed)
                                       (equal identifiers (record-identifiers events))
                                       (equal (getf (channel-presentation--records-fields
                                                     ui records :lay-out-p t)
                                                    :presentations)
                                              (loop for event in events
                                                    when (eq (getf (rest event) :operation) ':records)
                                                      append (getf (rest event) :presentations))))
                                  "Attach replay transports every record in order before its terminator."))))
          (setf (channel-presentation-publish-function ui)
                (lambda (event) (push (transport event) delivered)))
          (let ((rejected-p nil))
            (handler-case
                (transport (list* :ui :operation ':records
                                  (channel-presentation--records-fields ui records)))
              (image-daemon:daemon-error (condition)
                (setf rejected-p (eq (image-daemon:daemon-error-operation condition) ':write-packet))))
            (test-assert (eq rejected-p (= columns 418))
                         "Only the unsplit wide transcript exceeds the configured packet budget."))
          (test-assert (= (length records) (terminal-ui-present-records ui records))
                       "Startup presents the whole transcript without exceeding the packet budget.")
          (test-assert (equal identifiers (record-identifiers (reverse delivered)))
                       "Live transport preserves every startup record in order.")
          (replay)
          ;; A formerly small replay cell can grow past the bound at a new width.
          (dolist (width '(418 80 418))
            (channel-presentation-set-geometry ui :rows 127 :columns width)
            (replay)
            (test-assert (= (channel-presentation-log-characters ui)
                            (loop for cell in (deque->list (channel-presentation-transcript-log ui))
                                  sum (second cell)))
                         "Resized replay partitions retain exact log accounting."))
          (test-assert (zerop (terminal-ui-present-records ui records))
                       "Resized replay retains finalized record identities.")
          (terminal-ui-append-finalized ui ':after "next publication")
          (test-assert (null (record-identifiers (channel-presentation-replay ui)))
                       "Budget eviction removes the whole earlier logical publication.")))))
  (multiple-value-bind (ui events) (presentation-tests--model)
    (let ((cycle (list ':cycle)))
      (setf (rest cycle) cycle)
      (dolist (case (list (list ':cycle "invalid group" (list :group cycle))
                         (list ':cycle
                               (loop repeat 40000 collect (terminal-span ':tool "x"))
                               (list :group cycle))
                         (list ':depth "invalid depth"
                               (list :group (loop with value = nil repeat 140
                                                  do (setf value (list value))
                                                  finally (return value))))))
        (destructuring-bind (reason entry metadata) case
          (let ((rejected-p nil))
            (handler-case
                (terminal-ui-present-records ui (list (list ':invalid entry metadata)))
              (portable-value-error (condition)
                (setf rejected-p (eq reason (portable-value-error-reason condition)))))
            (test-assert (and rejected-p
                              (not (terminal-ui--finalized-p ui ':invalid))
                              (zerop (deque-count (channel-presentation-transcript-log ui)))
                              (null (funcall events)))
                         "An invalid individual record is rejected before publishing or finalizing it."))))))
  (let ((image-daemon:*daemon-packet-character-limit* 32768))
    (dolist (entry (list (loop repeat 4000 collect (terminal-span ':tool "x"))
                         (make-string (1+ image-daemon:*daemon-packet-character-limit*)
                                      :initial-element #\x)))
      (let* ((ui     (channel-presentation-create :rows 127 :columns 418))
             (record (list '(:conversation "synthetic" 1) entry
                           (list :entry-kind ':tool-result :kind ':result :state ':done
                                 :call-key     '(:call "synthetic" "call")
                                 :entry-layout (lambda (columns)
                                                 (if (<= columns 80) "small rendering" entry)))))
             (notice nil))
       (labels ((wire-record ()
                  "Transport and read the retained singleton."
                  (let* ((events (mapcar (lambda (event)
                                          (image-daemon:daemon-packet-string event)
                                          event)
                                        (channel-presentation-replay ui)))
                         (event  (find ':records events
                                       :key (lambda (event) (getf (rest event) :operation)))))
                    (first (getf (rest event) :presentations)))))
         (test-assert (= 1 (terminal-ui-present-records ui (list record)))
                      "An oversized singleton does not prevent startup.")
         (setf notice (wire-record))
         (test-assert (and (equal (first record) (first notice))
                           (stringp (second notice)) (< (length (second notice)) 512)
                           (eq (getf (third notice) :kind) ':result)
                           (eq (getf (third notice) :state) ':done)
                           (equal (getf (third notice) :call-key) '(:call "synthetic" "call"))
                           (equal (getf (third notice) :body) (second notice))
                           (eq record (first (third (first (deque->list
                                                            (channel-presentation-transcript-log ui)))))))
                      "The bounded notice retains identity, outcome semantics and original source.")
         (channel-presentation-set-geometry ui :rows 127 :columns 80)
         (test-assert (equal (second (wire-record)) "small rendering")
                      "A narrower replay restores the complete rendering from the retained source.")
         (channel-presentation-set-geometry ui :rows 127 :columns 418)
         (test-assert (equal notice (wire-record))
                      "An oversized wider replay uses the same width-independent notice."))))
   (let* ((*channel-presentation-log-character-limit* most-positive-fixnum)
          (ui                                         (channel-presentation-create :rows 127 :columns 418))
          (text                                       (make-string (floor image-daemon:*daemon-packet-character-limit* 2)
                                                                   :initial-element #\x))
          (records                                    (list (list ':first text nil) (list ':second text nil))))
     (test-assert (= 2 (terminal-ui-present-records ui records))
                  "A packet-size-only overflow splits the publication without replacing its records.")
     (let ((wires nil))
       (dolist (event (channel-presentation-replay ui))
           (image-daemon:daemon-packet-string event)
         (when (eq (getf (rest event) :operation) ':records)
           (setf wires (append wires (getf (rest event) :presentations)))))
       (test-assert (and (= (length wires) 2)
                         (every (lambda (wire) (equal (second wire) text)) wires))
                    "Each full record survives packet-bounded replay without a notice."))))
  nil)

(-> presentation-tests--shown (terminal-ui string) (integer 0))
(defun presentation-tests--shown (ui text)
  "Return how many rows of UI's frame show TEXT."
  (count-if (lambda (row) (search text (clinedi:ansi-strip row)))
            (terminal-ui-fullscreen--frame ui nil)))

(-> test-presentation-applies () null)
(defun test-presentation-applies ()
  "Test a client's UI shows what a presentation's events describe, and ignores what it does not know."
  (let ((model (presentation-tests--model)))
    (with-terminal-ui (ui (fullscreen-test--ui (make-instance 'recording-terminal :columns 60 :rows 20)))
      (flet ((apply-all ()
                 (dolist (event (channel-presentation-replay model))
                  (apply #'presentation-apply ui (getf (rest event) :operation) (rest event)))))
        (terminal-ui-append-finalized model '(:presentation 1) "· shown to the client" :group nil)
        (terminal-ui-set-status model "thinking" :details nil)
        (terminal-ui-set-pending-inputs model '("steer") '("later"))
        (terminal-ui-stream-markdown model (gensym "STREAM") :source "Streamed **text**")
        (apply-all)
        (test-assert (and (equal (terminal-ui-status ui) "thinking")
                          (equal (terminal-ui-queued-input-previews ui) '("later"))
                          (equal (terminal-ui-steering-input-previews ui) '("steer")))
                     "state reaches the client's UI")
        (test-assert (and (= 1 (presentation-tests--shown ui "shown to the client"))
                          (= 1 (presentation-tests--shown ui "Streamed text")))
                     "transcript entries and rendered Markdown reach the client's screen")
        (test-assert (null (presentation-apply ui ':operation-of-tomorrow :field 1))
                     "an operation this version does not know is ignored")
        (test-assert (null (presentation-apply ui ':context :used "many" :window nil))
                     "fields of the wrong kind are ignored")
        (apply-all)
        (test-assert (= 1 (presentation-tests--shown ui "shown to the client"))
                     "a second replay clears first, so nothing shows twice"))))
  nil)

(-> presentation-tests--hosted-completion (application function function) null)
(defun presentation-tests--hosted-completion (application seen await)
  "Exercise a hosted catalog through real transport, a channel view and composer input."
  (let* ((server   (application-ui application))
         (provider (terminal-ui-completion-function server))
         (screen   (world-terminal-screen-create
                      :terminal (make-instance 'recording-terminal :rows 30 :columns 90 :interactive-p t)))
         (view     (channel-view-create (application-configuration application) "completion-test" screen)))
    (with-terminal-ui (ui (channel-view-ui view))
      (test-assert (funcall await ':completions
                            (lambda (event) (getf (rest event) :complete-p)))
                   "Initial hosted replay includes its authoritative completion catalog.")
      (dolist (event (funcall seen))
        (when (eq (getf (rest event) :operation) ':completions)
          (channel-subscription-present-event view event)))
      (terminal-ui-process-event ui '(:insert "(sta"))
      (test-assert (find "(status)" (terminal-ui--reconcile-completions ui)
                         :key (lambda (entry) (getf entry :name)) :test #'equal)
                   "A hosted parenthesized draft offers the native command.")
      (terminal-ui-process-event ui ':complete)
      (test-assert (uiop:string-prefix-p "(status" (line-editor-text (terminal-ui-editor ui)))
                   "Tab inserts the hosted native command into the composer.")
      (line-editor-set-text (terminal-ui-editor ui) "(sta")
      (terminal-ui--reconcile-completions ui)
      (unwind-protect
           (let ((entries (loop for index below 100
                                collect (list :name        (format nil "(dynamic-~D)" index)
                                              :description (make-string 10000 :initial-element #\x)))))
             (with-terminal-ui-locked (server)
               (setf (terminal-ui-completion-function server) (constantly entries))
               (terminal-ui--present-live server))
             (test-assert (funcall await ':completions
                                   (lambda (event)
                                     (and (getf (rest event) :complete-p)
                                          (find "(dynamic-99)" (getf (rest event) :entries)
                                                :key (lambda (entry) (getf entry :name)) :test #'equal))))
                          "Changed server capabilities publish a fresh bounded catalog.")
             (let ((events (remove-if-not
                            (lambda (event)
                              (let ((fields (rest event)))
                                (and (eq (getf fields :operation) ':completions)
                                     (find (getf (first (getf fields :entries)) :name) entries
                                           :key (lambda (entry) (getf entry :name)) :test #'equal))))
                            (funcall seen))))
               (test-assert (= (length events) 4) "A large catalog crosses the real wire in bounded chunks.")
               (dolist (event (butlast events))
                  (image-daemon:daemon-packet-string event)
                 (channel-subscription-present-event view event))
               (test-assert (find "(status)" (terminal-ui--reconcile-completions ui)
                                  :key (lambda (entry) (getf entry :name)) :test #'equal)
                            "Partial catalog delivery preserves the active completion set.")
               (channel-subscription-present-event view (first (last events)))
               (test-assert (and (= (length (terminal-ui-completions ui)) 100)
                                 (every (lambda (entry) (<= (length (getf entry :description)) 512))
                                        (terminal-ui-completions ui))
                                 (null (terminal-ui--reconcile-completions ui)))
                            "The final catalog chunk atomically replaces suggestions and invalidates a cached draft.")))
        (with-terminal-ui-locked (server)
          (setf (terminal-ui-completion-function server) provider)))))
  nil)

(-> test-presentation-client () null)
(defun test-presentation-client ()
  "Test a client that presents follows a hosted channel and drives it with input."
  (client-protocol-tests--call
   (lambda (application record)
     (test-assert (and (application-presentation application)
                       (not (terminal-interactive-p
                             (terminal-ui-terminal (application-ui application)))))
                  "a hosted channel has a presentation that nobody shows yet")
     (multiple-value-bind (connection seen await)
         (test-world-terminal--present record :rows 30 :columns 90)
       (unwind-protect
            (progn
              (test-assert (and (funcall await ':reset) (funcall await ':turn) (funcall await ':modal))
                           "a client that presents is first told what the channel shows")
              (presentation-tests--hosted-completion application seen await)
              (test-assert (and (terminal-interactive-p
                                 (terminal-ui-terminal (application-ui application)))
                                (= 90 (terminal-columns
                                       (terminal-ui-terminal (application-ui application)))))
                           "the channel is laid out for its client and somebody can answer it")
              (world-terminal-client-call connection ':submit :text "(list 34 47)")
              (test-assert (funcall await ':append
                                    (lambda (event)
                                      (search "(34 47)" (test-world-terminal--event-text event))))
                           "a native prompt result is presented")
              (test-assert (task-tests--wait-until
                            (lambda ()
                              (not (application-input-controller-busy-p
                                    (application-input-controller application))))
                            10)
                           "the channel returns to idle after presenting its result")
              (test-assert (null (getf (world-terminal-client-call connection ':input :action ':interrupt)
                                       :handled-p))
                           "an interrupt with nothing running is the client's to handle")
              (world-terminal-client-send connection ':input :action ':action-of-tomorrow)
              (test-assert (eq (first (getf (world-terminal-client-call connection ':state) :state))
                               ':world-terminal-status)
                           "an input action this version does not know leaves the connection working")
              (let* ((choice nil)
                     (asker  (make-thread
                              (lambda ()
                                (setf choice
                                      (terminal-ui-select
                                       (application-ui application)
                                       :title "pick"
                                       :items (list (list :name "one" :description "the first")
                                                    (list :name "two" :description "the second")))))
                              :name "presentation picker")))
                (test-assert (and (funcall await ':modal (lambda (event) (getf (rest event) :open-p)))
                                  (funcall await ':selector
                                           (lambda (event)
                                             (equal (mapcar (lambda (item) (getf item :name))
                                                            (getf (rest event) :items))
                                                    '("one" "two")))))
                             "a picker the channel opens shows on the client")
                (world-terminal-client-call connection ':event :event ':down)
                (test-assert (funcall await ':selector
                                      (lambda (event) (eql (getf (rest event) :selection) 1)))
                             "the client's keys move the channel's picker")
                (world-terminal-client-call connection ':event :event ':enter)
                (join-thread asker)
                (test-assert (and (equal choice "two")
                                  (funcall await ':selector
                                           (lambda (event)
                                             (and (null (getf (rest event) :open-p))
                                                  (member event
                                                          (member (funcall await ':selector)
                                                                  (funcall seen))))))
                                  (null (getf (world-terminal-client-call connection ':event :event ':enter)
                                              :accepted-p)))
                             "the picker returns the choice, closes, and takes no further keys")))
         (world-terminal-client-close connection)))
     (test-assert (task-tests--wait-until
                   (lambda ()
                     (not (terminal-interactive-p
                           (terminal-ui-terminal (application-ui application)))))
                   10)
                  "once the client left, nobody shows the channel")))
  nil)

(-> test-presentation-pages-and-readers () null)
(defun test-presentation-pages-and-readers ()
  "Test printed text, a whole-pane page and a modal reader's line reach the clients, and end with their owner."
  (multiple-value-bind (ui events) (presentation-tests--model)
    (let ((terminal (terminal-ui-terminal ui)))
      (flet ((last-of (operation)
               "Return the fields of the newest event of OPERATION."
               (rest (find operation (reverse (funcall events))
                           :key (lambda (event) (getf (rest event) :operation))))))
        (terminal-ui-start ui)
        (let ((stream (make-instance 'presentation-output-stream :terminal terminal)))
          (format stream "Open ~A~%Code: " "https://example.com")
          (finish-output stream))
        (test-assert (equal (mapcar (lambda (event) (getf (rest event) :entry))
                                    (remove ':append (funcall events)
                                            :key      (lambda (event) (getf (rest event) :operation))
                                            :test-not #'eq))
                            '("Open https://example.com" "Code: "))
                     "what a program prints shows as transcript lines, an unfinished prompt included")
        (with-terminal-ui-locked (ui)
          (setf (terminal-ui-live-output-suspended-p ui) t))
        (terminal-ui-fullscreen-paint ui :rows '("page row") :cursor-row 0 :cursor-column 3)
        (let ((count (length (funcall events))))
          (test-assert (and (getf (last-of ':page) :open-p)
                            (equal (getf (last-of ':page) :rows) '("page row"))
                            (eql (getf (last-of ':page) :cursor-column) 3))
                       "a page's rows and cursor go to the clients")
          (terminal-ui-fullscreen-paint ui :rows '("page row") :cursor-row 0 :cursor-column 3)
          (test-assert (= count (length (funcall events)))
                       "an unchanged page is not sent again"))
        (with-terminal-ui-locked (ui)
          (setf (terminal-ui-live-output-suspended-p ui) nil)
          (terminal-ui--paint-live ui))
        (test-assert (null (getf (last-of ':page) :open-p))
                     "the page closes once its owner gives the transcript back")
        (test-assert (null (presentation-terminal-offer-event terminal ':enter))
                     "without a modal reader a client's event is not taken")
        (terminal-ui-call-with-exclusive-input
         ui
         (lambda ()
           (test-assert (getf (last-of ':modal) :open-p)
                        "a modal reader tells the clients to send their events")
           (test-assert (and (presentation-terminal-offer-event terminal '(:insert "ab"))
                             (terminal-input-ready-p terminal))
                        "the reader takes a client's event")
           (terminal-ui-process-event ui (terminal-read-event terminal))
           (test-assert (and (equal (getf (last-of ':draft) :text) "ab")
                             (eql (getf (last-of ':draft) :cursor) 2))
                        "the line the reader edits shows on the clients")
           (channel-presentation-set-geometry ui :rows 21 :columns 73)
           (test-assert (equal (terminal-read-event terminal) '(:resize 73 21))
                        "the reader is told when the client's pane changes size")
           (test-assert (eq (terminal-read-event terminal) ':stream-end)
                        "with no client to answer, the reader's wait ends")))
        (test-assert (and (null (getf (last-of ':modal) :open-p))
                          (null (getf (last-of ':draft) :text))
                          (null (presentation-terminal-offer-event terminal ':enter)))
                     "the reader's line and its claim on the clients' events end with it"))))
  nil)
