(in-package #:autolith)

;;;; -- Hyperlinked Transcript Rendering --

(-> test-hyperlinked-rendering () null)
(defun test-hyperlinked-rendering ()
  "Test OSC 8 wrapping of URLs in styled output and its absence elsewhere."
  (let* ((styled         (make-instance 'recording-terminal :columns 40 :styled-p t))
         (plain-terminal (make-instance 'recording-terminal :columns 40))
         (spans          (list (terminal-span ':plain "go to https://example.com/x now")))
         (plain          (terminal--spans-text spans))
         (display        (terminal--render-spans styled spans))
         (open           (format nil "~C]8;;https://example.com/x~C\\" #\Escape #\Escape))
         (close          (format nil "~C]8;;~C\\" #\Escape #\Escape))
         (open-at        (search open display)))
    (test-assert open-at
                 "styled output opens an OSC 8 hyperlink at the URL")
    (test-assert (and open-at
                      (search close display
                              :start2 (+ open-at (length open))))
                 "the hyperlink closes after the URL")
    (test-assert (string= (clinedi:ansi-strip display) plain)
                 "hyperlinks leave the visible text unchanged")
    (test-assert (not (search (format nil "~C]8;;" #\Escape)
                              (terminal--render-spans plain-terminal spans)))
                 "unstyled output carries no OSC 8 controls"))
  (let ((styled (make-instance 'recording-terminal :columns 24 :styled-p t))
        (plain  (make-instance 'recording-terminal :columns 24))
        (target "https://target.test/path?q=1"))
    (dolist (source '("[documentation](https://target.test/path?q=1)"
                      "# [https://label.test/long-link-text](https://target.test/path?q=1)"))
      (let* ((renderer (termdown:markdown-renderer-create :width 24))
             (rows     (terminal-markdown-render-line renderer source)))
        (test-assert (every #'terminal-styled-text-p rows)
                     "ordinary and heading link widgets use registered styles")
        (test-assert (every (lambda (row) (<= (terminal--spans-width row) 24)) rows)
                     "wrapped links occupy only their visible label width")
        (multiple-value-bind (text display regions)
            (terminal-ui--stream-output styled rows)
          (test-assert (and regions
                            (every (lambda (region)
                                     (equal (third region) (list ':open-url target)))
                                   regions))
                       "streamed link pieces retain the explicit destination")
          (dolist (region regions)
            (test-assert (equal (termdown:region-action regions (first region))
                                (list ':open-url target))
                         "a click on each wrapped label piece resolves to its target"))
          (test-assert (search (format nil "~C]8;;~A" #\Escape target) display)
                       "styled Markdown labels carry native terminal hyperlinks")
          (test-assert (not (search (format nil "~C]8;;https://label.test" #\Escape)
                                    display))
                       "URL-shaped labels do not create nested hyperlinks")
          (test-assert (string= text (clinedi:ansi-strip display))
                       "styled and streamed plain output have identical visible text")
          (multiple-value-bind (plain-text plain-display)
              (terminal-ui--stream-output plain rows)
            (test-assert (and (string= text plain-text)
                              (string= plain-text plain-display)
                              (not (find #\Escape plain-display)))
                         "plain terminals print labels without terminal controls"))))))
  nil)
