(in-package #:autolith)

;;;; -- Shell Capture Allocation Work --

(-> test-shell-log-allocation-work () null)
(defun test-shell-log-allocation-work ()
  "Bound ordinary allocation work independently of retained capture history."
  (with-test-configuration (configuration)
    (let* ((*shell-log-active* (make-hash-table :test #'equal))
           (*shell-log-capture-byte-limit* 32)
           (context (shell-log-tests--context configuration "allocation-work"))
           (seed (shell-log-allocate context))
           (count 256))
      (shell-log-tests--finish seed (utf8-string-to-octets "x"))
      (dotimes (index count)
        (let* ((metadata (copy-tree (shell-log-artifact-metadata seed)))
               (identifier (format nil "retained-~D" index))
               (directory (merge-pathnames (format nil "~A/" identifier)
                                           (uiop:pathname-parent-directory-pathname
                                            (shell-log-capture-directory seed)))))
          (setf (getf metadata :artifact-id) identifier
                (getf metadata :delivered-at) (get-universal-time))
          (test-write-text (merge-pathnames "output.bin" directory) "x")
          (test-write-text (merge-pathnames "manifest.sexp" directory)
                           (task--write-readable-sexp metadata))))
      (shell-log-prune configuration)
      (let ((reads 0)
            (original (symbol-function 'shell-log--scan-manifest))
            (started (get-internal-real-time)))
        (test-call-with-function-replacements
         (list (list 'shell-log--scan-manifest
                     (lambda (&rest arguments)
                       (incf reads)
                       (apply original arguments))))
         (lambda ()
           (let ((artifact (shell-log-allocate context)))
             (shell-log-tests--finish artifact (utf8-string-to-octets "new")))))
        (format t "~&Allocation with ~D retained captures: ~,3F seconds, ~D historical manifest scans.~%"
                count (/ (- (get-internal-real-time) started)
                         (float internal-time-units-per-second)) reads)
        (test-assert (<= reads 2)
                     "Allocating and settling a capture do bounded work without rescanning history."))))
  nil)

(-> test-shell-log-accounting-recovery () null)
(defun test-shell-log-accounting-recovery ()
  "Rebuild missing, dirty and corrupt checkpoints without losing live reservations."
  (dolist (damage '(:missing :dirty :corrupt :version))
    (with-test-configuration (configuration)
      (let* ((*shell-log-active* (make-hash-table :test #'equal))
             (*shell-log-capture-byte-limit* 32)
             (*shell-log-retention-byte-limit* 35)
             (context (shell-log-tests--context configuration "accounting-recovery"))
             (publication (make-instance 'shell-log-publication :configuration configuration))
             (*shell-log-publications* (list publication))
             (artifact (shell-log-allocate context))
             (replacement nil))
        (unwind-protect
             (progn
               (shell-log-tests--finish artifact (utf8-string-to-octets "old"))
               (with-shell-log-lock (configuration)
                 (ecase damage
                   (:missing (delete-file (shell-log-accounting--path configuration)))
                   (:dirty (shell-log-accounting--dirty configuration))
                   (:corrupt (test-write-text (shell-log-accounting--path configuration) "("))
                   (:version
                    (let ((state (shell-log-accounting--read configuration)))
                      (setf (getf state :version) 2)
                      (shell-log-accounting--publish configuration state)))))
               (test-assert
                (handler-case (progn (shell-log-allocate context) nil)
                  (shell-log-error () t))
                "Recovery preserves the full reservation while publication is live.")
               (when (eq damage ':version)
                 (with-shell-log-lock (configuration)
                   (let ((state (task-continuity--read (shell-log-accounting--path configuration))))
                     (test-assert (eql (getf state :version) 2)
                                  "An unsupported checkpoint is refused without overwriting it.")
                     (setf (getf state :version) 1)
                     (shell-log-accounting--publish configuration state))))
               (shell-log--finish-publication publication)
               (setf replacement (shell-log-allocate context))
               (test-assert (= 35 (getf (shell-log-accounting--read configuration) :bytes))
                            "Settled bytes and the next reservation are charged exactly."))
          (when replacement (shell-log-release-artifact replacement))
          (shell-log--finish-publication publication)))))
  nil)

(-> test-shell-log-accounting-publication-failure () null)
(defun test-shell-log-accounting-publication-failure ()
  "Leave interrupted accounting dirty and recover quota after an allocation publication failure."
  (dolist (point '(:manifest :checkpoint))
    (with-test-configuration (configuration)
      (let* ((*shell-log-active* (make-hash-table :test #'equal))
             (*shell-log-capture-byte-limit* 32)
             (*shell-log-retention-byte-limit* 33)
             (context (shell-log-tests--context configuration "accounting-failure"))
             (seed (shell-log-allocate context))
             (write (symbol-function 'task-continuity--write))
             (checkpoint (symbol-function 'shell-log-accounting--publish)))
        (shell-log-tests--finish seed (utf8-string-to-octets "x"))
        (test-call-with-function-replacements
         (list
          (list 'task-continuity--write
                (lambda (path value)
                  (when (and (eq point ':manifest) (equal (file-namestring path) "manifest.sexp"))
                    (shell-log--fail "Injected manifest publication failure."))
                  (funcall write path value)))
          (list 'shell-log-accounting--publish
                (lambda (settings state)
                  (when (and (eq point ':checkpoint) (getf state :clean-p)
                             (> (getf state :bytes) 1))
                    (shell-log--fail "Injected accounting checkpoint failure."))
                  (funcall checkpoint settings state))))
         (lambda ()
           (test-assert
            (handler-case (progn (shell-log-allocate context) nil)
              (shell-log-error () t))
            "A failed publication refuses the allocation.")))
        (test-assert (not (getf (shell-log-accounting--read configuration) :clean-p))
                     "An interrupted accounting transaction is not trusted for admission.")
        (let ((replacement (shell-log-allocate context)))
          (unwind-protect
               (test-assert (= 33 (getf (shell-log-accounting--read configuration) :bytes))
                            "Recovery neither loses retained bytes nor leaks the failed reservation.")
            (shell-log-release-artifact replacement))))))
  nil)

(-> test-shell-log-maintenance-batches () null)
(defun test-shell-log-maintenance-batches ()
  "Reclaim age-eligible logs in bounded batches outside allocation."
  (with-test-configuration (configuration)
    (let* ((*shell-log-active* (make-hash-table :test #'equal))
           (*shell-log-capture-byte-limit* 32)
           (*shell-log-maintenance-states* (make-hash-table :test #'equal))
           (*shell-log-maintenance-interval* 0)
           (*shell-log-maintenance-batch-size* 2)
           (context (shell-log-tests--context configuration "maintenance-batches"))
           (artifacts nil)
           (reads 0)
           (scan (symbol-function 'shell-log--scan-manifest)))
      (loop repeat 9 do
        (let ((artifact (shell-log-allocate context)))
          (shell-log-tests--finish artifact (utf8-string-to-octets "x"))
          (setf (getf (shell-log-artifact-metadata artifact) :created-at)
                (- (get-universal-time) *shell-log-retention-age* 1))
          (shell-log--write-manifest artifact)
          (push artifact artifacts)))
      (test-call-with-function-replacements
       (list (list 'shell-log--scan-manifest
                   (lambda (&rest arguments) (incf reads) (apply scan arguments))))
       (lambda ()
         (test-assert (shell-log-maintenance-step configuration)
                      "A sweep yields while more captures need inspection.")))
      (test-assert (<= reads 4) "One batch inspects at most its configured number of captures.")
      (loop while (shell-log-maintenance-step configuration))
      (test-assert
       (every (lambda (artifact)
                (not (probe-file (merge-pathnames "output.bin" (shell-log-capture-directory artifact)))))
              artifacts)
       "Subsequent maintenance jobs reclaim all age-eligible captures.")
      (test-assert (zerop (getf (shell-log-accounting--read configuration) :bytes))
                   "Incremental pruning commits every reclaimed byte to accounting.")))
  nil)
