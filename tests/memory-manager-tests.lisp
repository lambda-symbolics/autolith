(in-package #:autolith)

;;;; -- Fullscreen Memory Manager Tests --

(-> memory-manager-tests--call (function &key (:columns integer) (:rows integer) (:events list)) t)
(defun memory-manager-tests--call (function &key (columns 80) (rows 24) events)
  "Call FUNCTION with an isolated fullscreen application and scripted terminal."
  (with-test-configuration (base root)
    (let* ((configuration (configuration-copy base :working-directory root :fullscreen-p t))
           (terminal (make-instance 'scripted-terminal :columns columns :rows rows :styled-p t :events events))
           (ui (terminal-ui-create :terminal terminal :fullscreen-p t))
           (application (make-instance 'application :configuration configuration :ui ui
                                                   :conversation (conversation-create configuration))))
      (with-terminal-ui (active-ui ui)
        (declare (ignore active-ui))
        (funcall function application terminal)))))

(-> memory-manager-tests--manager (application) memory-manager)
(defun memory-manager-tests--manager (application)
  "Create the same captured browser state used by the interactive operation."
  (let ((manager (make-instance
                  'memory-manager :application application
                  :session (clinedi:make-selection-session
                            :identity-key #'memory-manager-item-key :identity-test #'string=
                            :search-key #'memory-manager-item-search-text :search-p t :visible-count 8))))
    (memory-manager--reload manager)
    manager))

(-> memory-manager-tests--event (memory-manager t) boolean)
(defun memory-manager-tests--event (manager event)
  "Handle EVENT and compose the next frame, as in the actual event loop."
  (prog1 (memory-manager--event manager event)
    (memory-manager--frame manager)))

(-> test-memory-manager-navigation () null)
(defun test-memory-manager-navigation ()
  "Exercise complete inventories, local search, scope/type filtering and stable selection."
  (memory-manager-tests--call
   (lambda (application terminal)
     (declare (ignore terminal))
     (dotimes (index 32)
       (application-memory-manager-create application :title (format nil "Note ~2,'0D" index)
                                                     :content (format nil "searchable-body-~D" index)))
     (let* ((global (application-memory-manager-create application :title "Global note"
                                                              :content "global content" :scope ':global))
            (schema (memory-manager-model-tests--schema (application-configuration application))))
       (memory-manager-model-tests--assert (application-configuration application) schema '("subject" 12))
       (let* ((manager (memory-manager-tests--manager application))
              (session (memory-manager-session manager)))
         (flet ((listed () (selector-items (clinedi:selection-session-selector session))))
           (test-assert (= 34 (length (listed))) "the browser includes entries beyond transcript limits")
            (let ((key (memory-manager-item-key (memory-manager--selected manager))))
              (memory-manager-tests--event manager '(:scroll 1))
              (test-assert (not (string= key (memory-manager-item-key (memory-manager--selected manager))))
                           "the wheel moves the list selection")
              (memory-manager-tests--event manager '(:scroll -1))
              (test-assert (string= key (memory-manager-item-key (memory-manager--selected manager)))
                           "reverse wheel movement restores the selection"))
           (memory-manager-tests--event manager '(:insert "/"))
           (memory-manager-tests--event manager '(:insert "searchable-body-31"))
           (test-assert (= 1 (length (listed))) "live search includes note bodies")
           (memory-manager-tests--event manager ':submit)
           (let ((key (memory-manager-item-key (memory-manager--selected manager))))
             (memory-manager--reload manager :selected-id key)
             (memory-manager-tests--event manager '(:insert "/"))
             (memory-manager-tests--event manager ':kill-line)
             (memory-manager-tests--event manager ':submit)
             (test-assert (= 34 (length (listed))) "clearing a query restores all captured candidates")
             (test-assert (string= key (memory-manager-item-key (memory-manager--selected manager)))
                          "reload and filtering preserve a visible selected identity"))
           (memory-manager-tests--event manager ':complete)
           (test-assert (every #'application-memory-manager-editable-p (listed))
                        "the Notes tab excludes structured facts")
           (memory-manager-tests--event manager ':complete)
           (test-assert (= 1 (length (listed))) "the Facts tab contains structured facts")
           (memory-manager-tests--event manager ':complete)
           (memory-manager-tests--event manager ':complete-previous)
           (test-assert (every (lambda (item) (eq (memory-manager-item-scope item) ':workspace)) (listed))
                        "scope filtering selects workspace entries")
           (memory-manager-tests--event manager ':complete-previous)
           (test-assert (equal (mapcar #'memory-manager-item-identifier (listed)) (list (memory-identifier global)))
                        "the Global scope isolates cross-workspace notes"))))))
  nil)

(-> test-memory-manager-layout () null)
(defun test-memory-manager-layout ()
  "Exercise bounded wide/narrow frames and real detail scrolling after reflow."
  (memory-manager-tests--call
   (lambda (application terminal)
     (let ((body (format nil "~{~A~%~}" (loop for index below 80 collect (format nil "Detail row ~D 界 é" index)))))
       (application-memory-manager-create application :title "A long note 界 é with wrapping" :content body)
       (let ((manager (memory-manager-tests--manager application)))
         (dolist (size '((120 32) (80 24) (42 24) (24 10) (12 5)))
           (destructuring-bind (columns rows) size
             (terminal-ui-resize (application-ui application) columns :rows rows)
             (dolist (focus '(:list :detail :search))
               (setf (memory-manager-focus manager) focus)
               (multiple-value-bind (frame row column visible-p) (memory-manager--frame manager)
                 (declare (ignore visible-p))
                 (test-assert (and (<= (length frame) rows)
                                   (every (lambda (line) (<= (text-cell-width (clinedi:ansi-strip line)) columns)) frame)
                                   (<= 0 row (1- rows)) (<= 0 column (1- columns)))
                              "manager rows and cursor fit terminal cells")))))
         (terminal-ui-resize (application-ui application) 42 :rows 24)
         (setf (memory-manager-focus manager) ':detail)
         (memory-manager--frame manager)
         (memory-manager-tests--event manager ':page-down)
         (test-assert (plusp (memory-manager-scroll manager)) "detail navigation scrolls the explanation")
         (memory-manager-tests--event manager ':home)
         (test-assert (zerop (memory-manager-scroll manager)) "Home returns to the explanation's beginning")
          (memory-manager-tests--event manager '(:scroll 1))
          (test-assert (= 3 (memory-manager-scroll manager)) "the wheel scrolls three detail rows")
          (test-assert (= 42 (terminal-columns terminal)) "the modal uses the resized transport geometry")
          (setf (memory-manager-focus manager) ':search)
          (memory-manager-tests--event manager (list ':insert (format nil "~{~A~}" (make-list 40 :initial-element "界é"))))
          (multiple-value-bind (frame row column visible-p) (memory-manager--frame manager)
            (test-assert (and visible-p (< row 24) (< column 42)
                              (every (lambda (line) (<= (text-cell-width (clinedi:ansi-strip line)) 42)) frame)
                            (null (memory-manager--selected manager)))
                       "a long Unicode query keeps the cursor in view with no matching selection"))
          (memory-manager-tests--event manager ':kill-line)
          (memory-manager-tests--event manager ':escape)
          (memory-manager--begin-edit manager)
          (terminal-ui-resize (application-ui application) 24 :rows 12)
          (dolist (mode '(:edit :confirm-delete :confirm-discard))
            (setf (memory-manager-mode manager) mode)
            (multiple-value-bind (frame row column visible-p) (memory-manager--frame manager)
              (declare (ignore visible-p))
              (test-assert (and (<= (length frame) 12) (< row 12) (< column 24))
                         "forms and confirmations fit the smallest supported terminal")))))))
  nil)

(-> test-memory-manager-note-form () null)
(defun test-memory-manager-note-form ()
  "Create, validate, edit, cancel and confirm note mutations through keyboard events."
  (memory-manager-tests--call
   (lambda (application terminal)
     (declare (ignore terminal))
     (let ((manager (memory-manager-tests--manager application)))
       (memory-manager-tests--event manager '(:insert "n"))
       (memory-manager-tests--event manager ':submit)
       (test-assert (and (eq (memory-manager-mode manager) ':edit)
                         (memory-manager-message manager)) "invalid fields leave the form available for correction")
       (dolist (event '((:insert "Created note") :complete (:insert "one, two") :complete
                        (:insert " ") :complete (:insert "first line") :insert-newline
                        (:insert "second line") :submit))
         (memory-manager-tests--event manager event))
       (let ((memory (first (memory-list (application-configuration application)))))
         (test-assert (and memory (eq (memory-scope memory) ':global)
                           (equal (memory-tags memory) '("one" "two"))
                           (string= (memory-content memory) (format nil "first line~%second line")))
                      "the form saves scope, tags and multiline content")
         (dolist (event '((:insert "e") :kill-line (:insert "Edited note") :submit))
           (memory-manager-tests--event manager event))
         (test-assert (string= "Edited note" (memory-title (first (memory-list (application-configuration application)))))
                      "editing replaces the selected note")
         (memory-manager-tests--event manager '(:insert "d"))
         (memory-manager-tests--event manager '(:insert "n"))
         (test-assert (memory-list (application-configuration application)) "cancelling a confirmation does not forget the note")
         (memory-manager-tests--event manager '(:insert "d"))
         (test-assert (memory-list (application-configuration application)) "the destructive action waits for confirmation")
         (memory-manager-tests--event manager '(:insert "y"))
         (test-assert (null (memory-list (application-configuration application))) "confirmation durably forgets the selected note")))))
  nil)

(-> test-memory-manager-unsaved-form () null)
(defun test-memory-manager-unsaved-form ()
  "Protect drafts from Escape and interactive cancellation, and retain failed edits."
  (memory-manager-tests--call
   (lambda (application terminal)
     (declare (ignore terminal))
     (let ((manager (memory-manager-tests--manager application)))
       (memory-manager-tests--event manager '(:insert "n"))
       (memory-manager-tests--event manager '(:insert "Unsaved title"))
       (dolist (cancel '(:escape :interrupt :end-of-input))
         (memory-manager-tests--event manager cancel)
         (test-assert (eq (memory-manager-mode manager) ':confirm-discard) "closing a dirty form asks before discarding")
         (memory-manager-tests--event manager '(:insert "n"))
         (test-assert (string= "Unsaved title" (line-editor-text (first (memory-manager-editors manager))))
                      "refusing discard preserves the editor draft"))
       (memory-manager-tests--event manager ':escape)
       (memory-manager-tests--event manager '(:insert "y"))
       (test-assert (and (eq (memory-manager-mode manager) ':browse)
                         (null (memory-list (application-configuration application))))
                    "discarding a new note writes no persistent memory"))))
  nil)

(-> test-memory-manager-lifecycle () null)
(defun test-memory-manager-lifecycle ()
  "Run the actual exclusive modal and restore transcript/composer state after close or failure."
  (memory-manager-tests--call
   (lambda (application terminal)
     (let* ((ui (application-ui application))
            (note (application-memory-manager-create application :title "Selected note" :content "Visible detail"))
            (viewport (fullscreen-terminal-ui-viewport ui))
            (editor (terminal-ui-editor ui)))
       (terminal-ui-set-input ui "A saved conversation draft")
       (line-editor-handle-event editor ':left)
       (let ((snapshot (clinedi:line-editor-snapshot editor)))
         (application-memory-manager application :identifier (subseq (memory-identifier note) 0 8))
         (test-assert (and (equalp snapshot (clinedi:line-editor-snapshot editor))
                           (eq viewport (fullscreen-terminal-ui-viewport ui))
                           (not (terminal-ui-live-output-suspended-p ui)))
                      "leaving the manager restores the independent conversation UI")
         (test-assert (search "Visible detail" (clinedi:ansi-strip (recording-terminal-output terminal)))
                      "identifier entry opens the requested detail pane")
         (test-call-with-function-replacements
          (list (list 'memory-manager--frame
                      (lambda (manager)
                        (declare (ignore manager))
                        (error 'terminal-error :operation ':write :cause nil :message "Injected manager paint failure"))))
          (lambda ()
            (handler-case (application-memory-manager application)
              (terminal-error () nil))))
         (test-assert (and (equalp snapshot (clinedi:line-editor-snapshot editor))
                           (not (terminal-ui-live-output-suspended-p ui)))
                      "a failed modal paint also releases ownership and restores the composer"))))
   :events '(:escape :escape))
  nil)

(-> test-memory-manager-command () null)
(defun test-memory-manager-command ()
  "Invoke the real operation lookup and preserve nonfullscreen text presentation."
  (memory-manager-tests--call
   (lambda (application terminal)
     (declare (ignore terminal))
     (let* ((operation (application-operation-find application 'memories))
            (command (application-operation-backend operation))
            (seen nil))
       (test-assert (eq ':exclusive (application-command-terminal-behavior command)) "the browser operation owns terminal input")
       (test-assert (eq ':hold (application-command-busy-behavior command)) "the manager waits for active work before editing")
       (test-call-with-function-replacements
        (list (list 'application-memory-manager
                    (lambda (target &key query identifier)
                      (declare (ignore identifier))
                      (setf seen (list target query)))))
        (lambda () (application-operation-invoke operation application '("needle"))))
       (test-assert (equal seen (list application "needle")) "operation arguments reach the fullscreen manager"))))
  (with-test-configuration (configuration root)
    (declare (ignore root))
    (let* ((terminal (make-instance 'recording-terminal :columns 80))
           (application (make-instance 'application :configuration configuration
                                                   :conversation (conversation-create configuration)
                                                   :ui (terminal-ui-create :terminal terminal)))
           (seen nil))
      (test-call-with-function-replacements
       (list (list 'application-present (lambda (target entry) (declare (ignore target)) (setf seen entry)))
             (list 'application-memory-manager (lambda (&rest arguments) (declare (ignore arguments)) (error "Unexpected fullscreen manager"))))
       (lambda ()
         (application-operation-invoke (application-operation-find application 'memories) application nil)))
      (test-assert seen "inline and noninteractive invocations use the textual listing")))
  nil)
