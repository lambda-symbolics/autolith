;;;; -- Autolith Compatibility and Extension Systems --

(let ((definition (merge-pathnames "autolith-agent.asd" *load-truename*))
      (agent      (asdf:find-system "autolith-agent" nil)))
  (unless (and agent (uiop:pathname-equal (asdf:system-source-file agent) definition))
    (asdf:load-asd definition)))

(asdf:defsystem #:autolith
  :description "Compatibility entry point for the Autolith agent."
  :version     (:read-file-line "VERSION")
  :depends-on  (#:autolith-agent)
  :in-order-to ((asdf:test-op (asdf:test-op #:autolith/tests))))

#-win32
(asdf:defsystem #:autolith/release-server
  :description             "The Autolith installer and binary release service."
  :depends-on              (#:autolith
                            #:sb-bsd-sockets)
  :default-component-class autolith-source-file
  :serial                  t
  :components              ((:module     "server"
                             :serial     t
                             :components ((:file "release-server")
                                          (:file "release-builder")
                                          (:file "release-updater")
                                          (:file "release-archive")
                                          (:file "release-main")))))

(asdf:defsystem #:autolith/checks
  :description             "Repository source checks and repairs for Autolith's coding rules."
  :depends-on              (#:autolith #:mallet)
  :default-component-class autolith-source-file
  :serial                  t
  :components              ((:module     "checks"
                             :serial     t
                             :components ((:file "syntax")
                                          (:file "rules")
                                          (:file "formatting")
                                          (:file "definitions")
                                          (:file "parinfer")
                                          (:file "warnings")
                                          (:file "mallet")
                                          (:file "runner")))))

