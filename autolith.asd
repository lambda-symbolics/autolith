                                          (:file "application/operation-tests")
                                          (:file "help/tests")
                                          (:file "recovery/input-vault-tests")
                                          (:file "vault/edit-tests")
                                          (:file "user/init-tests")
                                          (:file "prompt/tests")
                                          (:file "acp/observer-tests")
                                          (:file "acp/session-tests")
                                          (:file "acp/reconnect-tests")
                                          (:file "acp/extensions/tests")
                                          (:file "acp/extensions/settings-tests")
                                          (:file "acp/extensions/catalogs-tests")
                                          (:file "acp/extensions/conversations-tests")
                                          (:file "acp/extensions/jobs-tests")
                                          (:file "acp/extensions/resources-tests")
                                          (:file "acp/mcp-tests")
                                          (:file "acp/launcher-tests")
                                          (:file "acp/remote-tests")
                                          (:file "tests")
                                          (:file "test-runner")
                                          (:file "fixture-tests")
                                          (:file "test-runner-tests")
                                          (:file "telemetry/tests")
                                          (:file "telemetry/upload-tests")
                                          (:file "telemetry/process-tests")
                                          (:file "model/catalog-tests")
                                          (:file "provider/catalog-tests")
                                          (:file "telemetry/catalog-tests")
                                          (:file "telemetry/hooks/support-tests")
                                          (:file "telemetry/hooks/model-tests")
                                          (:file "provider/telemetry-hook-tests")
                                          (:file "telemetry/hooks/run-tests")
                                          (:file "telemetry/hooks/report-tests")
                                          (:file "telemetry/hooks/repair-tests")
                                          (:file "redaction/tests")
                                          (:file "telemetry/diagnostic-tests")
                                          (:file "telemetry/hooks/tool-outcome-tests")
                                          (:file "telemetry/hooks/tool-denial-tests")
                                          (:file "telemetry/hooks/authority-tests")
                                          (:file "telemetry/hooks/os-permission-tests")
                                          (:file "test-suites"))))
  :perform                 (asdf:test-op (operation component)
                             (declare (ignore operation component))
                             (uiop:symbol-call '#:autolith '#:run-tests)))

(asdf:defsystem #:autolith/structural
  :description             "Optional structural code queries and revision-aware rewrites."
  :depends-on              (#:autolith #:clasted/ast-grep)
  :default-component-class autolith-source-file
  :serial                  t
  :components              ((:file "src/structural/workspace")
                            (:file "src/structural/tools")))

(asdf:defsystem #:autolith/structural/tests
  :description             "Autolith structural tool boundary checks."
  :depends-on              (#:autolith/structural #:autolith/tests)
  :default-component-class autolith-source-file
  :serial                  t
  :components              ((:file "tests/structural/tests"))
  :perform                 (asdf:test-op (operation component)
                             (declare (ignore operation component))
                             (uiop:symbol-call '#:autolith '#:run-tests :suites '("structural"))))

(asdf:defsystem #:autolith/debug
  :description             "Optional semantic Debug Adapter Protocol sessions."
  :depends-on              (#:autolith #:daphne)
  :default-component-class autolith-source-file
  :serial                  t
  :components              ((:file "src/debug/sessions")
                            (:file "src/debug/tools")))

(asdf:defsystem #:autolith/debug/tests
  :description             "Autolith debug tool boundary checks."
  :depends-on              (#:autolith/debug #:autolith/tests #:daphne/test-support)
  :default-component-class autolith-source-file
  :serial                  t
  :components              ((:file "tests/debug/tests"))
  :perform                 (asdf:test-op (operation component)
                             (declare (ignore operation component))
                             (uiop:symbol-call '#:autolith '#:run-tests :suites '("debug"))))
