;;;; -- Portable Agent Record Values --

(in-package #:autolith)

(-> agent-session-value-encode (t) vector)
(defun agent-session-value-encode (value)
  "Encode bounded agent record VALUE as tagged data, without readable Lisp text."
  (let ((remaining 8192))
    (labels ((encode (item depth)
               (when (or (> depth 12) (minusp (decf remaining)))
                 (error 'agent-protocol-error :reason ':record-limit))
               (cond
                 ((null item)
                  (vector "nil"))
                 ((eq item t)
                  (vector "true"))
                 ((keywordp item)
                  (vector "keyword" (symbol-name item)))
                 ((stringp item)
                  (unless (<= (length item) 1048576)
                    (error 'agent-protocol-error :reason ':record-limit))
                  (vector "string" (copy-seq item)))
                 ((typep item '(signed-byte 64))
                  (vector "integer" item))
                 ((typep item 'double-float)
                  (vector "number" item))
                 ((consp item)
                  (unless (handler-case (list-length item)
                            (type-error () nil))
                   (error 'agent-protocol-error :reason ':invalid-record-value))
                  (vector "list" (map 'vector (lambda (child) (encode child (1+ depth))) item)))
                 ((vectorp item)
                  (vector "vector" (map 'vector (lambda (child) (encode child (1+ depth))) item)))
                 (t
                  (error 'agent-protocol-error :reason ':invalid-record-value)))))
      (encode value 0))))

(-> agent-session-value-decode (t) t)
(defun agent-session-value-decode (value)
  "Decode bounded tagged data. Resolve only existing keywords; never intern input."
  (let ((remaining 8192))
    (labels ((decode (item depth)
               (unless (and (vectorp item) (not (stringp item))
                            (<= 1 (length item) 2) (stringp (aref item 0))
                            (<= depth 12) (not (minusp (decf remaining))))
                 (error 'agent-protocol-error :reason ':invalid-record-value))
               (let ((tag   (aref item 0))
                     (child (and (= (length item) 2) (aref item 1))))
                 (cond
                   ((and (= (length item) 1) (equal tag "nil"))
                    nil)
                   ((and (= (length item) 1) (equal tag "true"))
                    t)
                   ((and (= (length item) 2) (equal tag "keyword") (stringp child))
                    (or (find-symbol child '#:keyword)
                        (error 'agent-protocol-error :reason ':unknown-record-keyword)))
                   ((and (= (length item) 2) (equal tag "string") (stringp child)
                         (<= (length child) 1048576))
                    (copy-seq child))
                   ((and (= (length item) 2) (equal tag "integer") (typep child '(signed-byte 64)))
                    child)
                   ((and (= (length item) 2) (equal tag "number") (typep child 'double-float))
                    child)
                   ((and (= (length item) 2) (member tag '("list" "vector") :test #'equal)
                         (vectorp child) (not (stringp child)))
                    (map (if (equal tag "list") 'list 'vector)
                         (lambda (entry) (decode entry (1+ depth))) child))
                   (t
                    (error 'agent-protocol-error :reason ':invalid-record-value))))))
      (decode value 0))))
