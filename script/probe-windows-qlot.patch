index 1e5f0ed9..de32b64b 100644
--- a/script/qlot-delete-directory.ps1
+++ b/script/qlot-delete-directory.ps1
@@ -35,4 +35,12 @@ $fullPath = [IO.Path]::GetFullPath($Path).TrimEnd([char[]]'\/')
 if ($fullPath -eq [IO.Path]::GetPathRoot($fullPath).TrimEnd([char[]]'\/')) {
   throw 'Refusing to remove a filesystem root.'
 }
+function Write-QlotProbeMarker([string]$Phase) {
+  if ($env:AUTOLITH_QLOT_PROBE_DIR) {
+    $marker = "{0:O} pid={1} {2} {3}`n" -f [DateTime]::UtcNow, $PID, $Phase, $fullPath
+    [IO.File]::AppendAllText((Join-Path $env:AUTOLITH_QLOT_PROBE_DIR "powershell.log"), $marker)
+  }
+}
+Write-QlotProbeMarker "before"
 Remove-QlotDirectoryEntry $fullPath
+Write-QlotProbeMarker "after"
