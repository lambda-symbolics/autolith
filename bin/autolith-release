#!/usr/bin/env bash

set -euo pipefail

resolve_path()
{
  local path=$1
  local directory
  local target

  case "$path" in
    /*) ;;
    *) path=$PWD/$path ;;
  esac
  while [[ -L "$path" ]]; do
    directory=$(CDPATH= cd -P "$(dirname "$path")" && pwd) || return 1
    target=$(readlink "$path") || return 1
    case "$target" in
      /*) path=$target ;;
      *) path=$directory/$target ;;
    esac
  done
  directory=$(CDPATH= cd -P "$(dirname "$path")" && pwd) || return 1
  printf '%s/%s\n' "$directory" "$(basename "$path")"
}

xdg_base_directory()
{
  case ${1:-} in
    /*) printf '%s\n' "$1" ;;
    *) printf '%s\n' "$2" ;;
  esac
}

release_latest_url=${AUTOLITH_RELEASE_LATEST_URL:-https://sh.lambda-symbolics.com/releases/latest}
launcher_path=$(resolve_path "${BASH_SOURCE[0]}")
release_root=$(CDPATH= cd -P -- "$(dirname -- "$launcher_path")/.." && pwd)
release_record=$release_root/RELEASE
source_root=$release_root/libexec/autolith
# shellcheck source=../script/launcher-cli.sh
source "$source_root/script/launcher-cli.sh"
autolith_launcher_parse release "$@"
if [[ $uninstall_requested == true ]]; then
  uninstall_root=
  if [[ $(basename -- "$(dirname -- "$release_root")") == releases ]]; then
    uninstall_root=$(CDPATH= cd -P -- "$release_root/../.." && pwd)
  fi
  autolith_uninstall release "$uninstall_root" "$release_root"
  exit $?
fi
runtime_root=$release_root/runtime
runtime_source_root=$release_root/libexec/sbcl-source
sbcl_command=$runtime_root/bin/sbcl
sandbox_helper=$release_root/libexec/cl-exec-sandbox-helper
process_group_helper=$release_root/libexec/cl-exec-sandbox-process-group
home=${HOME:-}
data_home=$(xdg_base_directory "${XDG_DATA_HOME:-}" "$home/.local/share")
active_core=$data_home/autolith/active/autolith-active.core
recovery_core=$data_home/autolith/recovery/autolith-recovery.core
image_marker=$data_home/autolith/release-images

style_brand=
style_dim=
style_good=
style_notice=
style_failure=
style_reset=
if [[ -t 2 && -z ${NO_COLOR:-} ]]; then
  style_brand=$'\033[35;1m'
  style_dim=$'\033[2m'
  style_good=$'\033[32m'
  style_notice=$'\033[33m'
  style_failure=$'\033[31;1m'
  style_reset=$'\033[0m'
fi

fail()
{
  printf '%sAutolith release failed:%s %s\n' "$style_failure" "$style_reset" "$1" >&2
  exit 1
}

say_section()
{
  printf '\n%s%s%s\n' "$style_brand" "$1" "$style_reset" >&2
}

say_note()
{
  printf '%s│%s %s\n' "$style_dim" "$style_reset" "$1" >&2
}

say_notice()
{
  printf '%s%s%s\n' "$style_notice" "$1" "$style_reset" >&2
}

say_done()
{
  printf '%s%s%s\n' "$style_good" "$1" "$style_reset" >&2
}

# Rail every line of standard input under the current section, keeping only
# the final redraw of carriage-return progress and dimming compiler notes.
say_railed()
{
  local line

  while IFS= read -r line || [[ -n $line ]]; do
    line=${line##*$'\r'}
    case $line in
      ''|';')
        ;;
      ';'*)
        printf '%s│ %s%s\n' "$style_dim" "$line" "$style_reset" >&2
        ;;
      *)
        printf '%s│%s %s\n' "$style_dim" "$style_reset" "$line" >&2
        ;;
    esac
  done
}

release_field()
{
  sed -n "s/^$1=//p" "$release_record"
}

semantic_version_valid_p()
{
  [[ $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
}

release_tag_valid_p()
{
  [[ $1 =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]
}

legacy_release_platform_p()
{
  case $1 in
    x86_64-linux|arm64-darwin|x86_64-freebsd|x86_64-netbsd|x86_64-openbsd)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

semantic_version_newer_p()
{
  local candidate=$1
  local installed=$2
  local candidate_major candidate_minor candidate_patch
  local installed_major installed_minor installed_patch

  IFS=. read -r candidate_major candidate_minor candidate_patch <<< "$candidate"
  IFS=. read -r installed_major installed_minor installed_patch <<< "$installed"
  ((10#$candidate_major > 10#$installed_major)) ||
    ((10#$candidate_major == 10#$installed_major &&
      10#$candidate_minor > 10#$installed_minor)) ||
    ((10#$candidate_major == 10#$installed_major &&
      10#$candidate_minor == 10#$installed_minor &&
      10#$candidate_patch > 10#$installed_patch))
}

release_latest_tag()
{
  local effective_url
  local tag

  effective_url=$(curl --fail --silent --show-error --location \
    --max-time 5 --output /dev/null --write-out '%{url_effective}' \
    "$release_latest_url") || return 1
  tag=${effective_url##*/}
  release_tag_valid_p "$tag" || return 1
  printf '%s\n' "$tag"
}

release_update()
{
  local requested_tag=${1:-}
  local updated_launcher
  local -a install_arguments

  if [[ -z $requested_tag ]]; then
    if ! requested_tag=$(release_latest_tag); then
      say_notice "Autolith could not check the latest release. Keeping $release_version installed."
      return 1
    fi
  fi
  release_tag_valid_p "$requested_tag" ||
    fail "the requested release tag is malformed."
  if ! semantic_version_newer_p "${requested_tag#v}" "$release_version"; then
    say_done "Autolith $release_version is already the newest release."
    return 0
  fi
  install_arguments=(--without-command-link --version "$requested_tag")
  if [[ $release_platform == *-linux-musl ]]; then
    install_arguments=(--musl "${install_arguments[@]}")
  fi
  if ! AUTOLITH_INSTALL_ROOT="$install_root" \
       "$source_root/script/install" "${install_arguments[@]}"; then
    say_notice "Autolith could not install ${requested_tag#v}. Keeping $release_version installed."
    return 1
  fi

  updated_launcher=$install_root/current/bin/autolith
  [[ -x $updated_launcher ]] ||
    fail "the updater did not publish a runnable release."
}

release_restart()
{
  local launcher=$install_root/current/bin/autolith

  [[ -x $launcher ]] || fail "the selected release launcher is unavailable."
  export AUTOLITH_NO_UPDATE_CHECK=1
  export AUTOLITH_SUPPRESS_UPDATE_OFFER=1
  exec "$launcher" ${remaining_arguments[@]+"${remaining_arguments[@]}"}
}

release_images_usable_p()
{
  local active_manifest
  local recovery_manifest

  active_manifest=$(dirname -- "$active_core")/manifest.sexp
  recovery_manifest=$(dirname -- "$recovery_core")/manifest.sexp
  [[ -r $image_marker ]] || return 1
  [[ $(<"$image_marker") == "$release_tag:$release_platform" ]] || return 1
  [[ -f $active_core && -f $active_manifest ]] || return 1
  [[ -f $recovery_core && -f $recovery_manifest ]] || return 1
  grep -Eq '^\(:SBCL-GENERATIONS-IMAGE-MANIFEST :VERSION 1([[:space:]]|$)' \
    "$active_manifest" || return 1
  grep -Eq '^\(:RECOVERY-IMAGE :VERSION 2([[:space:]]|$)' \
    "$recovery_manifest" || return 1
  "$sbcl_command" --noinform --core "$recovery_core" \
    --end-runtime-options "$source_root" --probe >/dev/null 2>&1 || return 1
  "$sbcl_command" --noinform --core "$active_core" \
    --end-runtime-options "$source_root" \
    --autolith-internal-active-image-probe >/dev/null 2>&1
}

release_images_build()
{
  local marker_directory
  local temporary_marker

  say_section "Autolith images"
  say_note "building for this machine, once per release"
  "$sbcl_command" --script "$source_root/script/build-recovery.lisp" \
    "$recovery_core" 2>&1 | say_railed
  "$sbcl_command" --script "$source_root/script/build-active.lisp" \
    "$active_core" 2>&1 | say_railed
  marker_directory=$(dirname -- "$image_marker")
  mkdir -p -- "$marker_directory"
  temporary_marker=$marker_directory/.release-images.$$
  printf '%s:%s\n' "$release_tag" "$release_platform" > "$temporary_marker"
  chmod 600 "$temporary_marker"
  mv -f -- "$temporary_marker" "$image_marker"
  say_done "Autolith images are ready."
}

[[ -n $home ]] || fail "HOME is not set."
host_platform=
os=$(uname -s)
arch=$(uname -m)
case $os in
  Linux)
    case $arch in
      x86_64|amd64) host_platform=x86_64-linux ;;
      aarch64|arm64) host_platform=aarch64-linux ;;
    esac
    if [[ -n $host_platform ]]; then
      command -v ldd >/dev/null 2>&1 ||
        fail "Linux libc could not be identified because ldd is unavailable."
      libc_description=$(ldd /bin/sh 2>&1 || true)
      if grep -iq musl <<< "$libc_description"; then
        host_platform=${host_platform}-musl
      elif ! grep -Eiq 'glibc|gnu libc|ld-linux|libc\.so\.6' \
             <<< "$libc_description"; then
        fail "Linux libc could not be identified as glibc or musl."
      fi
    fi
    ;;
  Darwin)
    case $arch in
      x86_64|amd64) host_platform=x86_64-darwin ;;
      arm64|aarch64) host_platform=arm64-darwin ;;
    esac
    ;;
  FreeBSD)
    case $arch in
      amd64|x86_64) host_platform=x86_64-freebsd ;;
    esac
    ;;
  NetBSD)
    case $arch in
      amd64|x86_64) host_platform=x86_64-netbsd ;;
    esac
    ;;
  OpenBSD)
    case $arch in
      amd64|x86_64) host_platform=x86_64-openbsd ;;
    esac
    ;;
esac
[[ -n $host_platform ]] ||
  fail "binary releases currently support Linux x86-64, Linux aarch64, macOS x86-64, macOS arm64, FreeBSD x86-64, NetBSD x86-64, and OpenBSD x86-64 only."
if [[ $host_platform == *-linux-musl ]]; then
  fff_library=$sbcl_command
  colorlisp_library=$sbcl_command
elif [[ $host_platform == *-darwin ]]; then
  fff_library=$release_root/lib/libfff_c.dylib
  colorlisp_library=$release_root/lib/libcolorlisp-tree-sitter.dylib
else
  fff_library=$release_root/lib/libfff_c.so
  colorlisp_library=$release_root/lib/libcolorlisp-tree-sitter.so
fi

[[ -r $release_record ]] || fail "RELEASE is missing."
release_version=$(release_field version)
release_tag=$(release_field tag)
release_commit=$(release_field commit)
semantic_version_valid_p "$release_version" || fail "RELEASE has an invalid version."
[[ $release_tag == "v$release_version" ]] || fail "RELEASE has an inconsistent tag."
[[ $release_commit =~ ^[0-9a-f]{40}$ ]] || fail "RELEASE has an invalid commit."
if grep -q '^platform=' "$release_record"; then
  release_platform=$(release_field platform)
  [[ -n $release_platform ]] || fail "RELEASE has an invalid platform."
else
  legacy_release_platform_p "$host_platform" ||
    fail "RELEASE lacks platform identity for this release variant."
  release_platform=$host_platform
fi
[[ $release_platform == "$host_platform" ]] ||
  fail "RELEASE platform $release_platform does not match host $host_platform."
[[ -x $sbcl_command ]] || fail "the bundled SBCL runtime is missing."
[[ -f $runtime_source_root/version.lisp-expr ]] ||
  fail "the bundled SBCL source is missing."
[[ -f $source_root/autolith.asd && -f $source_root/.qlot/setup.lisp ]] ||
  fail "the bundled Autolith source or dependencies are missing."
[[ -x $source_root/script/install ]] || fail "the bundled installer is missing."
if [[ $release_platform == *-linux* ]]; then
  [[ -x $sandbox_helper ]] || fail "the private sandbox helper is missing."
fi
[[ -x $process_group_helper ]] ||
  fail "the private process-group helper is missing."
if [[ $release_platform != *-linux-musl ]]; then
  [[ -f $fff_library ]] || fail "the private search library is missing."
  [[ -f $colorlisp_library ]] || fail "the private syntax library is missing."
fi
command -v git >/dev/null 2>&1 || fail "Git is required."
if [[ $release_platform == *-linux* ]]; then
  command -v bwrap >/dev/null 2>&1 ||
    fail "Bubblewrap (bwrap) is required on Linux for filesystem and network isolation during sandboxed and safe automatic command execution. Install your distribution's bubblewrap package."
fi

releases_root=$(CDPATH= cd -P -- "$release_root/.." && pwd)
install_root=$(CDPATH= cd -P -- "$releases_root/.." && pwd)
selected_release_p=false
current_selected=$(resolve_path "$install_root/current" 2>/dev/null || true)
if [[ (${release_root##*/} == "$release_tag" ||
       ${release_root##*/} == "$release_tag-$release_platform") &&
      ${releases_root##*/} == releases &&
      "$current_selected" == "$release_root" ]]; then
  selected_release_p=true
fi

unset AUTOLITH_INSTALLATION_KIND AUTOLITH_RELEASE_ROOT
if [[ $selected_release_p == true ]]; then
  export AUTOLITH_INSTALLATION_KIND=release
  export AUTOLITH_RELEASE_ROOT=$release_root
fi

export AUTOLITH_SBCL=$sbcl_command
export AUTOLITH_SBCL_SOURCE_ROOT=$runtime_source_root
export AUTOLITH_FFF_LIBRARY=$fff_library
export COLORLISP_NATIVE_LIBRARY=$colorlisp_library
export AUTOLITH_ACTIVE_CORE=$active_core
export AUTOLITH_RECOVERY_CORE=$recovery_core
# The image build compiles the sandbox helpers into the source tree unless
# packaged copies are named here. The release tree is read-only.
export CL_EXEC_SANDBOX_PROCESS_GROUP_HELPER=$process_group_helper
if [[ $release_platform == *-linux* ]]; then
  export CL_EXEC_SANDBOX_BWRAP
  CL_EXEC_SANDBOX_BWRAP=$(command -v bwrap)
  export CL_EXEC_SANDBOX_HELPER=$sandbox_helper
fi
export GIT_OPTIONAL_LOCKS=0

remaining_arguments=("$@")
if [[ ${1:-} == --autolith-release-probe ]]; then
  printf 'version=%s\ntag=%s\ncommit=%s\nplatform=%s\nsource=%s\nruntime=%s\n' \
    "$release_version" "$release_tag" "$release_commit" "$release_platform" \
    "$source_root" "$sbcl_command"
  exit 0
fi
if [[ $update_requested == true ]]; then
  [[ $selected_release_p == true ]] ||
    fail "only the selected packaged release can update itself. Run the installed autolith command."
  release_update
  exit $?
fi

if ! release_images_usable_p; then
  release_images_build
fi

if "$source_root/bin/autolith" "$@"; then
  status=0
else
  status=$?
fi
if [[ $status -eq 76 && $selected_release_p == true ]]; then
  release_update || true
  release_restart
fi
exit "$status"
