;;;; -- Standalone Supervisor Subprocess Tests --

(require :asdf)

(let* ((root    (uiop:pathname-parent-directory-pathname *load-truename*))
       (runtime (namestring sb-ext:*runtime-pathname*))
       (prefix  (list runtime "--noinform" "--end-runtime-options"
                      "--no-sysinit" "--no-userinit" "--script"))
       (boot    (append prefix (list (namestring (merge-pathnames "bin/autolith-supervisor" root)))))
       (child   (append prefix (list (namestring (merge-pathnames "supervisor/test-child.lisp" root))))))
  (asdf:load-asd (merge-pathnames "autolith-supervisor.asd" root))
  (asdf:test-system '#:autolith-supervisor :verbose nil)
  (labels ((capture (arguments &optional (input ""))
             (uiop:run-program arguments
                               :input               (make-string-input-stream input)
                               :output ':string :error-output ':string
                               :ignore-error-status t))

           (check-echo (arguments expected)
             (multiple-value-bind (output errors status)
                 (capture arguments (format nil "terminal input~%"))
               (assert (= status 23))
               (let ((*read-eval* nil))
                 (destructuring-bind (argv input directory) (read-from-string output)
                   (assert (equal argv expected))
                   (assert (equal input "terminal input"))
                   (assert (equal directory (namestring root)))))
               (assert (search "child stderr" errors))
               errors)))
    (let ((arguments (list "a b" "" "$(not a shell)" "--flag" "quote\"slash\\"
                           "--core" "not-a-host-core")))
      (check-echo (append boot '("--") child '("echo") arguments) arguments)
      #-win32
      (check-echo (append boot '("--launcher" "/usr/bin/env" "--")
                          child '("echo") arguments)
                  arguments))
    (assert (search "wrapper" (check-echo (append child '("api")) '("api argument"))))
    (dolist (arguments '(nil ("--") ("--launcher") ("--launcher" "" "--" "command")
                         ("--unknown") ("--" "")))
      (multiple-value-bind (output errors status) (capture (append boot arguments))
        (declare (ignore output errors))
        (assert (= status 64))))
    (multiple-value-bind (output errors status)
        (capture (append boot '("--" "autolith-supervisor-nonexistent-executable")))
      (declare (ignore output))
      (assert (= status 70))
      (assert (search "Cannot start" errors)))
    (multiple-value-bind (output errors status)
        (capture (append boot '("--") child '("isolated")))
      (declare (ignore output errors))
      (assert (zerop status)))
    #-win32
    (dolist (signal (list sb-unix:sigint sb-unix:sigterm sb-unix:sighup))
      (let ((process (uiop:launch-program (append boot '("--") child '("sleep"))
                                          :output ':stream :error-output ':stream)))
        (unwind-protect
             (let* ((line (read-line (uiop:process-info-output process)))
                    (pid  (parse-integer line)))
               (uiop:run-program (list "/bin/kill" (format nil "-~d" signal)
                                       (write-to-string (uiop:process-info-pid process))))
               (assert (= (+ 128 signal) (uiop:wait-process process)))
               (multiple-value-bind (output errors status)
                   (capture (list "/bin/kill" "-0" (write-to-string pid)))
                 (declare (ignore output errors))
                 (assert (not (zerop status)))))
          (when (uiop:process-alive-p process)
            (uiop:terminate-process process :urgent t))
          (uiop:wait-process process)
          (close (uiop:process-info-output process))
          (close (uiop:process-info-error-output process)))))
    (write-line "Supervisor subprocess tests passed.")))
