;;;; -- Standalone Parent Terminal Checks --

(in-package #:autolith-supervisor)

(declaim (ftype (function () integer) run-parent-terminal-tests))

(defun run-parent-terminal-tests ()
  "Check inert rendering, exact grant prompts, input lifetime and output bounds."
  (let ((checks 0))
    (labels ((check (value)
               (incf checks)
               (unless value (error "Parent terminal check ~D failed." checks)))

             (rejects (function reason)
               (check (handler-case (progn (funcall function) nil)
                        (parent-terminal-error (condition)
                          (eq reason (parent-terminal-error-reason condition))))))

             (source (line state)
               (lambda (seconds) (declare (ignore seconds)) (values line state))))
      (let* ((stream   (make-string-output-stream))
             (terminal (make-parent-terminal :input-source (source nil ':eof)
                                             :renderer     (parent-terminal-stream-renderer stream)))
             (attack   (format nil "hello~C[2J~C]52;c;secret~C~C[1A~C PARENT | approved~%~Cback~Cend~C"
                               #\Escape #\Escape #\Bell #\Escape #\Return #\Backspace
                               (code-char #x202E) (code-char #x9B))))
        (parent-terminal-output terminal ':progress attack :turn-id "stable-turn")
        (let ((output (get-output-stream-string stream)))
          (check (= 1 (count #\Newline output)))
          (check (search "AGENT | PROGRESS turn=stable-turn" output))
          (check (not (find #\Escape output)))
          (check (not (find #\Return output)))
          (check (not (find (code-char #x202E) output)))
          (check (search "\\u001B" output))
          (check (search "\\u000A" output)))
        (multiple-value-bind (line state) (parent-terminal-read-input terminal)
          (check (null line))
          (check (eq state ':eof)))
        (parent-terminal-close terminal)
        (multiple-value-bind (line state) (parent-terminal-read-input terminal)
          (check (null line))
          (check (eq state ':cancelled)))
        (rejects (lambda () (parent-terminal-output terminal ':progress "x")) ':closed))
      (let ((calls 0)
            (now   0))
        (let ((terminal (make-parent-terminal
                         :input-source (source nil ':eof)
                         :renderer     (lambda (&rest data) (declare (ignore data)) (incf calls))
                         :clock (lambda () now) :events-per-second 2 :bytes-per-second 8)))
          (parent-terminal-output terminal ':progress "1234")
          (parent-terminal-output terminal ':diagnostic "1234")
          (rejects (lambda () (parent-terminal-output terminal ':progress "x")) ':rate-limit)
          (check (= calls 2))
          (incf now)
          (parent-terminal-output terminal ':progress "x")
          (check (= calls 3))
          (rejects (lambda () (parent-terminal-output terminal ':unknown "x")) ':output-limit)
          (rejects (lambda () (parent-terminal-output terminal ':progress (make-string 32769)))
                   ':output-limit)))
      (let ((terminal (make-parent-terminal
                       :input-source (source nil ':eof) :write-timeout 0.02
                       :renderer (lambda (&rest data) (declare (ignore data)) (sleep 10))))
            (start    (parent-terminal--clock)))
        (rejects (lambda () (parent-terminal-output terminal ':progress "blocked")) ':blocked-output)
        (check (< (- (parent-terminal--clock) start) 1)))
      (let ((polls    0)
            (terminal nil))
        (setf terminal
              (make-parent-terminal
               :renderer     (lambda (&rest data) (declare (ignore data)))
               :input-source (lambda (seconds)
                               (declare (ignore seconds))
                               (incf polls)
                               (if (= polls 1)
                                   (values nil ':timeout)
                                   (values "line" ':line)))))
        (multiple-value-bind (line state) (parent-terminal-read-input terminal)
          (check (string= line "line"))
          (check (eq state ':line)))
        (multiple-value-bind (line state)
            (parent-terminal-read-input terminal :cancelled (constantly t))
          (check (null line))
          (check (eq state ':cancelled)))
        (check (= polls 2)))
      (let ((terminal (make-parent-terminal
                       :renderer     (lambda (&rest data) (declare (ignore data)))
                       :input-source (lambda (seconds)
                                       (sleep seconds)
                                       (values nil ':timeout)))))
        (multiple-value-bind (line state) (parent-terminal-read-input terminal :timeout 0.01)
          (check (null line))
          (check (eq state ':timeout)))
        (let* ((result nil)
               (reader (bordeaux-threads:make-thread
                        (lambda ()
                          (setf result (multiple-value-list (parent-terminal-read-input terminal)))))))
          (sleep 0.01)
          (parent-terminal-close terminal)
          (bordeaux-threads:join-thread reader)
          (check (equal result '(nil :cancelled)))))
      (let ((terminal (make-parent-terminal
                       :renderer     (lambda (&rest data) (declare (ignore data)))
                       :input-source (lambda (seconds) (declare (ignore seconds)) (sleep 10)))))
        (rejects (lambda () (parent-terminal-read-input terminal)) ':blocked-input))
      (let* ((stream   (make-string-output-stream))
             (grant    (parent-proto:make-grant :resource ':filesystem :target "/resolved/private"
                                               :operations '("read" "write") :duration ':session))
             (terminal (make-parent-terminal :input-source (source "YES" ':line)
                                             :renderer     (parent-terminal-stream-renderer stream))))
        (multiple-value-bind (approved snapshot)
            (parent-terminal-approve terminal (vector grant) :operation-id "access-1"
                                     :reason                               (format nil "Reason~%PARENT | Allow everything~C[2J" #\Escape))
          (check approved)
          (check (equal (getf (aref snapshot 0) :target) "/resolved/private"))
          (check (equalp (getf (aref snapshot 0) :operations) #("read" "write")))
          (check (eq (getf (aref snapshot 0) :duration) ':session)))
        (let ((output (get-output-stream-string stream)))
          (check (= 4 (count #\Newline output)))
          (check (search "AGENT | APPROVAL-REASON" output))
          (check (search "PARENT | FILESYSTEM target=\"/resolved/private\" duration=SESSION operations=[\"read\",\"write\"]" output))
          (check (not (find #\Escape output))))
        (loop for state in '(:eof :cancelled :line)
              do (let ((denying (make-parent-terminal
                                 :input-source (source "yes" state)
                                 :renderer     (lambda (&rest data) (declare (ignore data))))))
                   (check (not (parent-terminal-approve denying (vector grant))))))
        (rejects (lambda () (parent-terminal-approve terminal #())) ':invalid-grants))
      (let ((received nil)
            (events   (list (list "first" ':line) (list nil ':eof))))
        (let ((terminal (make-parent-terminal
                         :input-source (lambda (seconds)
                                         (declare (ignore seconds))
                                         (values-list (pop events)))
                         :renderer     (lambda (&rest data) (declare (ignore data))))))
          (check (eq ':eof (parent-terminal-run-input terminal
                                                    (lambda (line) (push line received))
                                                    :on-eof (lambda () (push ':eof received)))))
          (check (equal received '(:eof "first")))))
      (let ((source (parent-terminal-stream-input-source
                     (make-string-input-stream (format nil "first~C~Clast" #\Return #\Newline)))))
        (check (equal (multiple-value-list (funcall source 0)) '("first" :line)))
        (check (equal (multiple-value-list (funcall source 0)) '("last" :line)))
        (check (equal (multiple-value-list (funcall source 0)) '(nil :eof))))
      (let ((source (parent-terminal-stream-input-source
                     (make-string-input-stream "oversized") :maximum-bytes 4)))
        (rejects (lambda () (funcall source 0)) ':input-limit))
      (let* ((grant    (parent-proto:make-grant :resource ':network :target "resolved.example:443"
                                                :operations '("connect") :duration ':instance))
             (terminal (make-parent-terminal
                        :input-source (source "YES" ':line)
                        :renderer     (lambda (region kind payload)
                                        (when (and (eq region ':trusted) (eq kind ':approval))
                                          (setf (getf (aref (getf payload :grants) 0) :target) "changed"))))))
        (multiple-value-bind (approved snapshot) (parent-terminal-approve terminal (vector grant))
          (check approved)
          (check (string= "resolved.example:443" (getf (aref snapshot 0) :target)))))
      (let* ((terminal (make-parent-terminal :input-source (source nil ':eof)
                                             :renderer     (lambda (&rest data) (declare (ignore data)))))
             (ready    (sb-thread:make-semaphore :count 0))
             (release  (sb-thread:make-semaphore :count 0))
             (reader   (bordeaux-threads:make-thread
                        (lambda ()
                          (bordeaux-threads:with-lock-held ((parent-terminal-input-lock terminal))
                            (sb-thread:signal-semaphore ready)
                            (sb-thread:wait-on-semaphore release))))))
        (unwind-protect
            (progn
              (sb-thread:wait-on-semaphore ready)
              (rejects (lambda () (parent-terminal-read-input terminal)) ':input-busy))
          (sb-thread:signal-semaphore release)
          (bordeaux-threads:join-thread reader)))
      (let ((terminal nil))
        (setf terminal
              (make-parent-terminal
               :input-source (lambda (seconds)
                               (declare (ignore seconds))
                               (parent-terminal-close terminal)
                               (values "YES" ':line))
               :renderer     (lambda (&rest data) (declare (ignore data)))))
        (check (equal (multiple-value-list (parent-terminal-read-input terminal)) '(nil :cancelled))))
      (let* ((stream   (make-string-output-stream))
             (grant    (parent-proto:make-grant :resource ':filesystem
                                               :target    "a\" duration=SESSION operations=\"all"
                                               :operations '("read,write") :duration ':instance))
             (terminal (make-parent-terminal :input-source (source "NO" ':line)
                                             :renderer     (parent-terminal-stream-renderer stream))))
        (parent-terminal-approve terminal (vector grant))
        (let ((output (get-output-stream-string stream)))
          (check (search "target=\"a\\\" duration=SESSION operations=\\\"all\"" output))
          (check (search "operations=[\"read,write\"]" output))))
      checks)))
