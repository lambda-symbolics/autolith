;;;; -- Optional Parent Model Runtime Checks --

(in-package #:autolith-supervisor)

(defclass model-service-test-gate ()
  ((lock :initform (bordeaux-threads:make-lock "model test gate")
         :reader model-service-test-gate-lock :documentation "Protects the gate.")
   (ready :initform (bordeaux-threads:make-condition-variable)
          :reader model-service-test-gate-ready :documentation "Notifies a gate transition.")
   (open :initform nil :accessor model-service-test-gate-open
         :documentation "True after release."))
  (:documentation "Deterministic executor, transport and storage ordering."))

(declaim (ftype (function (model-service-test-gate) null) model-service-test--release))

(defun model-service-test--release (gate)
  "Release one waiter without running work under the gate lock."
  (bordeaux-threads:with-lock-held ((model-service-test-gate-lock gate))
    (setf (model-service-test-gate-open gate) t)
    (bordeaux-threads:condition-notify (model-service-test-gate-ready gate)))
  nil)

(declaim (ftype (function (model-service-test-gate) null) model-service-test--wait))

(defun model-service-test--wait (gate)
  "Wait for a gate, with a test failure instead of an unbounded hang."
  (sb-ext:with-timeout 5
    (bordeaux-threads:with-lock-held ((model-service-test-gate-lock gate))
      (loop until (model-service-test-gate-open gate)
            do (bordeaux-threads:condition-wait (model-service-test-gate-ready gate)
                                              (model-service-test-gate-lock gate)))))
  nil)

(declaim (ftype (function (model-service) null) model-service-test--settle))

(defun model-service-test--settle (service)
  "Wait for admitted executor cleanup and then for all delivery receipts."
  (let ((mailbox (model-service-mailbox service)))
    (sb-ext:with-timeout 5
      (bordeaux-threads:with-lock-held ((model-runtime-mailbox-lock mailbox))
        (loop while (model-service-active service)
              do (bordeaux-threads:condition-wait (model-runtime-mailbox-ready mailbox)
                                                (model-runtime-mailbox-lock mailbox) :timeout 0.05))))
    (model-runtime--call mailbox (constantly nil) :delivery t))
  nil)

(declaim (ftype (function (&key (:kind keyword) (:turn string)) parent-proto:envelope)
                model-service-test--start))

(defun model-service-test--start (&key (kind ':generate) (turn "turn"))
  "Build one ordinary request for the trusted fixture profile."
  (parent-proto:make-envelope :model-start
                             (parent-proto:make-model-start :turn-id turn :profile-id "profile" :kind kind)))

(declaim (ftype (function (integer) parent-proto:envelope) model-service-test--cancel))

(defun model-service-test--cancel (target)
  "Build a correlated cancellation request."
  (parent-proto:make-envelope :cancel-request (parent-proto:make-cancel-request :request-id target)))

(declaim (ftype (function (t function) model-wire:provider-result) model-service-test--answer))

(defun model-service-test--answer (invocation callback)
  "Emit one actual pinned-library item and return its exact ordered result."
  (declare (ignore invocation))
  (let ((item (model-event-test--text)))
    (funcall callback (make-instance 'model-wire:provider-item-event :item item))
    (make-instance 'model-wire:provider-result :output-items (list item))))

(declaim (ftype (function (function &key (:executor function) (:abort function)
                                      (:maximum-attempts integer) (:output t)) t)
                model-service-test--fixture))

(defun model-service-test--fixture (function &key (executor #'model-service-test--answer)
                                                (abort (constantly nil)) (maximum-attempts 1) output)
  "Supply real journals, framed input and an optional controlled output stream."
  (let* ((directory (merge-pathnames (format nil "model-runtime-~36R/" (random (expt 36 20) (make-random-state t)))
                                    (uiop:temporary-directory)))
         (runtime   nil))
    (ensure-directories-exist directory)
    (unwind-protect
         (uiop:with-temporary-file (:stream input :element-type '(unsigned-byte 8))
           (uiop:with-temporary-file (:stream captured :element-type '(unsigned-byte 8))
             (let* ((store      (session-store-open (merge-pathnames "session.sexp" directory) "session"))
                    (replay     (model-replay-store-open (merge-pathnames "model.sexp" directory) "session"))
                    (profiles   (make-hash-table :test 'equal))
                    (connection (make-instance 'parent-connection :input input :output (or output captured)
                                                :instance-id "instance"))
                    (clock      (list 10))
                    (service    (make-model-service :profiles profiles :replay-store replay :executor executor
                                                    :abort abort :clock (lambda () (first clock)) :timeout 20
                                                    :maximum-attempts maximum-attempts))
                    (next-id 0) (read-position 0))
               (setf (gethash "profile" profiles)
                     (make-model-profile :id "profile" :model "model" :family ':responses)
                     (parent-connection-phase connection) ':ready
                     runtime (session-runtime-open store connection :model-service service
                                                   :features                       '("session.v1" "model.v1" "model-items-v1")))
               (session-runtime-start-turn runtime "turn" "input")
               (model-runtime--call (model-service-mailbox service) (constantly nil) :delivery t)
               (labels ((receive (envelope)
                          (setf (parent-proto:envelope.protocol-major envelope) 1
                                (parent-proto:envelope.instance-id envelope) "instance"
                                (parent-proto:envelope.message-id envelope) (incf next-id))
                          (file-position input :end)
                          (let ((position (file-position input)))
                            (protocol-write-frame input (cl-protobufs:serialize-to-bytes envelope))
                            (file-position input position)
                            (session-runtime-receive runtime))
                          next-id)

                        (responses ()
                          (model-runtime--call (model-service-mailbox service) (constantly nil) :delivery t)
                          (with-open-file (source (pathname captured) :element-type '(unsigned-byte 8))
                            (file-position source read-position)
                            (loop for bytes = (protocol-read-frame source)
                                  while bytes
                                  collect (cl-protobufs:deserialize-from-bytes 'parent-proto:envelope bytes)
                                  do (setf read-position (file-position source))))))
                 (funcall function :runtime runtime :service service :receive #'receive :responses #'responses
                                   :clock clock)))))
      (when runtime
        (session-runtime-disconnect runtime)
        (session-runtime-await-close runtime :timeout 5))
      (dolist (file (uiop:directory-files directory)) (delete-file file))
      (uiop:delete-empty-directory directory))))

(declaim (ftype (function () null) model-service-test--closure))

(defun model-service-test--closure ()
  "Require explicit transport closure before acceptance; cancellation can still win."
  (dolist (cancel '(nil t))
    (let ((closing (make-instance 'model-service-test-gate))
          (release (make-instance 'model-service-test-gate)))
      (unwind-protect
           (model-service-test--fixture
            (lambda (&key runtime service receive responses clock)
              (declare (ignore runtime clock))
              (funcall receive (model-service-test--start))
              (model-service-test--wait closing)
              (model-runtime--call
               (model-service-mailbox service)
               (lambda ()
                 (let ((active (model-service-active service)))
                   (assert (model-invocation-returned active))
                   (assert (null (model-invocation-terminal active))))))
              (when cancel (funcall receive (model-service-test--cancel 1)))
              (model-service-test--release release)
              (model-service-test--settle service)
              (let* ((frames   (funcall responses))
                     (terminal (find-if (lambda (frame)
                                          (let ((event (parent-proto:envelope.model-event frame)))
                                            (and event (or (parent-proto:model-event.has-complete event)
                                                           (parent-proto:model-event.has-failed event))))) frames)))
                (assert terminal)
                (assert (= 1 (parent-proto:envelope.reply-to terminal)))
                (if cancel
                    (progn
                      (assert (eq ':cancelled (parent-proto:failure.code
                                               (parent-proto:model-event.failed
                                                (parent-proto:envelope.model-event terminal)))))
                      (let ((ack (find-if #'parent-proto:envelope.has-cancel-ack frames)))
                        (assert (= 2 (parent-proto:envelope.reply-to ack)))
                        (assert (not (parent-proto:cancel-ack.already-terminal
                                      (parent-proto:envelope.cancel-ack ack))))))
                    (assert (parent-proto:model-event.has-complete (parent-proto:envelope.model-event terminal))))))
            :abort (lambda (invocation)
                     (declare (ignore invocation))
                     (model-service-test--release closing)
                     (model-service-test--wait release)))
        (model-service-test--release release))))
  nil)

(declaim (ftype (function () null) model-service-test--blocked-owner))

(defun model-service-test--blocked-owner ()
  "Cancel or expire behind blocked storage. Abort must run before the owner resumes."
  (dolist (deadline '(nil t))
    (let ((executing        (make-instance 'model-service-test-gate))
          (executor-release (make-instance 'model-service-test-gate))
          (owner-entered    (make-instance 'model-service-test-gate))
          (owner-release    (make-instance 'model-service-test-gate))
          (aborted          (make-instance 'model-service-test-gate)))
      (unwind-protect
           (model-service-test--fixture
            (lambda (&key runtime service receive responses clock)
              (funcall receive (model-service-test--start))
              (model-service-test--wait executing)
              (model-runtime--call (model-service-mailbox service)
                                   (lambda ()
                                     (model-service-test--release owner-entered)
                                     (model-service-test--wait owner-release)) :wait nil)
              (model-service-test--wait owner-entered)
              (if deadline
                  (progn (setf (first clock) 40) (session-runtime-expire runtime))
                  (funcall receive (model-service-test--cancel 1)))
              (model-service-test--wait aborted)
              (assert (not (model-service-test-gate-open owner-release)))
              (model-service-test--release owner-release)
              (model-service-test--settle service)
              (let* ((frames (funcall responses))
                     (failed (find-if (lambda (frame)
                                        (let ((event (parent-proto:envelope.model-event frame)))
                                          (and event (parent-proto:model-event.has-failed event)))) frames)))
                (assert (eq (if deadline ':unavailable ':cancelled)
                            (parent-proto:failure.code (parent-proto:model-event.failed
                                                        (parent-proto:envelope.model-event failed)))))))
            :executor (lambda (invocation callback)
                        (model-service-test--release executing)
                        (model-service-test--wait executor-release)
                        ;; A late event must be suppressed after the reader's latch.
                        (assert (handler-case (progn (model-service-test--answer invocation callback) nil)
                                  (model-service-cancelled () t)))
                        nil)
            :abort    (lambda (invocation)
                        (declare (ignore invocation))
                        (model-service-test--release executor-release)
                        (model-service-test--release aborted)))
        (model-service-test--release owner-release)
        (model-service-test--release executor-release))))
  nil)

(declaim (ftype (function () null) model-service-test--pending-cancel))

(defun model-service-test--pending-cancel ()
  "Cancel a start while it still waits behind another owner operation."
  (let ((entered (make-instance 'model-service-test-gate))
        (release (make-instance 'model-service-test-gate))
        (calls   0))
    (unwind-protect
         (model-service-test--fixture
          (lambda (&key runtime service receive responses clock)
            (declare (ignore runtime clock))
            (model-runtime--call (model-service-mailbox service)
                                 (lambda ()
                                   (model-service-test--release entered)
                                   (model-service-test--wait release)) :wait nil)
            (model-service-test--wait entered)
            (funcall receive (model-service-test--start))
            (funcall receive (model-service-test--cancel 1))
            (model-service-test--release release)
            (model-runtime--call (model-service-mailbox service) (constantly nil))
            (model-service-test--settle service)
            (assert (zerop calls))
            (let* ((frames (funcall responses))
                   (ack    (find-if #'parent-proto:envelope.has-cancel-ack frames)))
              (assert ack)
              (assert (not (parent-proto:cancel-ack.already-terminal (parent-proto:envelope.cancel-ack ack))))))
          :executor (lambda (invocation callback)
                      (incf calls)
                      (model-service-test--answer invocation callback)))
      (model-service-test--release release)))
  nil)

(declaim (ftype (function () null) model-service-test--commit-failure))

(defun model-service-test--commit-failure ()
  "Recover a committed acceptance after a hook error and concurrent cancellation."
  (let ((executing        (make-instance 'model-service-test-gate))
        (executor-release (make-instance 'model-service-test-gate))
        (committed        (make-instance 'model-service-test-gate))
        (commit-release   (make-instance 'model-service-test-gate))
        (invocation       nil))
    (unwind-protect
         (model-service-test--fixture
          (lambda (&key runtime service receive responses clock)
            (declare (ignore responses clock))
            (funcall receive (model-service-test--start))
            (model-service-test--wait executing)
            (model-runtime--call
             (model-service-mailbox service)
             (lambda ()
               (let* ((collector (model-invocation-collector invocation))
                      (accept    (model-event-collector-accept-result collector)))
                 (setf (slot-value collector 'accept-result)
                       (lambda (complete)
                         (funcall accept complete)
                         (model-service-test--release committed)
                         (model-service-test--wait commit-release)
                         (error 'parent-protocol-error :reason ':test-after-commit))))))
            (model-service-test--release executor-release)
            (model-service-test--wait committed)
            (funcall receive (model-service-test--cancel 1))
            (model-service-test--release commit-release)
            ;; This owner call may be cancelled by closure. Cleanup must still join it.
            (handler-case (model-runtime--call (model-service-mailbox service) (constantly nil))
              (parent-protocol-error () nil))
            (session-runtime-disconnect runtime)
            (session-runtime-await-close runtime :timeout 5)
            (assert (eq ':accepted (model-replay-store-status (model-service-replay-store service)
                                                             (model-invocation-request-id invocation))))
            (assert (zerop (length (model-replay-store-pending-projections (model-service-replay-store service)))))
            (let ((events (model-replay-store-events (model-service-replay-store service)
                                                     (model-invocation-request-id invocation))))
              (assert (gethash "complete" (aref events (1- (length events)))))
              (assert (notany (lambda (event) (gethash "failed" event)) events))))
          :executor (lambda (call callback)
                      (setf invocation call)
                      (model-service-test--release executing)
                      (model-service-test--wait executor-release)
                      (model-service-test--answer call callback)))
      (model-service-test--release executor-release)
      (model-service-test--release commit-release)))
  nil)

(declaim (ftype (function () null) model-service-test--uncertain-item))

(defun model-service-test--uncertain-item ()
  "Interrupt an uncertain item write without inventing a stale-index failure."
  (let ((executing  (make-instance 'model-service-test-gate))
        (release    (make-instance 'model-service-test-gate))
        (invocation nil))
    (unwind-protect
         (model-service-test--fixture
          (lambda (&key runtime service receive responses clock)
            (declare (ignore responses clock))
            (funcall receive (model-service-test--start))
            (model-service-test--wait executing)
            (model-runtime--call
             (model-service-mailbox service)
             (lambda ()
               (let* ((collector (model-invocation-collector invocation))
                      (record    (model-event-collector-record-item collector)))
                 (setf (slot-value collector 'record-item)
                       (lambda (&rest arguments)
                         (apply record arguments)
                         (error 'parent-protocol-error :reason ':test-after-item-write))))))
            (model-service-test--release release)
            ;; A control gate in the executor runs before the independent RETURNED slot.
            (model-service-test--wait executing)
            (handler-case (model-service-test--settle service)
              (parent-protocol-error () nil))
            (session-runtime-disconnect runtime)
            (session-runtime-await-close runtime :timeout 5)
            (assert (eq ':interrupted (model-replay-store-status (model-service-replay-store service)
                                                                (model-invocation-request-id invocation))))
            (assert (notany (lambda (event) (gethash "failed" event))
                            (model-replay-store-events (model-service-replay-store service)
                                                       (model-invocation-request-id invocation)))))
          :executor (lambda (call callback)
                      (setf invocation call)
                      (model-service-test--release executing)
                      (model-service-test--wait release)
                      (model-service-test--answer call callback)))
      (model-service-test--release release)))
  nil)

(declaim (ftype (function () null) model-service-test--cleanup-timeout))

(defun model-service-test--cleanup-timeout ()
  "A return from abort does not prove executor cleanup; a timeout denies store reuse."
  (let ((executing (make-instance 'model-service-test-gate))
        (release   (make-instance 'model-service-test-gate))
        (aborted   (make-instance 'model-service-test-gate)))
    (unwind-protect
         (model-service-test--fixture
          (lambda (&key runtime service receive responses clock)
            (declare (ignore service responses clock))
            (funcall receive (model-service-test--start))
            (model-service-test--wait executing)
            (session-runtime-disconnect runtime)
            (model-service-test--wait aborted)
            (assert (handler-case (progn (session-runtime-await-close runtime :timeout 0.01) nil)
                      (parent-protocol-error (condition)
                        (eq ':close-timeout (parent-protocol-error-reason condition)))))
            (model-service-test--release release)
            (session-runtime-await-close runtime :timeout 5))
          :executor (lambda (call callback)
                      (declare (ignore call callback))
                      (model-service-test--release executing)
                      (model-service-test--wait release)
                      nil)
          :abort    (lambda (call)
                      (declare (ignore call))
                      (model-service-test--release aborted)))
      (model-service-test--release release)))
  nil)

(declaim (ftype (function () null) model-service-test--acceptance-overlap))

(defun model-service-test--acceptance-overlap ()
  "Resolve cancellation received during acceptance from the actual durable outcome."
  (let ((executing        (make-instance 'model-service-test-gate))
        (executor-release (make-instance 'model-service-test-gate))
        (accepting        (make-instance 'model-service-test-gate))
        (accept-release   (make-instance 'model-service-test-gate))
        (invocation       nil))
    (unwind-protect
         (model-service-test--fixture
          (lambda (&key runtime service receive responses clock)
            (declare (ignore runtime clock))
            (funcall receive (model-service-test--start))
            (model-service-test--wait executing)
            (model-runtime--call
             (model-service-mailbox service)
             (lambda ()
               (let* ((collector (model-invocation-collector invocation))
                      (accept    (model-event-collector-accept-result collector)))
                 (setf (slot-value collector 'accept-result)
                       (lambda (complete)
                         (assert (model-invocation-accepting invocation))
                         (model-service-test--release accepting)
                         (model-service-test--wait accept-release)
                         (funcall accept complete))))))
            (model-service-test--release executor-release)
            (model-service-test--wait accepting)
            (funcall receive (model-service-test--cancel 1))
            (assert (model-invocation-cancelled-p service invocation))
            (model-service-test--release accept-release)
            (model-service-test--settle service)
            (let* ((frames (funcall responses))
                   (ack    (find-if #'parent-proto:envelope.has-cancel-ack frames)))
              (assert ack)
              (assert (parent-proto:cancel-ack.already-terminal (parent-proto:envelope.cancel-ack ack)))
              (assert (= 1 (count-if (lambda (frame)
                                      (let ((event (parent-proto:envelope.model-event frame)))
                                        (and event (parent-proto:model-event.has-complete event)))) frames)))
              (assert (eq ':accepted (model-replay-store-status (model-service-replay-store service)
                                                               (model-invocation-request-id invocation))))))
          :executor (lambda (call callback)
                      (setf invocation call)
                      (model-service-test--release executing)
                      (model-service-test--wait executor-release)
                      (model-service-test--answer call callback)))
      (model-service-test--release executor-release)
      (model-service-test--release accept-release)))
  nil)

(declaim (ftype (function () null) model-service-test--backpressure))

(defun model-service-test--backpressure ()
  "Keep cancellation and abort independent of a blocked current frame write."
  (let ((output           (make-instance 'session-dispatch-test-output))
        (executing        (make-instance 'model-service-test-gate))
        (executor-release (make-instance 'model-service-test-gate))
        (aborted          (make-instance 'model-service-test-gate)))
    (unwind-protect
         (model-service-test--fixture
          (lambda (&key runtime service receive responses clock)
            (declare (ignore runtime responses clock))
            (setf (session-dispatch-test-output-blocked output) t)
            (funcall receive (model-service-test--start))
            (model-service-test--wait executing)
            (sb-ext:with-timeout 5
              (bordeaux-threads:with-lock-held ((session-dispatch-test-output-lock output))
                (loop until (session-dispatch-test-output-entered output)
                      do (bordeaux-threads:condition-wait (session-dispatch-test-output-condition output)
                                                        (session-dispatch-test-output-lock output)))))
            (let ((mailbox (model-service-mailbox service)))
              (bordeaux-threads:with-lock-held ((model-runtime-mailbox-lock mailbox))
                (let ((write (model-runtime-mailbox-writing mailbox)))
                  (assert write)
                  (assert (>= (model-runtime-mailbox-data-bytes mailbox)
                              (+ 4 (length (model-runtime-write-bytes write)))))))
              (funcall receive (model-service-test--cancel 1))
              (model-service-test--wait aborted)
              (assert (not (session-dispatch-test-output-released output)))
              (sb-ext:with-timeout 5
                (bordeaux-threads:with-lock-held ((model-runtime-mailbox-lock mailbox))
                  (loop while (model-service-active service)
                        do (bordeaux-threads:condition-wait (model-runtime-mailbox-ready mailbox)
                                                          (model-runtime-mailbox-lock mailbox) :timeout 0.05))))
              (bordeaux-threads:with-lock-held ((model-runtime-mailbox-lock mailbox))
                (assert (plusp (model-runtime-mailbox-control-bytes mailbox))))
              (bordeaux-threads:with-lock-held ((session-dispatch-test-output-lock output))
                (setf (session-dispatch-test-output-released output) t)
                (bordeaux-threads:condition-notify (session-dispatch-test-output-condition output)))
              (model-service-test--settle service)))
          :output   output
          :executor (lambda (invocation callback)
                      (declare (ignore invocation callback))
                      (model-service-test--release executing)
                      (model-service-test--wait executor-release)
                      nil)
          :abort    (lambda (invocation)
                      (declare (ignore invocation))
                      (model-service-test--release executor-release)
                      (model-service-test--release aborted)))
      (model-service-test--release executor-release)
      (bordeaux-threads:with-lock-held ((session-dispatch-test-output-lock output))
        (setf (session-dispatch-test-output-released output) t)
        (bordeaux-threads:condition-notify (session-dispatch-test-output-condition output)))))
  nil)

(declaim (ftype (function () null) model-service-test--late-cancel))

(defun model-service-test--late-cancel ()
  "A committed failure wins cancellation before the owner clears its active slot."
  (let ((executing        (make-instance 'model-service-test-gate))
        (executor-release (make-instance 'model-service-test-gate))
        (failed           (make-instance 'model-service-test-gate))
        (failure-release  (make-instance 'model-service-test-gate))
        (invocation       nil))
    (unwind-protect
         (model-service-test--fixture
          (lambda (&key runtime service receive responses clock)
            (declare (ignore runtime clock))
            (funcall receive (model-service-test--start))
            (model-service-test--wait executing)
            (model-runtime--call
             (model-service-mailbox service)
             (lambda ()
               (let* ((collector (model-invocation-collector invocation))
                      (emit      (model-event-collector-emit-event collector)))
                 (setf (slot-value collector 'emit-event)
                       (lambda (event)
                         (funcall emit event)
                         (when (parent-proto:model-event.has-failed event)
                           (model-service-test--release failed)
                           (model-service-test--wait failure-release)))))))
            (model-service-test--release executor-release)
            (model-service-test--wait failed)
            (assert (eq ':terminal-failed (model-replay-store-status (model-service-replay-store service)
                                                                   (model-invocation-request-id invocation))))
            (funcall receive (model-service-test--cancel 1))
            (model-service-test--release failure-release)
            (model-service-test--settle service)
            (let* ((frames (funcall responses))
                   (ack    (find-if #'parent-proto:envelope.has-cancel-ack frames)))
              (assert ack)
              (assert (parent-proto:cancel-ack.already-terminal (parent-proto:envelope.cancel-ack ack)))))
          :executor (lambda (call callback)
                      (declare (ignore callback))
                      (setf invocation call)
                      (model-service-test--release executing)
                      (model-service-test--wait executor-release)
                      nil))
      (model-service-test--release executor-release)
      (model-service-test--release failure-release)))
  nil)

(declaim (ftype (function () null) model-service-test--deadline-cancel-ack))

(defun model-service-test--deadline-cancel-ack ()
  "A deadline latched after the owner pre-pass wins an active-target cancellation."
  (let ((executing        (make-instance 'model-service-test-gate))
        (executor-release (make-instance 'model-service-test-gate)))
    (unwind-protect
         (model-service-test--fixture
          (lambda (&key runtime service receive responses clock)
