;;;; -- Standalone Parent Protocol Checks --

(require :asdf)

(let ((root (uiop:pathname-parent-directory-pathname *load-truename*)))
  (load (merge-pathnames ".qlot/setup.lisp" root))
  (asdf:load-asd (merge-pathnames "autolith-protocol.asd" root))
  (asdf:load-asd (merge-pathnames "autolith-supervisor.asd" root))
  (assert (not (find-package '#:autolith)))
  (asdf:test-system '#:autolith-supervisor/protocol :verbose nil)
  (asdf:test-system '#:autolith-supervisor/session :verbose nil)
  (asdf:test-system '#:autolith-supervisor/model :verbose nil)
  (asdf:test-system '#:autolith-supervisor/accounts :verbose nil)
  (asdf:test-system '#:autolith-supervisor/family-accounts :verbose nil)
  (asdf:test-system '#:autolith-supervisor/provider-family-domain :verbose nil)
  (asdf:test-system '#:autolith-supervisor/provider-executor :verbose nil)
  (asdf:test-system '#:autolith-supervisor/provider-families :verbose nil)
  (asdf:test-system '#:autolith-supervisor/private-process :verbose nil)
  (asdf:test-system '#:autolith-supervisor/terminal :verbose nil)
  (asdf:test-system '#:autolith-supervisor/agenda-service :verbose nil)
  (asdf:test-system '#:autolith-supervisor/memory-service :verbose nil)
  (asdf:test-system '#:autolith-supervisor/knowledge-service :verbose nil)
  (asdf:test-system '#:autolith-supervisor/papercut-service :verbose nil)
  (asdf:test-system '#:autolith-supervisor/records :verbose nil)
  (asdf:test-system '#:autolith-supervisor/access :verbose nil)
  (asdf:test-system '#:autolith-supervisor/access/session :verbose nil)
  (asdf:test-system '#:autolith-supervisor/access-native :verbose nil)
  (asdf:test-system '#:autolith-supervisor/parent-launch :verbose nil)
  (asdf:test-system '#:autolith-supervisor/parent-application :verbose nil)
  (assert (not (find-package '#:autolith)))
  (write-line "Parent protocol checks passed without loading the agent."))
